+VERSION = "bench_C_single_planar_edgeflip_v1"
+CANONICAL_SOURCE = "r2/data_tools/bench_user_v2/build.py:canonical"
+SHAPE_TOL = 1e-10
+AREA_RTOL = 3e-6
+NORMAL_COS_TOL = 3e-6
