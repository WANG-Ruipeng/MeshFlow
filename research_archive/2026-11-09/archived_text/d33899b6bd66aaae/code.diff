+    points, tri = np.asarray(points, np.float64), np.asarray(triangle, np.float64)
+    e0, e1 = tri[1] - tri[0], tri[2] - tri[0]
+    a, b, d = float(e0 @ e0), float(e0 @ e1), float(e1 @ e1)
+    determinant = a*d - b*b
