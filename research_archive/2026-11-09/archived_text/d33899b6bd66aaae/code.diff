+
+def _segment_parameters_2d(p, q, a, b, tol):
+    """Parameters on pq for its intersection with ab, including contacts."""
+    r, s = q - p, b - a
+    lr, ls = float(np.linalg.norm(r)), float(np.linalg.norm(s))
+    if lr <= tol:
+        return []
+    den = _cross2(r, s)
