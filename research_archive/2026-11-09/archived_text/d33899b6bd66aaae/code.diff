+            a = tri[(k + 1) % 3] - tri[k]
+            b = tri[(k + 2) % 3] - tri[k]
+            values.append(np.degrees(np.arctan2(np.linalg.norm(np.cross(a, b)), np.dot(a, b))))
+    return float(min(values))
