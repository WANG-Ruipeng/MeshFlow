+    if os.name != 'nt' and len(raw) > 2 and raw[1] == ':':
+        raw = '/mnt/' + raw[0].lower() + raw[2:]
+    elif os.name == 'nt' and raw.startswith('/mnt/'):
+        raw = raw[5].upper() + ':/' + raw[7:]
+    return Path(raw)
