+        known[:, :k] = True
+        valid = torch.ones_like(known)
+        y = torch.tensor([n], device=device, dtype=torch.long)
+        cond = torch.from_numpy(b['C'].reshape(k, 9).copy()).to(device)
+        state[:, :k] = cond[None]
