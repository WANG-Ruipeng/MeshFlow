+def digest_tensors(state, torch):
+    h = hashlib.sha256()
+    for k, v in sorted(state.items()):
+        v = v.detach().cpu().contiguous()
+        h.update(k.encode())
+        h.update(str((tuple(v.shape), v.dtype)).encode())
+        h.update(v.view(torch.uint8).numpy().tobytes())
+    return h.hexdigest()
