+ROOT=Path(__file__).resolve().parents[3]
+OUT=ROOT/'experiments/r2_terminal_reward_nft_v1'
+VERSION='r2_terminal_reward_nft_original_evaluation_v1'
+L=float(np.sqrt(3.)*2/.3762)
