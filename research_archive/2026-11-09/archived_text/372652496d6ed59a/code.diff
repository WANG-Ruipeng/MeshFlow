+def resolve(p):
+    s=str(p).replace('\\','/')
+    if os.name=='nt' and s.startswith('/mnt/'):s=s[5].upper()+':/'+s[7:]
+    elif os.name!='nt' and len(s)>2 and s[1]==':':s='/mnt/'+s[0].lower()+s[2:]
+    p=Path(s)
