+        result['D0_complete'] = True
+    else:
+        a.pending(stage, 'D0 index not complete')
+    a.check(result['D0_attempts'] <= len(expected) and result['D0_returns'] <= result['D0_attempts'], stage, 'D0 attempts exceed authorized request set')
