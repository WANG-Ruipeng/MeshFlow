+ARMS = ('NFT', 'SELF_FM')
+LABELS = ('BASE', 'NFT', 'SELF_FM')
+REVIEW_FIELDS = ('RAW_adoption', 'POST_adoption', 'POST_body_complete')
+REVIEW_VALUES = {'YES', 'NO', 'UNKNOWN', 'UNCERTAIN', 'NA'}
