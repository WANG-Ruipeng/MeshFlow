+def width_plot_values(curve):
+    """Display guard only: preserve all scientific rows; undefined ratios stay NA."""
+    values=[curve.get(key) for key in ("width_minus","width_base","width_plus")]
+    if any(value is None for value in values):return None,"NA_MISSING_WIDTH"
+    if any(not math.isfinite(value) for value in values):return None,"NA_NONFINITE_WIDTH"
+    minus,base,plus=values
+    if base<=0:return None,"NA_NONPOSITIVE_BASE_WIDTH"
+    return [minus/base,1.,plus/base],"PLOTTED"
