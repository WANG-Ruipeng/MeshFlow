+    return dict(loss=sse / divisor, squared_error_sum=sse,
+                free_scalar_count=count, denominator=divisor)
+
+
+def euler_step(x, velocity, dt, known_face_mask, valid_face_mask,
+               anchor_vertex_ids, c_vertices):
