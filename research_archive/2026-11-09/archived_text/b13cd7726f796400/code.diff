+    requests = manifest['requests']
+    if len(requests) != 16 or len({q['request_id'] for q in requests}) != 16:
+        raise ValueError('Exactly sixteen fixed request identities required')
+    conditions = {q['condition_id'] for q in requests}
+    if len(conditions) != 4 or any(sum(q['condition_id'] == c for q in requests) != 4 for c in conditions):
+        raise ValueError('Four conditions with four noises each required')
+    for q in requests:
