+    for fi, tri in enumerate(f):
+        if len(set(map(int, tri))) != 3:
+            raise ValueError('Degenerate C identities')
+        for i in range(3):
+            u, w = int(tri[i]), int(tri[(i + 1) % 3])
+            edges[tuple(sorted((u, w)))].append((fi, u, w))
