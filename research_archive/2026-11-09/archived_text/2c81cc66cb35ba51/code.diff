+    t=tri.astype(np.float64);cr=np.cross(t[:,1]-t[:,0],t[:,2]-t[:,0]);dbl=np.linalg.norm(cr,axis=1)
+    ck((dbl>2e-12).all(),'valid finite source face areas')
