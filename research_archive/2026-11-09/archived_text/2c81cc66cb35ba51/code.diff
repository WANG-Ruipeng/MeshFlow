+def read_raw(q, arm):
+    rec = C.read(record_path(q, arm, 'raw'))
+    if rec['request_id'] != q['request_id'] or rec['input_sha256'] != q['input_sha256'] or rec['label'] != arm:
+        raise ValueError('RAW receipt identity mismatch')
