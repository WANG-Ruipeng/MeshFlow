+        raise ValueError('POST original source C order/coordinates differ')
+    if not C.same(a['vertices'][a['faces']], a['output']):
+        raise ValueError('POST indexed geometry mismatch')
+    return rec
+
+
+def read_post(q, arm):
+    rec = C.read(record_path(q, arm, 'post'))
