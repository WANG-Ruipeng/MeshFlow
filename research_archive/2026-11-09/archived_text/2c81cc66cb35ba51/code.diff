+    plan = C.checked(EV / 'execution' / arm / (stage + '_dispatch_plan.json'))
+    plan.parent.mkdir(parents=True, exist_ok=True)
+    with plan.with_suffix('.lock').open('a+') as dispatcher:
+        fcntl.flock(dispatcher, fcntl.LOCK_EX)
