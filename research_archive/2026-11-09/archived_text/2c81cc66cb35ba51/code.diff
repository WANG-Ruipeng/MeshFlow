+        cache = q['cache'][arm]
+        verify({cache['post_path']: cache['post_sha256']})
+        if rec['new_D0_F'] != 0 or rec['historical_receipt_sha256'] != cache['post_sha256']:
+            raise ValueError('Cached POST provenance mismatch')
+    return rec
