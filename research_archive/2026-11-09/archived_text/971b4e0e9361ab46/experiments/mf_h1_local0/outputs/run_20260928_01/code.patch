+
+ATOL = 1e-5
+RTOL = 1e-5
+GEOMETRY_ATOL = 1e-10
+MODELS = []
+COUNTERS = {"cpu_probe_optimizer_updates": 0, "official_forward_calls": 0,
+            "official_complete_samples": 0, "phase2_optimizer_updates": 0}
