+                        raise RuntimeError(f"Nonfinite {component} benchmark result")
+        torch.cuda.synchronize()
+        serial = []
+        summary = {arm: {} for arm in models}
+        for record in records:
+            spans = {label: sum(start.elapsed_time(end) for start, end in pairs)
