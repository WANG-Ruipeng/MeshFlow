+        gq[mode]={}
+        for label,kinds in [(kind,(kind,)) for kind in KINDS]+[("equal_type_overall",KINDS)]:
+            gq[mode][label]={metric:paired_metric(indexed,metric,mode,kinds) for metric in METRICS}
+    for arm in (*ARMS,"base"):
