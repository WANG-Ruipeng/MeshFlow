+def apply_contour_readout(hidden, memory, x, t, known_mask, valid_mask,
+                          boundary_edge_mask, module, *, observer=None):
+    """FP32(hidden + delta), then cast, and copy only valid free corners."""
+    batch, faces = known_mask.shape
