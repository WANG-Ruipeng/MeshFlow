+    path=C.OUT/'training'/C.TRAIN_LABEL/'status.json'
+    def prior_training_evidence():
+        if path.parent.exists() and any(path.parent.iterdir()):return True
+        for folder,pattern in ((C.OUT/'checkpoints',C.TRAIN_LABEL+'_step*'),
+                               (C.OUT/'inference',C.TRAIN_LABEL+'_S*'),
+                               (C.OUT/'orchestration/jobs','train_*')):
+            if any(folder.glob(pattern)):return True
+        previous=C.OUT/'orchestration/controller_state.json'
+        if previous.exists():
+            saved=C.read(previous).get('training',{})
+            if saved and (saved.get('status')!='NOT_STARTED' or saved.get('local_step',0)!=0):return True
+        return False
