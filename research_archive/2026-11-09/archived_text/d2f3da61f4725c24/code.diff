+def table(path, rows):
+    require(bool(rows), 'Empty table: ' + str(path))
+    with Path(path).open('x', encoding='utf-8', newline='') as f:
+        writer = csv.DictWriter(f, fieldnames=list(rows[0]))
+        writer.writeheader(); writer.writerows(rows)
