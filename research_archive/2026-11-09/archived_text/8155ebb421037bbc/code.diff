+
+
+def _arrays(path):
+    with np.load(_path(path), allow_pickle=False) as z:
+        return {k: z[k] for k in z.files}
+
+
+def _exact(a, b):
+    return a.dtype == b.dtype and a.shape == b.shape and a.tobytes() == b.tobytes()
+
