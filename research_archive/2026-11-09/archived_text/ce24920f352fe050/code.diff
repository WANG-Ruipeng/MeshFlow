+def request_figure(request, ordered, geometry, candidate_map, bounds, L, page):
+    plt = _mpl(); fig = plt.figure(figsize=(18, 13.3), dpi=150, facecolor='white')
+    view = 'front' if page == 'FRONT' else 'side'
