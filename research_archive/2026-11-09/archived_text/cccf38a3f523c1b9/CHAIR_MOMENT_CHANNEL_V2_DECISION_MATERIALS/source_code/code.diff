+        execute(out,'initial_replay',[MODULE+'.worker','--out',str(out),'--stage','initial_replay'])
+        if a.through=='replay':return
+        if not (out/'registration/training_implementation_hashes.json').exists():freeze_training(out)
+        for arm in ARMS:
