+    assert allrow["ConflictCov_C_complete_parents"]==1
+    assert next(r for r in pp if r["parent_id"]=="p1")["ConflictCov_C"] is None
+
+
+def test_all_phase_barrier_precedes_any_score(monkeypatch,tmp_path):
