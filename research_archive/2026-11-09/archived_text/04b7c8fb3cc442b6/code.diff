+        for n in ev.NOISES:
+            q=request(tmp_path,candidate=n,parent=parent,ratio=.4,cohort=cohort); qs.append(q)
+            rows.append(dict(q,label="M",status="PASS",metrics={"ConflictCov_C":base+n}))
