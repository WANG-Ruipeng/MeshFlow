+    return z
+def sample(model,C,N,seed=None,z=None,*,budget,out=None,context=None):
+    from .models.native import native_execution
+    C=validate_C(C,int(N));K=len(C);ctx=context or {}
+    if z is None: z=make_noise(seed,int(N),K)
