+    if not values:
+        return None
+    x = (len(values)-1)*probability; lo = int(math.floor(x)); hi = int(math.ceil(x))
+    return values[lo] + (values[hi]-values[lo])*(x-lo)
+
+
+def distribution(values, expected):
