+    number = float(value)
+    require(math.isfinite(number) and number.is_integer(), "Noninteger numeric field", value=str(value))
+    return int(number)
+
+
+def number(value):
+    result = float(value)
+    require(math.isfinite(result), "Nonfinite logged field", value=str(value))
