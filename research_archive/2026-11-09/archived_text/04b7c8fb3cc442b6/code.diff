+def derived_seed(namespace, domain, *identities):
+    raw = json.dumps([namespace, "confirmation_base/"+domain, *identities], separators=(",", ":")).encode()
+    return int.from_bytes(hashlib.sha256(raw).digest()[:4], "little")
