+#!/usr/bin/env python3
+"""Execute one explicitly registered FM-only recipe; never self-retry."""
+from meshflow_control import runtime
+import argparse
+import json
+import sys
+from meshflow_control.training.recipe_factorial import train_recipe, RECIPES
+
+
+def main(argv=None):
