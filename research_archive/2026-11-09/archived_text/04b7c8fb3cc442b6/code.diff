+    "R1_40_H_ALL": ("FORTY", "all"),
+    "R2_MIX_H_ALL": ("MIX", "all"),
+    "R3_40_H_LATE": ("FORTY", "late"),
+    "R4_MIX_H_LATE": ("MIX", "late"),
+    "C20_40_MIX": ("C20_40_MIX", None),
+    "C40_20_MIX": ("C40_20_MIX", None),
+}
+tree_hash = baseline.tree_hash
