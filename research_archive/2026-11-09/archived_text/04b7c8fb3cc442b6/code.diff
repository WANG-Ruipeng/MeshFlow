+    for triangle in triangles:
+        face = []
+        for vertex in triangle:
+            key = tuple(float(q) for q in vertex)
+            if key not in mapping:
+                mapping[key] = len(vertices)
+                vertices.append(vertex.copy())
+            face.append(mapping[key])
+        faces.append(face)
