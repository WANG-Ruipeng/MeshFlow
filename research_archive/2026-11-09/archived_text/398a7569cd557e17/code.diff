+
+def read(path):
+    return json.loads(path.read_text(encoding='utf-8-sig'))
+
+
+def csvrows(path):
+    with path.open(encoding='utf-8-sig', newline='') as f:
+        return list(csv.DictReader(f))
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def mean(values):
