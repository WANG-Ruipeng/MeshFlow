+def allocation_for_update(coefficient, samples, entry):
+    """Validate count-only coefficients against the actual prepared masks."""
+    counts=[int(s['free_coordinate_count']) for s in samples]
+    groups=[r['replay_group'] for r in entry['samples']]
+    if (coefficient['stage_step'] != entry['stage_step']
+            or coefficient['micro_free_scalar_counts'] != counts
+            or coefficient['micro_groups'] != groups
+            or coefficient['D_W'] != sum(counts)):
+        raise ValueError('Actual samples/masks differ from frozen coefficient schedule')
+    for sample,count in zip(samples,counts):
+        if count != 9*(int(sample['N'])-int(sample['K'])):
+            raise ValueError('Native scalar count differs; no implicit change of denominator')
+    if coefficient['branch']=='FOCUS':
+        if coefficient['micro_gains'] != [1.]*8 or coefficient['D_B'] != sum(counts):
+            raise ValueError('FOCUS objective must remain unchanged')
+    elif coefficient['branch']=='HIGH':
+        mo=sum(c for c,g in zip(counts,groups) if g=='OLD')
+        mh=sum(c for c,g in zip(counts,groups) if g=='HIGH')
+        if (mo != coefficient['m_old'] or mh != coefficient['m_high_W']
+                or coefficient['D_B'] != mo+coefficient['m_high_B']
+                or coefficient['rho'] != coefficient['m_high_B']/mh):
+            raise ValueError('HIGH reference/group scalar count differs')
+        expected=[sum(counts)/coefficient['D_B']*(coefficient['rho'] if g=='HIGH' else 1.) for g in groups]
+        if coefficient['micro_gains'] != expected:
+            raise ValueError('Effective microbatch gains differ')
+    else:raise ValueError('Unregistered allocation branch')
+    return coefficient
+
+
+def apply_loss_gain(base_loss, allocation, microbatch):
+    """Scale the existing SSE_i/D_W loss before backward, without re-dividing."""
+    gain=allocation['micro_gains'][microbatch]
+    return base_loss if allocation['branch']=='FOCUS' else base_loss*gain
+
