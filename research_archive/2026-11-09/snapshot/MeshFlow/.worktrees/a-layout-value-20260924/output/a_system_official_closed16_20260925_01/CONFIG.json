{
  "data": {
    "data_path": "downloaded_data/a_closed16_512/meshflow512",
    "num_workers": 0,
    "noise_sort": "ot",
    "use_rot_aug": false,
    "use_scale_aug": false,
    "use_permute_aug": true
  },
  "model": {
    "model_type": "equidit",
    "hidden_dim": 768,
    "num_heads": 12,
    "max_length": 800,
    "num_layers": 12,
    "gradient_checkpointing": true,
    "use_coord_encoding": true,
    "version": 3,
    "pe_freq": 20,
    "mixed_precision": "bf16",
    "use_dit_like_pe": false,
    "face_cond": true,
    "face_bin": 20,
    "use_qknorm": true,
    "use_rmsnorm": true
  },
  "transport": {
    "path_type": "Linear",
    "prediction": "velocity",
    "use_lognorm": true,
    "use_jit": false
  },
  "optimizer": {
    "lr": 0.0001,
    "beta2": 0.95,
    "max_grad_norm": 2.0
  },
  "closed16_runner": {
    "updates": 50000,
    "microbatch": 4,
    "accumulation_steps": 4,
    "effective_batch": 16,
    "ema_decay": 0.9999,
    "checkpoint_every": 5000,
    "primary_checkpoint": "final",
    "primary_weight": "ema",
    "fit_probe_every": 1000,
    "no_automatic_convergence_claim": true
  },
  "sample": {
    "sampling_method": "euler",
    "atol": 1e-06,
    "rtol": 0.0005,
    "num_sampling_steps": 50,
    "cfg_scale": 2.0,
    "timestep_shift": 0,
    "reverse": false,
    "requested_faces": 512,
    "samples_per_training_seed": 64,
    "raw_representation": "unquantized_triangle_soup_tensor",
    "public_post_is_not_paper_full_post": true
  }
}
