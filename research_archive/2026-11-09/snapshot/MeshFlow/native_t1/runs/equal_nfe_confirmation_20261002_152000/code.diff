+LOCK_PATH = '/tmp/wrp_meshflow_jedge5_diag_gpu0.lock'
+FILE_HASHES = {
+    'B': '0f22ce498ca2c27dc74b43890fb8aad20f0f3e7153aa74ee6d3c14ea445a2660',
