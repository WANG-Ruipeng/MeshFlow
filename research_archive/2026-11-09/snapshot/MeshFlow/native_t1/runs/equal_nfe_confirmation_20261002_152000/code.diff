+
+from .reporting import MODELS, SOLVERS, collect, read_json, sha256, write_json
+
+
+def array_digest(value):
+    import hashlib
+    a = np.asarray(value)
+    return hashlib.sha256(str(a.dtype).encode() + str(a.shape).encode() + a.tobytes()).hexdigest()
+
+
+def run(out):
+    import matplotlib
