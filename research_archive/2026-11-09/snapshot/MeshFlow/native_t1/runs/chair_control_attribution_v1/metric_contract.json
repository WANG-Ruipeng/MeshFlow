{
  "schema": "metric_contract_v1",
  "units": {
    "coordinates": "original model coordinates",
    "e_base_response": "fraction of L0",
    "squared_terms": "L0 squared normalized",
    "legacy_bbox_pct": "100*distance/L_alpha",
    "coverage": "fraction; multiply once by 100 for percentage points"
  },
  "width": {
    "formula": "q95(X)-q05(X)",
    "population": "all finite free triangle corners, equal corner weight; copied C excluded",
    "dtype": "raw float32 converted to float64 BEFORE np.quantile",
    "method": "numpy linear",
    "source": "width_analytics.py:extent",
    "small_p": "p<=1e-8*L0 -> relative response undefined"
  },
  "decomposition": {
    "e": "(p_a-alpha*g)/L0",
    "base": "alpha*(p-g)/L0",
    "response": "(p_a-alpha*p)/L0",
    "cross": "2*base*response",
    "actual_GT_error": "(p_a-g_alpha)/L0=e+(alpha*g-g_alpha)/L0; preserve float32 target transform residual",
    "slope_self": "(p_1.1-p_.9)/(.2*p)",
    "slope_GT": "(p_1.1-p_.9)/(.2*g)"
  },
  "transform": {
    "origin": "original fixed origin, X only",
    "source": "prepare.py:load_task_sample",
    "source_dtype": "float32 multiply by np.float32(alpha)",
    "pullback": "float64(F_alpha); X /= float(np.float32(alpha)); invert actual saved transform factor; nominal alpha separately recorded",
    "no_alignment": true
  },
  "cross": {
    "formula": "E[alpha_in,beta_target]=sqrt(mean(distance(Q_beta,F_alpha)^2))/L0",
    "queries": "frozen Q1 points transported by float32(alpha) factor in float64",
    "direction": "rows=input condition, columns=target",
    "column_advantage": "mean(E[wrong,b])-E[b,b]",
    "row_preference": "mean(E[a,wrong])-E[a,a]",
    "old_field": "wrong_mean_minus_diagonal_RMS_L0 is ROW; old diagonal wins also ROW",
    "rank_ties": "raw sign strict retained; tolerance ties atol=1e-8+1e-6*abs(diagonal) separately",
    "reuse": "648 original cells + original JSON independent mapping; no rerun when agree"
  },
  "coverage": {
    "points": "original reference coverage_points; uniform per sampled point, Q=512",
    "threshold": "d<=.01*L for original A case",
    "partition": "both_in,enter,leave,both_out",
    "contribution": "sum_group((d_new/L)^2-(d_old/L)^2)/Q",
    "original_R12": "uses DIFFERENT pairwise_target_points; fixed_query_MSE never relabeled original R12 RMS",
    "source": "eval_scoring.py:score_free"
  },
  "pullback": {
    "candidates": 96,
    "types": 2,
    "symmetric": "512 area samples independently on each surface via original sampler RandomState(9911); sum of two directional means /2, sqrt /L0",
    "GT": "frozen B Q1 -> canonical pulled free, coverage<=.01 L0",
    "sampling": "finite offline surface uniform draws only, NO Gaussian; not generated meshes",
    "auxiliary": "same-slot coordinate RMS is auxiliary, no GT slot matching",
    "chunk": 32
  },
  "aggregation": "curve first; within parent average noise/alpha; parents equal weight. Phase comparison common n0 only. A20/A40 separate complements.",
  "reconciliation": {
    "atol": 1e-08,
    "rtol": 1e-06
  },
  "fixture_families": 8,
  "budgets": {
    "B_outputs": 216,
    "curves": 72,
    "cross_cells": 648,
    "pullback_candidates": 96,
    "A_vectors": 270,
    "teacher_rows": 288
  },
  "forbidden": {
    "model_loads": 0,
    "forwards": 0,
    "backwards": 0,
    "optimizer_updates": 0,
    "OT": 0,
    "new_Gaussians": 0,
