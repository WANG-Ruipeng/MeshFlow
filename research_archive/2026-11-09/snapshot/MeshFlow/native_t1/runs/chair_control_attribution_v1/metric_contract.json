    "CUDA_initializations": 0
  },
  "visual_registration": {
    "raw_examples": "lexicographically first UID in each B split; noise0; all three arms; raw/pullback/GT; fixed view elev20 azim-60",
    "fixed_global_heatmap": true
  },
