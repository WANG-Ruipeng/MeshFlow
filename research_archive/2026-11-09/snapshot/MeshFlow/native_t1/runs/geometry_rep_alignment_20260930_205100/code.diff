+        Scale_MSE='NOT_APPLIED' if terms['scale'] is None else float(terms['scale']),
+        Scale_group_MSE='NOT_APPLIED' if terms['group_scale_MSE'] is None else {key:float(value) for key,value in terms['group_scale_MSE'].items()})
