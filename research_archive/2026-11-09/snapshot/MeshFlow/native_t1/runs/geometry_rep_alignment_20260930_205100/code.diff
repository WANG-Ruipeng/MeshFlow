+def _state(base,t,*,parent,noise_index,pair_index,time_index):
+    sample={k:v.copy() if isinstance(v,np.ndarray) else copy.deepcopy(v) for k,v in base.items()}
+    sample['t']=np.asarray(t,dtype=np.float32)
