+
+def _targets(provider,sample,device):
+    target=provider.for_sample(sample,device=device)
+    q=target['q']
+    if not isinstance(q,torch.Tensor) or q.dtype!=torch.float32 or q.requires_grad or q.shape!=(target['free_count'],13):
