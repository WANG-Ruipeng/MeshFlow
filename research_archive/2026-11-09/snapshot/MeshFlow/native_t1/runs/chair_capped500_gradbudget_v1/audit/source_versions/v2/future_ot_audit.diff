+def audit_future_ot(a):
+    folder = a.out / 'registration/future_ot_precompute'
+    receipt_path = folder / 'receipt.json'
+    if not a.need(receipt_path.exists(), 'Registered future OT preparation incomplete'):
+        return dict(status='PENDING')
+    r = read(receipt_path)
+    a.check(r['status'] == 'PASS' and r['sample_start'] == 4000 and r['sample_end_exclusive'] == 8000,
+            'Future OT registered range/status differs')
+    a.check(r['counts']['actual_OT_attempts'] == r['counts']['actual_OT_returns'] and
+            r['counts']['actual_OT_returns'] + r['counts']['OT_cache_hits'] == 4000,
+            'Future OT attempts/returns do not close')
+    a.check(r['model_calls'] == r['new_feedback_matching'] == r['first_half_cache_writes'] == 0 and
+            not r['training_cursor_modified'] and not r['CUDA_initialized'], 'Future OT scope differs')
+    a.hash(folder / 'registered_inputs.jsonl', r['registered_inputs_sha256'])
+    a.hash(folder / 'events.jsonl', r['events_sha256'])
+    records = a.lines(folder / 'registered_inputs.jsonl')
+    a.check([x['sample_index'] for x in records] == list(range(4000,8000)), 'Future OT input identities not exactly4000..7999')
+    entries = {x['sample_index']:x for x in records}
+    events = a.lines(folder / 'events.jsonl')
+    a.check(Counter(x['event'] for x in events) == {'REGISTERED_SAMPLE_BEGIN':4000,'REGISTERED_SAMPLE_RETURN':4000},
+            'Future OT journal contains incomplete or unexpected calls')
+    if not a.live:
+        for entry in r['cache_files']:
+            a.hash(entry['path'], entry['sha256'])
+    matched = {}
+    for arm in ARMS:
+        count = 0
+        for row in a.lines(a.out / 'training' / (arm + '_metrics.jsonl')):
+            step = row['pilot_step']
+            if step <= 500:
+                continue
+            expected = [entries[i] for i in range(8*(step-1),8*step)]
+            for actual, reference in zip(row['sample_diagnostics'], expected):
+                a.check(actual['shared_input_sha256'] == reference['shared_input_sha256'] and actual['ot_cache_status'] == 'HIT',
+                        'Future cached input was not reused identically', arm=arm, step=step, sample_index=actual['sample_index'])
+                count += 1
+            expected_batch = hashlib.sha256(''.join(e['coupled_input_sha256'] for e in expected).encode()).hexdigest()
+            a.check(expected_batch == row['coupled_batch_sha256'], 'Future cached coupled batch differs', arm=arm, step=step)
+        matched[arm] = count
+    return dict(status='PASS',receipt_sha256=a.hash(receipt_path),counts=r['counts'],cache_files=4000,
+        cache_hashes_recomputed=not a.live,actual_future_inputs_matched=matched,
+        precomputation_seconds=r['wall_seconds'],model_calls=0)
+
