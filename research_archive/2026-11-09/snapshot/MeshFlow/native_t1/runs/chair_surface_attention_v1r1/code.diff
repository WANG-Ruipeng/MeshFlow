+            with counter_lock:active[0]-=1
+    with patch.object(monitor.subprocess,'run',side_effect=slow_run):
+        m=monitor._MemoryMonitor(out/'mock_concurrent.jsonl',interval=.005);m.start()
+        for _ in range(4):m.poll()
