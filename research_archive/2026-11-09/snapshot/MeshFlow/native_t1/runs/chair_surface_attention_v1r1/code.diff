+    active=[0];maximum=[0];counter_lock=threading.Lock()
+    def slow_run(args,**kwargs):
+        with counter_lock:active[0]+=1;maximum[0]=max(maximum[0],active[0])
+        time.sleep(.002)
+        try:return _fake_run(args,**kwargs)
