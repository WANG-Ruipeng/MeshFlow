+        return read_json(out/'replays/summary.json')
+    model,_,meta,_=checkpoint.load(START,'B_BOUNDARY','cuda',trainable=False,optimizer=False,out=out)
+    meta['checkpoint_sha256']=START_SHA
+    rows=[]
