+def call_sync(budget,kind,fn,context):
+    torch.cuda.synchronize();tick=time.perf_counter()
+    def completed():
+        value=fn();torch.cuda.synchronize();return value
+    return budget.call(kind,completed,context=context),time.perf_counter()-tick
+
