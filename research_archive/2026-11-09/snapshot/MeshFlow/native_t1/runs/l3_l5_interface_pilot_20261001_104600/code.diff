+    return lines
+
+def _binding(s):
+    lines=["## 同噪声条件绑定","",
+        "四格E00/E01/E11/E10复用输出的独立交叉评分，不新增采样。Delta0=E01−E00，Delta1=E10−E11，B为两者平均；基线已有正向绑定，重点看增量和逐seed集中度。",""]
+    for j in (0,1,2):
