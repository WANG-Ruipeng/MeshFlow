+        a=SelfAttention(D,H,mixed_precision='fp32',qk_norm=True).double().eval()
+        m=RelationMessageMLP(H,D,seed=K).double();_nonzero(m,400+K)
+        for mode in ('MOMENT_XY','SURFACE_XY'):
