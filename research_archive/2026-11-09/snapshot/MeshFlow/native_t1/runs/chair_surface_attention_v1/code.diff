+    if supported:
+        result='FINITE_SURFACE_GEOMETRY_SIGNAL_WITH_TRADEOFF' if tradeoffs else 'FINITE_SURFACE_GEOMETRY_CANDIDATE'
+        recommendation='有限表面候选同时超过续训与同容量质心矩，值得独立重复验证；必须同时复核已披露质量及延迟代价，不自动晋级默认模型。'
