+            if name=='MODEL':free=item['free']
+            else:
+                free=np.asarray(center['free'],np.float64).copy()
+                if name=='Post-scale':
+                    if den<=1e-12*L0**2*len(x): continue
+                    edit=np.asarray(item['bank']['C'],np.float64)[...,0].reshape(-1)
+                    fit[a]=float(x@edit/den);free[...,0]*=fit[a]
