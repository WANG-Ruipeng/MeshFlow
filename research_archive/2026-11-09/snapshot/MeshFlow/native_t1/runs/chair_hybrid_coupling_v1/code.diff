+
+def verified(root, rec, key, hash_key=None):
+    path = resolve(root, rec[key])
+    expected = rec.get(hash_key or key.replace('_path','_sha256'))
+    if expected and sha(path) != expected: raise ValueError('Frozen source changed: '+str(path))
+    return path
