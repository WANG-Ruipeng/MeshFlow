+        strict_SeamCov_tau=.001,strict_mean_gain_min=.02,strict_parent_median_gain_gt=0.,strict_improving_parents_min=4,
+        old_SeamCov_tau=.01,old_SeamCov_mean_drop_max=.005,ConflictCov_C_mean_increase_max=.01,
