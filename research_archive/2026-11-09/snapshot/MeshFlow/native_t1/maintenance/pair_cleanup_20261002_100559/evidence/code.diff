+        F = np.asarray(faces)[face_ids]; ids = set(F.reshape(-1).tolist())
+        E = {tuple(sorted((int(f[a]), int(f[b])))) for f in F for a,b in ((0,1),(1,2),(2,0))}
+        chi = len(ids) - len(E) + len(F)
+        valid_closed = result['COMBINATORIAL_CLOSURE_STATUS'] == 'CLOSED_TRIANGLE_2_MANIFOLD'
+        orientable = result['orientation']['can_consistently_reorient_two_incident_edges']
+        result['components_and_genus'].append(dict(face_ids=face_ids, vertices=len(ids), edges=len(E), faces=len(F), Euler_characteristic=chi,
+            genus=(2-chi)//2 if valid_closed and orientable and (2-chi)%2==0 else None))
+    result['handles_or_multiple_components_are_failures'] = False
+    return result
+
+
+def incompatibilities(topology, tj):
+    failures = []
+    if topology['edge_incidence']['one']: failures.append('OPEN_BOUNDARY_EDGES')
+    if topology['edge_incidence']['more_than_two']: failures.append('OVERINCIDENT_EDGES')
+    if topology['vertex_links']['nonmanifold_vertex_count']: failures.append('NONMANIFOLD_VERTEX_LINKS')
+    if topology['duplicate_face_groups']: failures.append('DUPLICATE_FACES')
+    if topology['repeated_vertex_face_ids'] or topology['geometry_degeneracy']['exact_zero_area_face_ids']: failures.append('DEGENERATE_FACES')
+    if not topology['orientation']['can_consistently_reorient_two_incident_edges']: failures.append('NONORIENTABLE_OR_INCONSISTENT_ORIENTATION_CONSTRAINTS')
+    if tj['exact_T_junction_count']: failures.append('EXACT_T_JUNCTIONS')
+    return failures
+
+
+def run(output=None):
+    """One formal static audit; refuses to overwrite its output evidence."""
+    from ..guided_native_geometry_geometry import verified_pair, DETECTOR_POLICY
+    output = Path(output or Path(__file__).with_name('gt_audit.json'))
+    if output.exists(): raise FileExistsError(output)
+    started = time.perf_counter()
+    if sha(INPUT) != INPUT_SHA: raise ValueError('Prepared input hash differs')
+    rows=[]; ledger={}; all_blockers=[]; unresolved_total=0
+    with np.load(INPUT, allow_pickle=False) as source:
+        metadata=json.loads(source['prepare_metadata_json'].item())
+        for info in metadata['parents']:
+            parent=info['parent_index']; prefix=f'parent{parent}_'; V=source[prefix+'source_vertices'].copy()
+            F=source[prefix+'source_face_vertex_ids'].copy(); target=source[prefix+'target'].reshape(112,3,3).copy()
+            mapping=source[prefix+'canonical_to_raw_face'].copy(); original=Path(info['source_path'])
+            if sha(original) != info['source_sha256']: raise ValueError('Original source changed')
+            with np.load(original, allow_pickle=False) as f: rawF=f['faces'].astype(np.int64).copy()
+            raw_canonical=rawF[mapping]
+            if not np.array_equal(np.sort(F,axis=1),np.sort(raw_canonical,axis=1)) or V[F].tobytes()!=target.tobytes():
+                raise ValueError('Source face/corner identity mismatch')
+            L=float(np.linalg.norm(np.ptp(target.reshape(-1,3),axis=0)))
+            raw_audit=indexed_diagnostics(V,raw_canonical,L)
+            archive_audit=indexed_diagnostics(V,F,L)
+            exactV,exactF=exact_coordinate_index(target); exact_audit=indexed_diagnostics(exactV,exactF,L)
+            tj=t_junctions(V,F,L)
+            coincidences=defaultdict(list)
+            for i,v in enumerate(V):coincidences[tuple(float(x) for x in v)].append(i)
+            coincident=[dict(source_vertex_ids=ids,coordinate=list(x)) for x,ids in coincidences.items() if len(ids)>1]
+            blockers=incompatibilities(archive_audit,tj); exact_blockers=incompatibilities(exact_audit,tj)
+            if blockers or exact_blockers:
+                print(json.dumps(dict(event='GT_STRUCTURAL_CONFLICT',parent=parent,source_blockers=blockers,exact_coordinate_blockers=exact_blockers)),flush=True)
+            classifications=Counter(); illegal=[]; unresolved=[]
+            for i in range(112):
+                for j in range(i+1,112):
+                    result=verified_pair(target[i],target[j],L,ledger=ledger)
+                    classifications[result['classification']]+=1
+                    if result['illegal'] or not result['resolved']:
+                        evidence=dict(canonical_face_ids=[i,j],raw_source_face_ids=[int(mapping[i]),int(mapping[j])],
+                            source_vertex_ids=[F[i].tolist(),F[j].tolist()],shared_source_vertex_ids=sorted(set(F[i])&set(F[j])),detector=result)
+                        (illegal if result['illegal'] else unresolved).append(evidence)
+            if illegal:blockers.append('VERIFIED_FLOATING_ILLEGAL_SELF_INTERSECTIONS')
+            unresolved_total+=len(unresolved)
+            all_blockers += [dict(parent=parent,indexing='source',reason=x) for x in blockers]
+            all_blockers += [dict(parent=parent,indexing='exact_coordinate',reason=x) for x in exact_blockers]
+            row=dict(parent_index=parent,uid=info['uid'],source=dict(path=str(original),sha256=info['source_sha256']),bbox_diagonal=L,
+                canonical_to_raw_face=mapping.tolist(),source_vertices=V.astype(float).tolist(),source_faces_archive=F.tolist(),source_faces_raw_canonical=raw_canonical.tolist(),
+                source_raw_winding=raw_audit,source_archive_winding=archive_audit,exact_coordinate_archive_winding=exact_audit,
+                exact_coordinate_index_policy='Numeric FP32 equality, signed zeros equal, no tolerance. Diagnostic array only; source identity and model inputs unchanged.',
+                coincident_distinct_source_vertices=coincident,T_junctions=tj,
+                intersections=dict(pair_count=6216,classification_counts=dict(classifications),verified_illegal_pairs=illegal,verified_illegal_pair_count=len(illegal),unresolved_pairs=unresolved,unresolved_pair_count=len(unresolved),
+                    legal_shared_vertex_or_edge_contact_not_illegal=True,precision='Existing two independent CPU floating constructions; not exact-predicate or continuous certification'),
+                source_incompatibilities=blockers,exact_coordinate_incompatibilities=exact_blockers)
+            rows.append(row)
+            print(json.dumps(dict(event='GT_STATIC_AUDIT_DONE',parent=parent,source_status=archive_audit['COMBINATORIAL_CLOSURE_STATUS'],exact_status=exact_audit['COMBINATORIAL_CLOSURE_STATUS'],T_junctions=tj['exact_T_junction_count'],illegal=len(illegal),unresolved=len(unresolved))),flush=True)
