+def check_known_bits(path, C):
+    """Observe saved FP32 bits only; never alter the trajectory or coordinates."""
+    path=np.asarray(path); C=np.asarray(C)
+    if path.dtype!=np.float32 or C.dtype!=np.float32 or path.shape!=(51,112,9) or C.shape!=(12,3,3):
+        raise ValueError('Exact production state and C shapes required')
+    expected=np.broadcast_to(C.reshape(1,12,9).view(np.uint32),(51,12,9))
+    if not np.array_equal(path[:,:12].view(np.uint32),expected):
+        raise AssertionError('Known FP32 bit pattern changed in a saved state')
+    return dict(known_all51_uint32_equal=True,known_bits_method='FP32 uint32 view, including signed zero')
+
