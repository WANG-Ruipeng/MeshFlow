+"""Reproducible entry for the already executed 4+1 synthetic CPU fixtures.
+
+The exact fixture bodies are retained in evaluation.py, in run_cpu_fixtures
+and run_zero_area_fixture. This collector adds no scoring algorithm or fixture.
+Importing does not execute either group. No real outputs/models/matching/OT.
+"""
+import json
+from ..evaluation import run_cpu_fixtures, run_zero_area_fixture
+
+
+def run_cpu_tests():
+    first = run_cpu_fixtures()
+    second = run_zero_area_fixture()
+    keys = set(first["ledger"]) | set(second["ledger"])
+    return dict(status="PASS" if first["status"] == second["status"] == "PASS" else "FAIL",
+                tests_run=first["tests_run"] + second["tests_run"],
+                executions=[first, second],
+                combined_ledger={key: first["ledger"].get(key, 0) + second["ledger"].get(key, 0)
+                                 for key in sorted(keys)})
+
+
+if __name__ == "__main__":
+    result = run_cpu_tests()
+    print(json.dumps(result, indent=2, allow_nan=False))
+    raise SystemExit(0 if result["status"] == "PASS" else 1)
