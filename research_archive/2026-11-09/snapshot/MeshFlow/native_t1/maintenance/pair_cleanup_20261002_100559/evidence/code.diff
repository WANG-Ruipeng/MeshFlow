+"""One deterministic equivalence-class candidate; no GT, repair search or face deletion."""
+from collections import defaultdict
+import time
+import numpy as np
+
+EDGE_CORNERS = ((0, 1), (1, 2), (2, 0))
+
+
+def construct_candidate(triangles, known_mask, matching, valid_mask=None):
+    """Preserve every C corner bitwise; audit legality separately from construction.
+
+    Half-edge IDs use original face slots. All complete matching pairs, including
+    fixed C pairs, generate equalities. Input C's exact FP32 numeric coordinate
+    equality is the only additional identity convention. No tolerance is used.
+    """
+    start = time.perf_counter()
+    x = np.asarray(triangles)
+    known = np.asarray(known_mask)
+    valid = np.ones(len(x), dtype=bool) if valid_mask is None else np.asarray(valid_mask)
+    if (x.dtype != np.float32 or x.ndim != 3 or x.shape[1:] != (3, 3)
+            or known.dtype != bool or valid.dtype != bool
+            or known.shape != (len(x),) or valid.shape != known.shape
+            or np.any(known & ~valid) or not np.isfinite(x[valid]).all()):
+        raise ValueError('Finite FP32 triangle coordinates and valid boolean masks required')
+    if matching.get('status') != 'PASS':
+        return dict(status='FAILED', failure_code='MATCHING_FAILED',
+                    matching_failure=matching.get('failure_code'), seconds=time.perf_counter()-start)
+    pairs = np.asarray(matching['all_pairs'], dtype=np.int64).reshape(-1, 2)
+    flips = np.asarray(matching['all_endpoint_flip'], dtype=bool)
+    if flips.shape != (len(pairs),):
+        raise ValueError('Endpoint orientation required for every pair')
+    expected = {3*int(face)+edge for face in np.flatnonzero(valid) for edge in range(3)}
+    if set(pairs.ravel().tolist()) != expected or len(pairs.ravel()) != len(expected):
+        return dict(status='FAILED', failure_code='INCOMPLETE_MATCHING', seconds=time.perf_counter()-start)
+    parents = np.arange(len(x)*3)
+    def find(i):
+        while parents[i] != i:
+            parents[i] = parents[parents[i]]
+            i = int(parents[i])
+        return i
+    def union(a, b):
+        a, b = find(a), find(b)
+        if a != b:
+            parents[max(a, b)] = min(a, b)
+    for (h, k), flip in zip(pairs, flips):
+        fh, eh = divmod(int(h), 3)
+        fk, ek = divmod(int(k), 3)
+        if fh == fk:
+            return dict(status='FAILED', failure_code='SAME_FACE_EDGE_PAIR', seconds=time.perf_counter()-start)
+        ah, bh = EDGE_CORNERS[eh]
+        ak, bk = EDGE_CORNERS[ek]
+        if flip:
+            ak, bk = bk, ak
+        union(3*fh+ah, 3*fk+ak)
+        union(3*fh+bh, 3*fk+bk)
+    fixed = {}
+    flat = x.reshape(-1, 3)
+    for face in np.flatnonzero(known):
+        for corner in range(3):
+            slot = 3*int(face)+corner
+            key = tuple(float(v) for v in flat[slot])
+            union(slot, fixed.setdefault(key, slot))
+    groups = defaultdict(list)
+    for face in np.flatnonzero(valid):
+        for corner in range(3):
+            slot = 3*int(face)+corner
+            groups[find(slot)].append(slot)
+    ordered = sorted(groups.values(), key=lambda members: min(members))
+    corner_labels = np.full((len(x)*3,), -1, dtype=np.int64)
+    conflicts, bit_conflicts, same_face_merges = [], [], []
+    vertices = []
+    for index, members in enumerate(ordered):
+        corner_labels[members] = index
+        by_face = defaultdict(list)
+        for slot in members:
+            by_face[slot//3].append(slot%3)
+        same_face_merges.extend(dict(face=int(face), corners=corners, component=index)
+                                for face, corners in by_face.items() if len(corners)>1)
+        anchors = [slot for slot in members if known[slot//3]]
+        if anchors:
+            unique = {tuple(float(v) for v in flat[slot]) for slot in anchors}
+            if len(unique)>1:
+                conflicts.append(dict(component=index, corner_slots=members,
+                    C_corner_slots=anchors, C_coordinates=[flat[slot].tolist() for slot in anchors]))
+            anchor = flat[anchors[0]].copy()
+            if any(flat[slot].tobytes()!=anchor.tobytes() for slot in anchors) and len(unique)==1:
+                bit_conflicts.append(dict(component=index, C_corner_slots=anchors))
+            vertices.append(anchor)
+        else:
+            # Canonical summation order keeps the equal-weight mean independent
+            # of input face/corner traversal and matching-pair order.
+            values = flat[members].astype(np.float64)
+            order = np.lexsort((values[:,2],values[:,1],values[:,0]))
+            vertices.append(values[order].mean(axis=0).astype(np.float32))
+    faces = corner_labels.reshape(-1,3)
+    duplicate_groups = defaultdict(list)
+    for face in np.flatnonzero(valid):
+        duplicate_groups[tuple(sorted(faces[face].tolist()))].append(int(face))
+    risk = dict(C_anchor_conflicts=conflicts, C_bitwise_alias_conflicts=bit_conflicts,
+                same_face_corner_merges=same_face_merges,
+                duplicate_index_face_groups=[v for v in duplicate_groups.values() if len(v)>1])
+    if conflicts or bit_conflicts:
+        return dict(status='FAILED', failure_code='C_ANCHOR_CONFLICT' if conflicts else 'C_BITWISE_ALIAS_CONFLICT',
+                    risk=risk, seconds=time.perf_counter()-start)
+    vertices = np.asarray(vertices, dtype=np.float32).reshape(-1,3)
+    result = x.copy()
+    result[valid] = vertices[faces[valid]]
+    if result[known].tobytes()!=x[known].tobytes():
+        raise AssertionError('Candidate changed protected coordinates')
+    free = valid & ~known
+    delta = np.linalg.norm((result[free]-x[free]).astype(np.float64),axis=-1).reshape(-1)
+    displacement = dict(RMS=float(np.sqrt(np.mean(delta**2))) if len(delta) else 0.,
+                        p95=float(np.percentile(delta,95)) if len(delta) else 0.,
+                        max=float(delta.max()) if len(delta) else 0., units='original_model_coordinates')
+    return dict(status='CANDIDATE', triangles=result, vertices=vertices, faces=faces,
+                valid_mask=valid.copy(), known_mask=known.copy(), risk=risk,
+                displacement=displacement, C_bitwise_preserved=True,
+                valid_face_count_preserved=True, coordinate_copies_share_index=True,
+                legality='NOT_AUDITED', seconds=time.perf_counter()-start)
