+"""Export only this experiment source as a reviewable Git patch, never assets."""
+import argparse
+import ast
+import difflib
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+
+SOURCE = Path(__file__).resolve().parent
+ROOT = SOURCE.parents[2]
+
+
+def export_code(out):
+    out = Path(out)
+    entries = []
+    chunks = []
+    for path in sorted(SOURCE.rglob('*')):
+        if not path.is_file() or path.suffix not in ('.py', '.md'):
+            continue
+        relative = path.relative_to(ROOT).as_posix()
+        data = path.read_bytes()
+        text = data.decode('utf-8-sig')
+        if path.suffix == '.py':
+            ast.parse(text, filename=relative)
+        if not text.endswith('\n'):
+            text += '\n'
+        text = text.replace('\r\n', '\n')
+        entries.append(dict(path=relative, bytes=len(data), sha256=hashlib.sha256(data).hexdigest()))
+        chunks.append('diff --git a/' + relative + ' b/' + relative + '\nnew file mode 100644\n')
+        chunks.extend(difflib.unified_diff([], text.splitlines(keepends=True), fromfile='/dev/null', tofile='b/' + relative))
+    patch = ''.join(chunks)
+    (out/'code.diff').write_text(patch, encoding='utf-8', newline='\n')
+    command=['git','-c','core.autocrlf=true','-c','core.filemode=false']
+    head=subprocess.check_output(command+['rev-parse','HEAD'],cwd=ROOT,text=True).strip()
+    status=subprocess.check_output(command+['status','--porcelain','--untracked-files=all'],cwd=ROOT,text=True)
+    record=dict(scope='Only new isolated Python source/tests and README; no checkpoints/data/cache/output arrays',
