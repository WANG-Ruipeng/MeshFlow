+    execution_counts = read('execution_counts.json', False)
+    calibration_summary = None if calibration is None else {k: v for k, v in calibration.items() if k != 'rows'}
+    if calibration_summary is not None:
+        calibration_summary['source'] = sources['stage_a/calibration.json']
+    result = dict(schema=SCHEMA, protocol=protocol, sources=sources,
+        execution_counts_snapshot=execution_counts,
+        stage_a=dict(window=window, calibration=calibration_summary,
+            capture={k: v for k, v in (capture or {}).items() if k not in ('teacher_rows', 'trajectory_rows', 'supplemental_rows')},
+            diagnosis={k: v for k, v in (diagnosis or {}).items() if k not in ('teacher_rows', 'trajectory_rows', 'supplemental_rows')},
+            full_diagnostic_rows='stage_a/diagnosis.json', full_capture_rows='stage_a/capture.json'),
