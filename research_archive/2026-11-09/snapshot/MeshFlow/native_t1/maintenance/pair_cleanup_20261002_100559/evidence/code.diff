+"""Small combinatorial fixtures; never executes a model or full GT run."""
+import unittest
+import numpy as np
+from experiments.mf_h1_local0.geometric_pair_closure_pilot.gt_audit import indexed_diagnostics, t_junctions, incompatibilities, exact_coordinate_index
+
+V=np.asarray([[0,0,0],[1,0,0],[0,1,0],[0,0,1]],dtype=np.float32)
+F=np.asarray([[0,2,1],[0,1,3],[0,3,2],[1,2,3]],dtype=np.int64)
+
+def diag(v,f):return indexed_diagnostics(v,f,10.)
+
+class GTAuditFixtures(unittest.TestCase):
+ def test_closed_tetra_and_reoriented_archive(self):
+  a=diag(V,F);g=F.copy();g[0]=g[0,::-1];b=diag(V,g)
+  self.assertEqual(a['COMBINATORIAL_CLOSURE_STATUS'],'CLOSED_TRIANGLE_2_MANIFOLD')
+  self.assertTrue(a['orientation']['current_winding_consistent'])
+  self.assertFalse(b['orientation']['current_winding_consistent'])
+  self.assertTrue(b['orientation']['can_consistently_reorient_two_incident_edges'])
+ def test_two_disjoint_closed_shells_allowed(self):
+  a=diag(np.concatenate([V,V+4]),np.concatenate([F,F+4]))
+  self.assertEqual(a['shared_edge_components']['count'],2)
+  self.assertEqual(a['COMBINATORIAL_CLOSURE_STATUS'],'CLOSED_TRIANGLE_2_MANIFOLD')
+ def test_closed_torus_handle_allowed(self):
+  m,n=5,6;v=[]
+  for i in range(m):
+   for j in range(n):
+    a,b=2*np.pi*i/m,2*np.pi*j/n;v.append([(2+.5*np.cos(b))*np.cos(a),(2+.5*np.cos(b))*np.sin(a),.5*np.sin(b)])
+  f=[]
+  for i in range(m):
+   for j in range(n):
+    a=i*n+j;b=((i+1)%m)*n+j;c=((i+1)%m)*n+(j+1)%n;d=i*n+(j+1)%n;f.extend([[a,b,c],[a,c,d]])
+  q=diag(np.asarray(v,np.float32),np.asarray(f))
+  self.assertEqual(q['COMBINATORIAL_CLOSURE_STATUS'],'CLOSED_TRIANGLE_2_MANIFOLD')
+  self.assertEqual(q['components_and_genus'][0]['genus'],1)
+ def test_shared_vertex_link_is_not_two_legal_shells(self):
+  v=np.concatenate([V,-V[1:]]);second=F.copy();second[second>0]+=3
+  a=diag(v,np.concatenate([F,second]))
+  self.assertEqual(a['edge_incidence']['one'],0)
+  self.assertEqual(a['edge_incidence']['more_than_two'],0)
+  self.assertEqual(a['vertex_links']['nonmanifold_vertex_ids'],[0])
+ def test_open_duplicate_and_degenerate(self):
+  self.assertEqual(diag(V,F[:-1])['edge_incidence']['one'],3)
+  self.assertTrue(diag(V,np.concatenate([F,F[:1]]))['duplicate_face_groups'])
+  v=np.asarray([[0,0,0],[1,0,0],[2,0,0]],np.float32)
+  self.assertEqual(diag(v,np.asarray([[0,1,2]]))['geometry_degeneracy']['exact_zero_area_face_ids'],[0])
+ def test_exact_t_junction_and_near_not_exact(self):
+  v=np.asarray([[0,0,0],[2,0,0],[0,2,0],[1,0,0],[1,0,1],[2,1,1]],np.float32);f=np.asarray([[0,1,2],[3,4,5]])
+  q=t_junctions(v,f,10.);self.assertTrue(any(x['vertex_id']==3 and x['edge_vertex_ids']==[0,1] for x in q['exact_T_junctions']))
+  v[3,1]=1e-10;q=t_junctions(v,f,10.);self.assertFalse(any(x['vertex_id']==3 and x['edge_vertex_ids']==[0,1] for x in q['exact_T_junctions']))
+ def test_coordinate_identity_diagnostic_separate(self):
+  v=np.concatenate([V,V]);f=np.concatenate([F,F+4]);source=diag(v,f)
+  ev,ef=exact_coordinate_index(v[f]);merged=diag(ev,ef)
+  self.assertEqual(source['COMBINATORIAL_CLOSURE_STATUS'],'CLOSED_TRIANGLE_2_MANIFOLD')
+  self.assertTrue(merged['duplicate_face_groups'])
+
+if __name__=='__main__':unittest.main()
