+    record=dict(schema='geometric_pair_closure_GT_audit_v1',status=status,formal_training_allowed=status=='PASS_COMPATIBLE_AT_FLOATING_AUDIT_LEVEL',input=dict(path=str(INPUT),sha256=INPUT_SHA),parents=rows,blockers=all_blockers,
+        unresolved_pairs=unresolved_total,detector_policy=DETECTOR_POLICY,ledger=ledger,
+        counts=dict(source_checkpoint_loads=0,model_calls=0,OT_calls=0,loss_calls=0,autograd_calls=0,optimizer_updates=0,geometry_repairs=0,indexed_topology_audits=6,exact_coordinate_indexings=2,T_junction_passes=2,triangle_pair_requests=12432,file_SHA_calls=3),
