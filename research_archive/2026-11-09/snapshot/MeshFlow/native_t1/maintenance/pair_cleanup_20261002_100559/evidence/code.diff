+"""Small synthetic scoring fixtures. No matcher, solver, model or autograd calls."""
+import copy
+import unittest
+import numpy as np
+from experiments.mf_h1_local0.geometric_pair_closure_pilot.diagnostic_metrics import score_pairs,select_window
+
+
+def matching():
+    # Two triangles carry the same unordered source edges; opposite corner order.
+    triangles=np.asarray([[[0,0,0],[2,0,0],[0,1,0]],[[2,0,0],[0,0,0],[0,1,0]]],dtype=np.float64)
+    edges=np.asarray(((0,1),(1,2),(2,0)))
+    ep=triangles[:,edges,:].reshape(6,2,3)
+    pairs=np.asarray([[0,3],[1,5],[2,4]])
+    lengths=np.linalg.norm(ep[:,1]-ep[:,0],axis=1)
+    return dict(status='PASS',pairs=pairs,endpoint_flip=np.ones(3,bool),weights=lengths[pairs].mean(1),
+        confidence_mask=np.asarray([True,False,True]),edge_endpoints=ep,edge_face_ids=np.repeat(np.arange(2),3),
+        edge_corner_ids=np.tile(edges,(2,1)),known_mask=np.asarray([True,False]),valid_mask=np.ones(2,bool),
+        remaining_edge_ids=np.arange(6),fixed_C_pairs=np.empty((0,2),int))
+
+
+def row_metric(accepted=100,correct=98,total=500):
+    f=dict(pair_count=total,halfedge_count=2*total,correct_pair_count=total,covered_edge_length=float(2*total))
+    a=dict(pair_count=accepted,halfedge_count=2*accepted,correct_pair_count=correct,covered_edge_length=float(2*accepted))
+    return dict(status='PASS',finite=True,GT_precision='AVAILABLE',full={'all':f},confident={'all':a})
+
+
+def rows():
+    return [dict(parent=p,K=K,noise_index=n,t=t,geometry='Yhat',metrics=row_metric())
+        for p in (0,1) for t in (.5,.7,.84,.94) for K in (4,8,12) for n in (0,1)]
+
+
+class DiagnosticFixtures(unittest.TestCase):
+ def test_partner_plus_endpoint_accuracy_and_coverage(self):
+    m=matching();ids=np.asarray([[10,11,12],[11,10,12]])
+    q=score_pairs(m,ids)
+    self.assertEqual(q['full']['all']['correct_pair_count'],3)
+    self.assertEqual(q['full']['all']['gap']['max'],0)
+    self.assertAlmostEqual(q['confident']['all']['halfedge_coverage'],2/3)
+    self.assertEqual(q['full']['CF']['pair_count'],3)
+    self.assertEqual(q['full']['FF']['pair_count'],0)
+    self.assertLess(q['confident']['all']['edge_length_coverage'],q['confident']['all']['halfedge_coverage'])
+    m['endpoint_flip'][0]=False;q=score_pairs(m,ids)
+    self.assertEqual(q['full']['all']['partner_identity_correct_pair_count'],3)
+    self.assertEqual(q['full']['all']['correct_pair_count'],2)
+    self.assertEqual(q['full']['all']['wrong_endpoint_given_correct_partner_count'],1)
+ def test_no_GT_and_empty_acceptance(self):
+    m=matching();m['confidence_mask'][:]=False;q=score_pairs(m)
+    self.assertEqual(q['full']['all']['precision'],'NOT_AVAILABLE')
+    self.assertEqual(q['confident']['all']['halfedge_coverage'],0)
+    self.assertIsNone(q['confident']['all']['gap']['RMS'])
+    q=score_pairs(m,np.asarray([[10,11,12],[11,10,12]]))
+    self.assertIsNone(q['confident']['all']['precision'])
+    self.assertEqual(q['confident']['all']['correct_pair_count'],0)
+ def test_actual_slot_permutation(self):
+    m=matching();ids=np.asarray([[10,11,12],[11,10,12]])
+    ref=score_pairs(m,ids);q=copy.deepcopy(m)
+    # Swap face slots, while retaining ordered pair endpoints via the map.
+    remap=np.asarray([3,4,5,0,1,2]);q['pairs']=remap[m['pairs']]
+    q['edge_endpoints']=m['edge_endpoints'][remap];q['known_mask']=m['known_mask'][::-1]
+    got=score_pairs(q,ids[::-1])
+    self.assertEqual(ref['full'],got['full']);self.assertEqual(ref['confident'],got['confident'])
+ def test_failure_and_nonfinite_propagation(self):
+    self.assertEqual(score_pairs(dict(status='FAILED',failure_code='NO_FULL_FEASIBLE_MATCHING'))['status'],'FAILED')
+    m=matching();m['edge_endpoints'][0,0,0]=np.nan
+    self.assertEqual(score_pairs(m)['status'],'FAILED')
+ def test_exact_thresholds_and_first_admissible_window(self):
+    a=rows();self.assertEqual(select_window(a)['selected_t0'],.5)
+    for row in a:
+      if row['parent']==1 and row['t']==.5:row['metrics']=row_metric(correct=97)
+    q=select_window(a);self.assertEqual(q['selected_t0'],.7)
+    for row in a:
+      if row['t']==.84:row['metrics']=row_metric(accepted=99,correct=99)
+    self.assertIsNone(select_window(a)['selected_t0'])
+ def test_micro_count_aggregation_not_state_mean(self):
+    a=rows()
+    for row in a:
+      if row['K']==4 and row['noise_index']==0:row['metrics']=row_metric(accepted=1,correct=0,total=1)
+      else:row['metrics']=row_metric(accepted=100,correct=100,total=100)
+    q=select_window(a);self.assertEqual(q['selected_t0'],.5)
+    self.assertAlmostEqual(q['cells'][0]['precision'],500/501)
+ def test_missing_grid_duplicates_and_Xt_rejected(self):
+    a=rows();self.assertIsNone(select_window(a[1:])['selected_t0'])
+    a=rows();a[0]['noise_index']=1;self.assertFalse(select_window(a)['protocol_grid_complete'])
+    a=rows();a[0]['geometry']='Xt'
+    with self.assertRaises(ValueError):select_window(a)
+ def test_later_failure_cannot_be_hidden(self):
+    a=rows();a[-1]['metrics']=dict(status='FAILED',finite=False)
+    self.assertIsNone(select_window(a)['selected_t0'])
+
+if __name__=='__main__':unittest.main()
