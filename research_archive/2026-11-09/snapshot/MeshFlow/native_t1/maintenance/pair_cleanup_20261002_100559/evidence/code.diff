+            if any(_counter(count, key) != active for key in ('pair_active_samples', 'matching_attempts', 'matching_returns', 'matching_solver_attempts', 'matching_solver_returns', 'pair_loss_attempts', 'pair_loss_returns')):
+                errors.append(arm + ' selected-state matching/loss ledger differs from Pair audit')
+    if sampling.get('extra_replays', 0) != 0:
+        errors.append('Formal sampling contains replay count; separate formal/replays.json accounting is required')
+    if final:
