+"""Pure offline aggregation of saved records; no geometry/model imports.
+
+Construction and legality rates always use every requested output. Continuous
+post metrics use only available candidates and expose that subset explicitly.
+The saved detailed audits remain authoritative and are referenced, not copied.
+"""
+from __future__ import annotations
+
+import argparse
+import csv
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import statistics
+import time
+
+MODELS = ('B_Edge', 'B_JEdge5', 'P_Time', 'P_Conf')
+BUDGETS = (.001, .003, .005)
+COMPARISONS = (('P_Time', 'B_Edge'), ('P_Time', 'B_JEdge5'),
+               ('P_Conf', 'B_Edge'), ('P_Conf', 'B_JEdge5'),
+               ('P_Conf', 'P_Time'))
+STREAM_SHA = '609071dc47dd8805a43f79e4259ed649a39bee5808cb37978c2d939e5981e11c'
+SCHEMA = 'geometric_pair_closure_offline_summary_v1'
+LOO_METRICS = ('remainder_symmetric_RMS_bbox_pct', 'free_to_target_RMS_bbox_pct',
+               'target_to_free_RMS_bbox_pct', 'Gamma_surface_RMS_bbox_pct',
+               'Gamma_edges_RMS_bbox_pct', 'Gamma_surface_coverage_0.001',
+               'Gamma_edges_coverage_0.001', 'CF_illegal_pair_count',
+               'FF_illegal_pair_count', 'free_total_area',
+               'free_min_angle_lt5_fraction', 'pair_full_all_gap_RMS',
+               'pair_confident_all_halfedge_coverage')
+
+
+def _get(value, *keys):
+    for key in keys:
+        if not isinstance(value, dict):
+            return None
+        value = value.get(key)
+    return value
+
+
+def _number(value):
+    return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value)
+
+
+def _seal(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(',', ':'),
+                                    allow_nan=False).encode()).hexdigest()
+
+
+def _direction(name):
+    if ('coverage' in name or name == 'free_angle_p05_degrees'):
+        return 'higher'
+    if name.endswith(('total_area', 'pair_count', 'halfedge_count', 'edge_length')) and not any(
+            word in name for word in ('illegal', 'proper', 'coplanar', 'unresolved')):
+        return 'descriptive_only'
+    return 'lower'
+
+
+def distribution(values, direction='lower'):
+    """Unavailable/nonfinite values never become zero; disclose every omission."""
+    values = list(values)
+    finite = [float(v) for v in values if _number(v)]
+    return dict(requests=len(values), available=len(finite), unavailable=len(values)-len(finite),
+                mean=statistics.fmean(finite) if finite else None,
+                median=statistics.median(finite) if finite else None,
+                minimum=min(finite) if finite else None, maximum=max(finite) if finite else None,
+                worst=(min(finite) if direction == 'higher' else max(finite))
+                    if finite and direction != 'descriptive_only' else None,
+                preferred_direction=direction, available_subset_only=len(finite) != len(values))
+
+
+def _rate(values):
+    values = list(values)
+    passed = sum(v is True for v in values)
+    failed = sum(v is False for v in values)
+    return dict(requests=len(values), passed=passed, known_failed=failed,
+                not_evaluated=len(values)-passed-failed,
+                success_rate=passed/len(values) if values else None,
+                denominator='all_requested_outputs_in_this_cell')
+
+
+def flatten_geometry(score):
+    """Only saved scalar fields; no distance/topology/intersection calculation."""
+    paths = {
+        'remainder_symmetric_RMS_bbox_pct': ('remainder', 'symmetric_rms_bbox_pct'),
+        'free_to_target_RMS_bbox_pct': ('remainder', 'predicted_to_target_rms_bbox_pct'),
+        'target_to_free_RMS_bbox_pct': ('remainder', 'target_to_predicted_rms_bbox_pct'),
+        'whole_symmetric_RMS_bbox_pct': ('whole_surface', 'symmetric_rms_bbox_pct'),
+        'fixed_target_RMS_bbox_pct': ('target_coverage', 'rms_bbox_pct'),
+        'fixed_target_p95_bbox_pct': ('target_coverage', 'q95_bbox_pct'),
+        'fixed_target_coverage_0.01': ('target_coverage', 'fraction_target_points_within_1pct_bbox'),
+        'free_total_area': ('free_quality', 'total_area'),
+        'free_q_gt10_fraction': ('free_quality', 'q_actual_gt10_fraction'),
+        'free_min_angle_lt5_fraction': ('free_quality', 'min_angle_lt5_fraction'),
+        'free_angle_p05_degrees': ('free_quality', 'angle_p05_degrees'),
+        'free_zero_area_count': ('free_quality', 'exact_zero_area_count'),
+        'free_near_degenerate_count': ('free_quality', 'near_degenerate_area_count'),
+        'boundary_edge_count': ('exact_coordinate_topology', 'boundary_edge_count'),
+        'boundary_edge_length_bbox_fraction': ('exact_coordinate_topology', 'boundary_edge_length_bbox_fraction'),
+        'NaN_coordinate_count': ('NaN_coordinate_count',),
+        'Inf_coordinate_count': ('Inf_coordinate_count',),
+    }
+    for kind in ('surface', 'edges'):
+        for metric in ('RMS_bbox_pct', 'p95_bbox_pct'):
+            paths[f'Gamma_{kind}_{metric}'] = ('Gamma', kind, metric)
+        for threshold in (.0005, .001, .002, .005, .01):
+            paths[f'Gamma_{kind}_coverage_{threshold}'] = ('Gamma', kind, 'coverage_by_bbox_fraction', str(threshold))
+    for scope in ('CF', 'FF', 'CC'):
+        for metric in ('illegal_pair_count', 'proper_pair_count', 'coplanar_overlap_pair_count',
+                       'unresolved_pair_count', 'proper_affected_free_face_count'):
+            paths[f'{scope}_{metric}'] = ('intersections', 'scopes', scope, metric)
+    return {name: (_get(score, *path) if _number(_get(score, *path)) else None)
+            for name, path in paths.items()}
+
+
+def flatten_pairs(score):
+    answer = {}
+    for subset in ('full', 'confident'):
+        for category in ('all', 'FF', 'CF'):
+            row = _get(score, subset, category)
+            for metric in ('pair_count', 'halfedge_count', 'halfedge_coverage', 'edge_length_coverage',
+                           'covered_edge_length', 'full_edge_length'):
+                answer[f'pair_{subset}_{category}_{metric}'] = _get(row, metric)
+            for metric in ('RMS', 'p95', 'max'):
+                answer[f'pair_{subset}_{category}_gap_{metric}'] = _get(row, 'gap', metric)
+    return answer
+
+
+def _checks(score, audit=None):
+    names = ('each_edge_exactly_two', 'each_vertex_link_one_cycle', 'orientable',
+             'no_duplicate_faces', 'no_degenerate_faces', 'intersections_resolved_and_no_illegal',
+             'C_bitwise_preserved', 'face_count_preserved', 'finite')
+    checks = _get(score, 'legality_checks') or {}
+    result = {name: checks.get(name) if isinstance(checks.get(name), bool) else None for name in names}
+    result['joint_legal'] = _get(score, 'joint_legal')
+    if audit is not None:
+        combined = _get(audit, 'legality_checks') or {}
+        # Both exact-coordinate and the actual shared-index candidate must pass.
+        for name in names[:5]:
+            a, b = combined.get(name), combined.get('explicit_index_' + name)
+            result[name] = (a and b) if isinstance(a, bool) and isinstance(b, bool) else None
+        result.update(constructed=audit.get('constructed'), joint_legal=audit.get('joint_legal'))
+        for budget in BUDGETS:
+            result[f'joint_legal_with_budget_{budget}'] = _get(audit, 'budgets', str(budget), 'passed')
+    return result
+
+
+def flatten_row(row):
+    audit = row.get('candidate_audit') or {}
+    raw = flatten_geometry(row.get('raw_metrics'))
+    raw.update(flatten_pairs(row.get('pair_metrics')))
+    post = flatten_geometry(row.get('post_metrics'))
+    for metric in ('RMS', 'p95', 'max', 'maximum_bbox_fraction'):
+        post['displacement_' + metric] = _get(audit, 'displacement', metric)
+    return dict(key=row['key'], model=row['model'], parent=int(row['parent']),
+        patch=int(row['patch']), patch_group='old' if int(row['patch']) <= 2 else 'new',
+        seed=int(row['seed']), raw_path=row.get('raw_path'), raw_sha256=row.get('raw_sha256'),
+        matching_path=row.get('matching_path'), post_path=row.get('post_path'),
+        matching_status=row.get('matching_status'), matching_failure=row.get('matching_failure'),
+        candidate_status=row.get('candidate_status'), candidate_failure=row.get('candidate_failure'),
+        raw_score_status=_get(row, 'raw_metrics', 'status'),
+        post_score_status=_get(row, 'post_metrics', 'status') or 'NOT_AVAILABLE_NO_CANDIDATE',
+        post_continuous_metrics_subset='All constructed candidates, including illegal ones; availability is metric-specific',
+        generated_partner_GT_precision='NOT_AVAILABLE', raw=raw, post=post,
+        raw_checks=_checks(row.get('raw_metrics')),
+        post_checks=_checks(row.get('post_metrics'), audit), seconds=row.get('seconds', {}))
+
+
+def _group_definitions():
+    for parent in (0, 1):
+        for patch in range(5):
+            yield f'P{parent}/patch{patch}', parent, [patch], 'single_patch'
+        yield f'P{parent}/old', parent, [0, 1, 2], 'descriptive_repeated_seeds_across_patches'
+        yield f'P{parent}/new', parent, [3, 4], 'descriptive_repeated_seeds_across_patches'
+
+
+def _cell(rows, seeds):
+    result = dict(requests=len(rows), seeds=sorted({r['seed'] for r in rows}),
+                  patches=sorted({r['patch'] for r in rows}), independent_noise_count=len(seeds))
+    for stage in ('raw', 'post'):
+        names = sorted({name for row in rows for name in row[stage]})
+        checks = sorted({name for row in rows for name in row[stage + '_checks']})
+        result[stage] = dict(metrics={name: distribution((r[stage].get(name) for r in rows), _direction(name))
+                                      for name in names},
+                             rates={name: _rate(r[stage + '_checks'].get(name) for r in rows) for name in checks})
+    result['matching_success'] = _rate(r['matching_status'] == 'PASS' for r in rows)
+    result['candidate_failures'] = {str(k): sum(r['candidate_failure'] == k for r in rows)
+        for k in sorted({r['candidate_failure'] for r in rows if r['candidate_failure'] is not None})}
+    return result
+
+
+def _paired_distribution(values, direction):
+    result = distribution(values, direction)
+    finite = [v for v in values if _number(v)]
+    result.update(difference='candidate_minus_reference', exact_ties=sum(v == 0 for v in finite),
+        improvement_count=(sum(v > 0 for v in finite) if direction == 'higher' else sum(v < 0 for v in finite))
+            if direction != 'descriptive_only' else None,
+        worse_count=(sum(v < 0 for v in finite) if direction == 'higher' else sum(v > 0 for v in finite))
+            if direction != 'descriptive_only' else None,
+        median_is='median_of_per_seed_paired_differences_not_difference_of_output_medians')
+    return result
+
+
+def _pair_rows(rows):
+    lookup = {(r['model'], r['parent'], r['patch'], r['seed']): r for r in rows}
+    answer = []
+    for candidate, reference in COMPARISONS:
+        for row in (r for r in rows if r['model'] == candidate):
+            ref = lookup[reference, row['parent'], row['patch'], row['seed']]
+            value = dict(comparison=f'{candidate}_minus_{reference}', candidate=candidate,
+                         reference=reference, parent=row['parent'], patch=row['patch'], seed=row['seed'])
+            for stage in ('raw', 'post'):
+                names = sorted(set(row[stage]) | set(ref[stage]))
+                value[stage] = {name: row[stage][name] - ref[stage][name]
+                    if _number(row[stage].get(name)) and _number(ref[stage].get(name)) else None for name in names}
+                # Legality rates remain paired over all requests, including construction failures.
+                checks = sorted(set(row[stage+'_checks']) | set(ref[stage+'_checks']))
+                value[stage+'_success_differences'] = {
+                    name: int(row[stage+'_checks'].get(name) is True) - int(ref[stage+'_checks'].get(name) is True)
+                    for name in checks}
+            answer.append(value)
+    return answer
+
+
+def _paired_cell(rows, seeds):
+    result = dict(requested_pairs=len(rows), same_parent_patch_seed=True,
+        post_metric_denominator='Only paired outputs with that metric available on both sides; never zero-fill failures',
+        post_rate_denominator='All requested pairs; NOT_RUN/nonconstructed is not a success')
+    for stage in ('raw', 'post'):
+        names = sorted({name for row in rows for name in row[stage]})
+        checks = sorted({name for row in rows for name in row[stage+'_success_differences']})
+        metrics = {name: _paired_distribution([r[stage].get(name) for r in rows], _direction(name)) for name in names}
+        rates = {name: _paired_distribution([r[stage+'_success_differences'].get(name) for r in rows], 'higher')
+                 for name in checks}
+        leave_one = {}
+        for seed in seeds:
+            retained = [r for r in rows if r['seed'] != seed]
+            leave_one[str(seed)] = dict(omitted_seed=seed, requested_pairs_remaining=len(retained),
+                metrics={name: _paired_distribution([r[stage].get(name) for r in retained], _direction(name))
+                         for name in LOO_METRICS if name in names},
+                rates={name: _paired_distribution([r[stage+'_success_differences'].get(name) for r in retained], 'higher')
+                       for name in checks})
+        result[stage] = dict(metrics=metrics, success_rate_differences=rates, leave_one_seed_out=leave_one)
+    return result
+
+
+def aggregate_rows(rows, seeds):
+    """Validate the complete saved matrix, then perform scalar arithmetic only."""
+    seeds = list(seeds)
+    if len(seeds) != 4 or len(set(seeds)) != 4:
+        raise ValueError('Exactly four registered seeds required')
+    expected = {(m, p, j, s) for m in MODELS for p in (0, 1) for j in range(5) for s in seeds}
+    keys = [(r['model'], int(r['parent']), int(r['patch']), int(r['seed'])) for r in rows]
+    if len(rows) != 160 or len(set(keys)) != 160 or set(keys) != expected:
+        raise ValueError('The complete unique 4-model x 2-parent x 5-patch x 4-seed matrix is required')
+    flat = [flatten_row(row) for row in rows]
+    grouped = {}
+    for key, parent, patches, scope in _group_definitions():
+        grouped[key] = dict(parent=parent, patches=patches, scope=scope,
+            aggregation='Equal output weight; patch-group rows reuse the same four seeds and are descriptive, not extra independent noises',
+            models={model: _cell([r for r in flat if r['model'] == model and r['parent'] == parent and r['patch'] in patches], seeds)
+                    for model in MODELS})
+    differences = _pair_rows(flat)
+    paired = {}
+    for candidate, reference in COMPARISONS:
+        name = f'{candidate}_minus_{reference}'
+        paired[name] = {key: _paired_cell([r for r in differences if r['comparison'] == name
+            and r['parent'] == parent and r['patch'] in patches], seeds)
+            for key, parent, patches, scope in _group_definitions()}
+    return dict(rows=flat, grouped=grouped, paired=paired, paired_per_output=differences,
+        policy=dict(success_rates_use_all_requests=True, missing_post_metrics_are_not_zero=True,
+            constructed_illegal_candidates_are_included=True, post_continuous_metrics_are_available_subsets=True,
+            raw_topology_is_exact_coordinate_diagnostic_not_explicit_weld=True,
+            post_topology_requires_exact_and_explicit_index_checks=True,
+            original_patch_ids=[0, 1, 2], new_patch_ids=[3, 4], independent_generation_seeds=seeds,
+            leave_one_seed_out='Drop that seed in every patch, deterministically; no sample/patch selection',
+            GT_partner_precision_on_generated_outputs='NOT_AVAILABLE', exact_predicate_certificate='NOT_RUN',
+            continuous_collision_certificate='NOT_RUN', composite_winner='NOT_COMPUTED'))
+
+
+def _write_json(path, value):
+    temporary = path.with_suffix(path.suffix + '.partial')
+    with temporary.open('w', encoding='utf-8', newline='\n') as handle:
+        json.dump(value, handle, ensure_ascii=False, indent=2, allow_nan=False)
+        handle.write('\n')
+    os.replace(temporary, path)
+
+
+def _write_csv(path, rows):
+    records = []
+    for row in rows:
+        value = {key: row.get(key) for key in ('key', 'model', 'parent', 'patch', 'patch_group', 'seed',
+            'matching_status', 'matching_failure', 'candidate_status', 'candidate_failure', 'raw_score_status',
+            'post_score_status', 'raw_path', 'raw_sha256', 'matching_path', 'post_path')}
+        for stage in ('raw', 'post'):
+            value.update({stage+'_'+key: item for key, item in row[stage].items()})
+            value.update({stage+'_pass_'+key: item for key, item in row[stage+'_checks'].items()})
+        records.append(value)
+    columns = list(records[0]) if records else ['key', 'model', 'parent', 'patch', 'seed', 'status']
+    temporary = path.with_suffix('.csv.partial')
+    with temporary.open('w', encoding='utf-8', newline='') as handle:
+        writer = csv.DictWriter(handle, fieldnames=columns)
+        writer.writeheader()
+        writer.writerows(records)
+    os.replace(temporary, path)
+
+
+def _training_summary(value):
+    keep = ('status', 'arm', 'recipe', 'gate', 'completed_updates', 'counts', 'timing',
+            'initial_identity', 'parameters', 'initial_stream_sha256', 'final_state_sha256',
