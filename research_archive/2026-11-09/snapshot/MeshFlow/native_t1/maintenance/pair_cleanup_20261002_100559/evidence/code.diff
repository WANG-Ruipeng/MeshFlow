+"""Bit-preservation observation fixtures, with signed zero as a counterexample."""
+import numpy as np
+from experiments.mf_h1_local0.geometric_pair_closure_pilot.final_sampling import check_known_bits
+
+
+def run():
+    C=np.zeros((12,3,3),dtype=np.float32)
+    C[0,0,0]=np.float32(-0.)
+    path=np.zeros((51,112,9),dtype=np.float32)
+    path[:,:12]=C.reshape(1,12,9)
+    before=path.tobytes()
+    assert check_known_bits(path,C)['known_all51_uint32_equal']
+    assert path.tobytes()==before
+    path[25,0,0]=np.float32(0.)
+    assert np.array_equal(path[:,:12],np.broadcast_to(C.reshape(1,12,9),(51,12,9)))
+    try: check_known_bits(path,C)
+    except AssertionError: pass
+    else: raise AssertionError('Signed-zero mutation was not rejected')
+    return dict(status='PASS',tests_run=2,scope='Synthetic observation of copied states; no model or scientific output changed',counts=dict(autograd_calls=0,model_calls=0,OT_calls=0,matching_calls=0,optimizer_updates=0))
