+    return execution, timing
+
+
+def collect_accounting(out, final=False):
+    """Explicit controller call: write two derived files, then fail closed if needed."""
+    out = Path(out)
+    started = time.perf_counter()
+    records, fixtures, sources = {}, {}, {}
+    for key, relative in FILES.items():
+        path = out / relative
+        if path.exists():
+            raw = path.read_bytes()
+            records[key] = json.loads(raw)
+            sources[relative] = dict(sha256=hashlib.sha256(raw).hexdigest(), bytes=len(raw))
+    for path in sorted(out.glob('*test_record.json')):
+        raw = path.read_bytes()
+        fixtures[path.name] = json.loads(raw)
+        sources[path.name] = dict(sha256=hashlib.sha256(raw).hexdigest(), bytes=len(raw))
+    execution, timing = summarize_records(records, fixtures, final=final)
+    stamp = datetime.now(timezone.utc).isoformat()
+    for value in (execution, timing):
+        value.update(created_utc=stamp, sources=sources,
+                     accounting_seconds=time.perf_counter()-started,
+                     accounting_operation_counts=dict(JSON_reads=len(sources), model_calls=0,
+                         OT_calls=0, matching_calls=0, geometry_scoring_calls=0,
+                         autograd_calls=0, optimizer_updates=0))
+    for name, value in (('execution_counts.json', execution), ('final_timing.json', timing)):
+        path = out / name
+        temporary = path.with_suffix('.accounting.tmp')
+        temporary.write_text(json.dumps(value, indent=2, allow_nan=False), encoding='utf-8')
+        temporary.replace(path)
+    if execution['contract_errors']:
+        raise AssertionError('Accounting contract failed: ' + '; '.join(execution['contract_errors']))
+    return dict(execution_counts=execution, final_timing=timing)
+
