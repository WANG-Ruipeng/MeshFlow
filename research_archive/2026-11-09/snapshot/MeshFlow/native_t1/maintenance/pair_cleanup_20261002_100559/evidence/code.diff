+"""CPU-only trainer wiring fixtures: no generator, OT or matching solver."""
+import ast
+import copy
+import json
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+
+import numpy as np
+import torch
+
+from experiments.mf_h1_local0.geometric_pair_closure_pilot import train as T
+
+
+def write_gate(folder, status='PASS_WINDOW_FOUND', allowed=True, coefficient=.2, t0=.7):
+    stage = Path(folder) / 'stage_a'
+    stage.mkdir(exist_ok=True)
+    window = dict(status=status, formal_training_allowed=allowed, selected_t0=t0,
+                  protocol_grid_complete=True)
+    (stage / 'window.json').write_text(json.dumps(window), encoding='utf-8')
+    (stage / 'diagnosis.json').write_text(json.dumps(dict(status='COMPLETE', window=window)), encoding='utf-8')
+    (stage / 'calibration.json').write_text(json.dumps(dict(status='PASS', t0=t0,
+        lambda_pair=coefficient, window_sha256=T.file_sha256(stage / 'window.json'))), encoding='utf-8')
+
+
+def batch(t=.8):
+    known = torch.tensor([[False, True, False, True]])
+    valid = torch.ones_like(known)
+    # Non-prefix known slots and deliberately large known velocity expose C leakage.
+    velocity = torch.full((1, 4, 9), 2., requires_grad=True)
+    xt = torch.full_like(velocity, .1, requires_grad=True)
+    context = torch.full_like(velocity, 3., requires_grad=True)
+    u = torch.full_like(velocity, .25, requires_grad=True)
+    tv = torch.tensor([t], dtype=torch.float32, requires_grad=True)
+    return velocity, dict(xt=xt, context=context, u=u, t=tv, known_mask=known, valid_mask=valid)
+
+
+def fake_match(x, known, valid, *, ledger=None):
+    assert not x.requires_grad
+    if ledger is not None:
+        T._inc(ledger, 'mock_matching_calls')
+    return dict(status='PASS', counts={}, timing={}, input_geometry_sha256='1'*64,
+                confidence={'accepted_pair_fraction': .5}, full_denominator=2.,
+                known_mask=known, valid_mask=valid)
+
+
+def fake_pair(x, selected, *, confidence=False, ledger=None):
+    # Empty confidence mask must suppress only Pair, not FM or Edge.
+    if ledger is not None:
+        T._inc(ledger, 'mock_pair_calls')
+    free = x[selected['valid_mask'] & ~selected['known_mask']]
+    value = free.square().mean() if not confidence else free.sum()*0.
+    return dict(loss=value, applicable=not confidence, counts={'active_pairs': int(not confidence)})
+
+
+def fake_edge(x, target):
+    return dict(loss=x.square().mean(), applicable=True, counts={})
+
+
+class TrainingGateTests(unittest.TestCase):
+    def test_missing_or_incomplete_window_blocks_before_any_model_load(self):
+        with tempfile.TemporaryDirectory() as folder:
+            with self.assertRaises(FileNotFoundError):
+                T.train_arm(folder, 'P_Time')
+            for status, allowed in (('COMPLETE', True), ('STOP_NO_WINDOW', False), ('PASS_WINDOW_FOUND', False)):
+                write_gate(folder, status=status, allowed=allowed)
+                with self.assertRaises(RuntimeError):
+                    T.train_arm(folder, 'P_Time')
+            self.assertFalse((Path(folder) / 'P_Time').exists())
+
+    def test_invalid_or_mismatched_calibration_rejected(self):
+        with tempfile.TemporaryDirectory() as folder:
+            for coefficient in (0., -1., True, float('nan'), float('inf')):
+                write_gate(folder, coefficient=coefficient)
+                with self.assertRaises(ValueError):
+                    T.read_training_gate(folder)
+            write_gate(folder)
+            p = Path(folder) / 'stage_a/calibration.json'
+            p.write_text(json.dumps(dict(status='PASS', t0=.84, lambda_pair=.2)), encoding='utf-8')
+            with self.assertRaises(RuntimeError):
+                T.read_training_gate(folder)
+
+    def test_registered_indices_preserve_global_rng_and_reject_drift(self):
+        with tempfile.TemporaryDirectory() as folder:
+            write_gate(folder)
+            before = np.random.get_state()
+            a = T.register_pair_indices(folder)
+            b = T.register_pair_indices(folder)
+            after = np.random.get_state()
+            self.assertEqual(a, b)
+            self.assertEqual(len(a['indices']), 500)
+            self.assertEqual(set(a['indices']), set(range(8)))
+            self.assertEqual(before[0], after[0])
+            np.testing.assert_array_equal(before[1], after[1])
+            self.assertEqual(before[2:], after[2:])
+            stored = json.loads(Path(a['path']).read_text())
+            stored['indices'][0] = (stored['indices'][0] + 1) % 8
+            Path(a['path']).write_text(json.dumps(stored))
+            with self.assertRaises(ValueError):
+                T.register_pair_indices(folder)
+
+
+    def test_completed_grid_diagnosis_and_calibration_are_bound(self):
+        cases = (
+            ('window.json', lambda d: d.update(protocol_grid_complete=False)),
+            ('calibration.json', lambda d: d.update(window_sha256='f'*64)),
+            ('diagnosis.json', lambda d: d.update(status='RUNNING')),
+            ('diagnosis.json', lambda d: d['window'].update(selected_t0=.84)),
+        )
+        with tempfile.TemporaryDirectory() as folder:
+            for filename, mutate in cases:
+                write_gate(folder)
+                path = Path(folder) / 'stage_a' / filename
+                saved = json.loads(path.read_text())
+                mutate(saved)
+                path.write_text(json.dumps(saved), encoding='utf-8')
+                with self.assertRaises(RuntimeError):
+                    T.read_training_gate(folder)
+            write_gate(folder)
+            self.assertEqual(T.read_training_gate(folder)['t0'], .7)
+
+
+class ObjectiveWiringTests(unittest.TestCase):
+    def call(self, velocity, b, **kwargs):
+        opts = dict(arm='P_Time', t0=.7, lambda_pair=.2, step=50,
+                    selected=True, denominator=8*18, counts={})
+        opts.update(kwargs)
+        with patch.object(T, 'match_partners', side_effect=fake_match), \
+                patch.object(T, 'pair_loss', side_effect=fake_pair), \
+                patch.object(T, 'edge_loss', side_effect=fake_edge):
+            return T.microbatch_loss(velocity, b, {}, **opts)
+
+    def test_pair_single_sample_weight_no_second_division_by_eight(self):
+        velocity, b = batch()
+        loss, d = self.call(velocity, b)
+        endpoint = .1 + (1 - float(b['t'][0])) * 2.
+        expected_fm = (2. - .25)**2 / 8
+        expected_edge = T.EDGE_LAMBDA * endpoint**2 / 8
+        expected_pair = .2 * endpoint**2
+        self.assertAlmostEqual(float(loss), expected_fm + expected_edge + expected_pair, places=6)
+        self.assertAlmostEqual(d['weighted_Pair'], expected_pair, places=7)
+        self.assertAlmostEqual(d['weighted_Edge'], expected_edge, places=7)
+
+    def test_only_free_velocity_has_gradient_no_C_Xt_GT_time_gradients(self):
+        velocity, b = batch()
+        originals = {key: x.detach().clone() for key, x in b.items()}
+        loss, _ = self.call(velocity, b)
+        loss.backward()
+        self.assertTrue(bool(torch.isfinite(velocity.grad).all()))
+        self.assertTrue(bool((velocity.grad[~b['known_mask']] != 0).all()))
+        self.assertTrue(bool((velocity.grad[b['known_mask']] == 0).all()))
+        for key in ('xt', 'context', 'u', 't'):
+            self.assertIsNone(b[key].grad)
+        for key, x in b.items():
+            self.assertTrue(torch.equal(x.detach(), originals[key]))
+
+    def test_confidence_empty_does_not_suppress_FM_or_Edge(self):
+        velocity, b = batch()
+        loss, d = self.call(velocity, b, arm='P_Conf')
+        self.assertEqual(d['Pair'], 0.)
+        self.assertFalse(d['Pair_applicable'])
+        self.assertGreater(d['FM'], 0.)
+        self.assertGreater(d['weighted_Edge'], 0.)
+        loss.backward()
+        self.assertTrue(bool((velocity.grad[~b['known_mask']] != 0).all()))
+
+    def test_gate_and_uniform_selection_do_not_choose_other_active_samples(self):
+        for stored_t, selected, expected_edge in ((.8, False, True), (.6, True, True), (.4, True, False)):
+            velocity, b = batch(stored_t)
+            counts = {}
+            _, d = self.call(velocity, b, selected=selected, counts=counts)
+            self.assertFalse(d['Pair_active'])
+            self.assertEqual(d['Edge_active'], expected_edge)
+            self.assertEqual(counts.get('mock_matching_calls', 0), 0)
+            self.assertEqual(counts.get('pair_selected_samples', 0), int(selected))
+
+    def test_matching_failure_stops_instead_of_turning_into_zero(self):
+        velocity, b = batch()
+        with patch.object(T, 'edge_loss', side_effect=fake_edge), \
+                patch.object(T, 'match_partners', return_value=dict(status='FAILED', failure_code='NO_FULL_FEASIBLE_MATCHING')), \
