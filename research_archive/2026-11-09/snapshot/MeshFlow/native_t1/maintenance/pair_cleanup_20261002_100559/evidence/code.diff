+        model_backward_returns=_counter(combined_train, 'backward_returns') + _counter(ds, 'model_backward_calls') + _counter(cc, 'model_backwards') + _counter(calibration_counts, 'model_backwards') + _counter(sc, 'model_backward_calls') + _counter(rc, 'model_backward_calls'),
+        OT_calls=_counter(cc, 'OT_calls') + _counter(combined_train, 'OT_calls'),
