+import unittest
+import numpy as np
+from experiments.mf_h1_local0.geometric_pair_closure_pilot.closure import construct_candidate
+
+
+def paired_triangles():
+    a=np.array([[0,0,0],[2,0,0],[0,1,0]],dtype=np.float32)
+    b=a+np.float32(.01)
+    return np.stack([a,b]),dict(status='PASS',all_pairs=[[0,3],[1,4],[2,5]],all_endpoint_flip=[False]*3)
+
+
+class ClosureTests(unittest.TestCase):
+    def test_fixed_C_and_explicit_duplicate_risk(self):
+        x,m=paired_triangles()
+        r=construct_candidate(x,np.array([True,False]),m)
+        self.assertEqual(r['status'],'CANDIDATE')
+        self.assertEqual(r['triangles'][0].tobytes(),x[0].tobytes())
+        np.testing.assert_array_equal(r['triangles'][1],x[0])
+        self.assertEqual(r['risk']['duplicate_index_face_groups'],[[0,1]])
+        self.assertEqual(r['legality'],'NOT_AUDITED')
+
+    def test_pair_order_independent_equal_weight_mean(self):
+        x,m=paired_triangles()
+        a=construct_candidate(x,np.array([False,False]),m)
+        m['all_pairs']=list(reversed(m['all_pairs']))
+        b=construct_candidate(x,np.array([False,False]),m)
+        np.testing.assert_array_equal(a['triangles'],b['triangles'])
+        mean=x.astype(np.float64).mean(axis=0).astype(np.float32)
+        np.testing.assert_array_equal(a['triangles'][0],mean)
+
+    def test_conflicting_fixed_anchors_never_moved(self):
+        x,m=paired_triangles();before=x.tobytes()
+        r=construct_candidate(x,np.array([True,True]),m)
+        self.assertEqual(r['failure_code'],'C_ANCHOR_CONFLICT')
+        self.assertEqual(x.tobytes(),before)
+        self.assertNotIn('triangles',r)
+
+    def test_padding_and_scattered_C(self):
+        x,m=paired_triangles()
+        padded=np.stack([x[1],np.full_like(x[0],np.nan),x[0]])
+        m['all_pairs']=[[0,6],[1,7],[2,8]]
+        r=construct_candidate(padded,np.array([False,False,True]),m,np.array([True,False,True]))
+        self.assertEqual(r['status'],'CANDIDATE')
+        self.assertEqual(r['triangles'][2].tobytes(),x[0].tobytes())
+        self.assertTrue(np.isnan(r['triangles'][1]).all())
+        self.assertTrue((r['faces'][1]==-1).all())
+
+    def test_incomplete_and_failed_matching_cannot_construct(self):
+        x,m=paired_triangles()
+        m['all_pairs']=m['all_pairs'][:-1];m['all_endpoint_flip']=m['all_endpoint_flip'][:-1]
+        r=construct_candidate(x,np.array([True,False]),m)
+        self.assertEqual(r['failure_code'],'INCOMPLETE_MATCHING')
+        r=construct_candidate(x,np.array([True,False]),dict(status='FAILED',failure_code='NO_PERFECT_MATCH'))
+        self.assertEqual(r['failure_code'],'MATCHING_FAILED')
+
+if __name__=='__main__':
+    unittest.main()
