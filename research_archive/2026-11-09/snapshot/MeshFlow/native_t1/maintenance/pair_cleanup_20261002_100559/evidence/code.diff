+"""Render compact tables from frozen scalar results; no scientific reruns."""
+import json
+import math
+import statistics
+from pathlib import Path
+
+MODELS=('B_Edge','B_JEdge5','P_Time','P_Conf')
+
+def fmt(x,n=4):
+    return 'NA' if x is None or not math.isfinite(float(x)) else f'{x:.{n}f}'
+
+def mean(rows,stage,key):
+    values=[r[stage].get(key) for r in rows]
+    values=[x for x in values if isinstance(x,(int,float)) and not isinstance(x,bool) and math.isfinite(x)]
+    return statistics.fmean(values) if values else None
+
+def count(rows,stage,key):
+    return sum(r[stage+'_checks'].get(key) is True for r in rows)
+
+def table(header,rows):
+    return '\n'.join(['|'+'|'.join(header)+'|','|'+'|'.join(['---']*len(header))+'|']+['|'+'|'.join(map(str,row))+'|' for row in rows])
+
+def make_tables(out):
+    out=Path(out); result=json.loads((out/'results.json').read_text(encoding='utf-8'))
+    rows=result['rows'];parts=[]
+    groups=[(f'P{p}/old0-2',p,[0,1,2]) for p in (0,1)]
+    groups += [(f'P{p}/patch{k}',p,[k]) for p in (0,1) for k in (3,4)]
+    raw=[];close=[];quality=[]
+    for name,p,patches in groups:
+        for model in MODELS:
+            q=[r for r in rows if r['model']==model and r['parent']==p and r['patch'] in patches]
+            m=lambda key:fmt(mean(q,'raw',key))
+            raw.append([name,model,len(q),m('remainder_symmetric_RMS_bbox_pct'),m('free_to_target_RMS_bbox_pct'),m('target_to_free_RMS_bbox_pct'),m('Gamma_surface_RMS_bbox_pct'),m('Gamma_surface_p95_bbox_pct'),m('pair_full_all_gap_RMS')])
+            n=len(q);rate=lambda stage,key:f'{count(q,stage,key)}/{n}'
+            close.append([name,model,rate('raw','each_edge_exactly_two'),rate('raw','joint_legal'),rate('post','constructed'),rate('post','joint_legal')]+[rate('post','joint_legal_with_budget_'+str(b)) for b in (.001,.003,.005)])
+            quality.append([name,model,m('FF_illegal_pair_count'),m('CF_illegal_pair_count'),m('CF_unresolved_pair_count'),m('free_total_area'),m('free_min_angle_lt5_fraction'),m('Gamma_edges_RMS_bbox_pct'),m('Gamma_edges_p95_bbox_pct')])
+    parts.append(('Raw completion and interface',table(['cell','model','n','RMS %bbox','free->R %','R->free %','Gamma surface RMS %','Gamma surface p95 %','all-pair gap RMS (model units)'],raw)))
+    parts.append(('Closure and fixed displacement budgets',table(['cell','model','raw edge2','raw joint','constructed','post joint','<=0.1%','<=0.3%','<=0.5%'],close)))
+    parts.append(('Raw quality and Gamma to finite free edges',table(['cell','model','FF illegal','CF illegal','CF unresolved','free area','angle<5deg fraction','Gamma edge RMS %','Gamma edge p95 %'],quality)))
+    patch=[]
+    for p in (0,1):
+        for k in range(5):
+            for model in MODELS:
+                q=[r for r in rows if r['model']==model and r['parent']==p and r['patch']==k]
+                values=[r['raw']['remainder_symmetric_RMS_bbox_pct'] for r in q]
+                values=[v for v in values if v is not None]
+                patch.append([f'P{p}/patch{k}',model,fmt(statistics.fmean(values)) if values else 'NA',fmt(statistics.median(values)) if values else 'NA',fmt(max(values)) if values else 'NA',fmt(mean(q,'raw','pair_full_all_gap_RMS')),fmt(mean(q,'raw','Gamma_surface_p95_bbox_pct')),f"{count(q,'post','joint_legal_with_budget_0.003')}/4"])
+    parts.append(('All ten cells, no exclusions',table(['cell','model','raw RMS mean %','median %','worst %','gap RMS','Gamma p95 %','effective closure @0.3%'],patch)))
+    post=[]
+    for model in MODELS:
+        for p in (0,1):
+            allrows=[r for r in rows if r['model']==model and r['parent']==p]
+            q=[r for r in allrows if r['post_checks'].get('constructed') is True]
+            change=lambda key:fmt(statistics.fmean([r['post'][key]-r['raw'][key] for r in q if r['post'].get(key) is not None and r['raw'].get(key) is not None])) if any(r['post'].get(key) is not None and r['raw'].get(key) is not None for r in q) else 'NA'
+            post.append([model,f'P{p}',f'{len(q)}/{len(allrows)}',change('remainder_symmetric_RMS_bbox_pct'),change('Gamma_surface_RMS_bbox_pct'),change('Gamma_surface_p95_bbox_pct'),change('CF_illegal_pair_count'),change('FF_illegal_pair_count'),fmt(mean(q,'post','displacement_RMS')),fmt(mean(q,'post','displacement_max'))])
+    parts.append(('Stage 2 changes, constructed subset only',table(['model','parent','available/requested','RMS delta pp','Gamma RMS delta pp','Gamma p95 delta pp','CF delta','FF delta','mean displacement RMS','mean max displacement'],post)))
+    return parts
