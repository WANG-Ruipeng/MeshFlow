+        supplemental_forward_attempts=_counter(cc, 'supplemental_forward_attempts'),
+        supplemental_forward_returns=_counter(cc, 'supplemental_forward_returns'),
+        diagnostic_rollout_attempts=_counter(ds, 'rollout_attempts'),
+        diagnostic_rollouts=_counter(ds, 'complete_rollouts'),
+        formal_rollout_attempts=_counter(sc, 'rollout_attempts'), formal_rollouts=_counter(sc, 'complete_rollouts'),
+        replay_rollout_attempts=_counter(rc, 'rollout_attempts'), replays=replay_count,
+        optimizer_step_attempts=_counter(combined_train, 'optimizer_step_attempts'),
