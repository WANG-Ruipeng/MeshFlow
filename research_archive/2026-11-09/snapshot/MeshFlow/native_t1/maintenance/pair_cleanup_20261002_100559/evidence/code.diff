+"""Read-only JSON accounting; never imports a model, scorer or matcher.
+
+The controller explicitly calls collect_accounting. Importing this module does
+not read or write a run. Existing execution_counts.json is an output, never an
+input, so older partial totals cannot be counted twice.
+"""
+from collections import Counter
+from datetime import datetime, timezone
+from pathlib import Path
+import hashlib
+import json
+import time
+
+ARMS = ('P_Time', 'P_Conf')
+MODELS = ('B_Edge', 'B_JEdge5', 'P_Time', 'P_Conf')
+FILES = dict(protocol='registration/protocol.json', capture='stage_a/capture.json',
+             diagnosis='stage_a/diagnosis.json', window='stage_a/window.json',
+             calibration='stage_a/calibration.json', gt='gt_audit.json',
+             P_Time='P_Time/training.json', P_Conf='P_Conf/training.json',
+             sampling='formal/sampling.json', replays='formal/replays.json',
+             post='formal/postprocessing.json')
+
+
+def _integer(value, name):
+    if type(value) is not int or value < 0:
+        raise ValueError(name + ' must be an explicitly recorded nonnegative integer')
+    return value
+
+
+def _counter(record, key):
+    return _integer(record.get(key, 0), key)
+
+
+def _sum_ledger(ledgers):
+    answer = {}
+    for ledger in ledgers:
+        for key, value in ledger.items():
+            if type(value) is int:
+                answer[key] = answer.get(key, 0) + value
+    return answer
+
+
+def _matching_timing(rows):
+    totals = {}
+    for row in rows:
+        for key, value in row.get('matching_timing', {}).items():
+            if isinstance(value, (int, float)):
+                totals[key] = totals.get(key, 0.) + float(value)
+    return totals
+
+
+def _fixture_accounting(fixtures):
+    """Only explicit counters; the detailed pairing record duplicates cpu suite."""
+    rows = []
+    autograd = 0
+    tests = 0
+    ledgers = []
+    incomplete = []
+    for name, record in sorted(fixtures.items()):
+        if name == 'pairing_test_record.json':
+            rows.append(dict(source=name, counted=False, reason='Detailed evidence already included in cpu_test_record.json'))
+            continue
+        detail = record.get('counts', record.get('actual_work', {}))
+        aliases = ('CPU_autograd_calls', 'CPU_small_tensor_autograd_calls',
+                   'tiny_CPU_backwards', 'autograd_calls')
+        supplied = [(key, detail[key]) for key in aliases if key in detail]
+        if not supplied and 'autograd_calls' in record:
+            supplied = [('autograd_calls', record['autograd_calls'])]
+        if len(supplied) > 1:
+            raise ValueError('Ambiguous fixture autograd counters in ' + name)
+        value = _integer(supplied[0][1], name + '.autograd') if supplied else None
+        if value is None:
+            incomplete.append(dict(source=name, detail='No explicit fixture autograd counter; no zero or inferred total invented'))
+        else:
+            autograd += value
+        runs = record.get('tests_run')
+        if runs is not None:
+            tests += _integer(runs, name + '.tests_run')
+        ledger = record.get('combined_ledger', record.get('ledger', {}))
+        if ledger:
+            ledgers.append(ledger)
+        rows.append(dict(source=name, counted=True, status=record.get('status'),
+                         tests_run=runs, explicitly_recorded_autograd=value,
+                         counter_field=supplied[0][0] if supplied else None,
+                         recorded_detail=detail, recorded_groups=record.get('groups'), recorded_ledger=ledger,
+                         seconds=record.get('seconds')))
+    # These aliases are explicitly documented in the original combined suite.
+    cpu = fixtures.get('cpu_test_record.json', {}).get('counts', {})
+    return dict(test_executions=tests, explicit_CPU_fixture_autograd_calls=autograd,
+                explicit_autograd_total_complete=not incomplete, unavailable_counter_details=incomplete,
+                known_repeated_training_gate_case_executions=3 if 'initial_training_test_record.json' in fixtures and 'training_gate_test_record.json' in fixtures else 0,
+                unique_case_count='NOT_GLOBALLY_RECONCILED_DO_NOT_LABEL_EXECUTIONS_AS_UNIQUE_TESTS',
+                local_matching_attempts=cpu.get('local_fixture_matching_attempts'),
+                local_solver_calls=cpu.get('local_fixture_solver_calls'),
+                cloud_reference_matching_calls=cpu.get('cloud_reference_matching_calls'),
+                combined_geometry_ledger=_sum_ledger(ledgers), sources=rows,
+                metadata_path_correction=dict(record='cpu_test_record.json', group='capture_actual_endpoint_expressions',
+                    recorded='tests/test_capture.py', actual='test_capture.py', original_record_rewritten=False))
+
+
+def validate_budgets(totals, *, final=False):
+    """Scalar-only validation usable in fixtures, independent of run files."""
+    caps = dict(optimizer_updates=1000, optimizer_step_attempts=1000,
+                formal_rollout_attempts=160, formal_rollouts=160,
+                replay_rollout_attempts=2, replays=2,
+                teacher_forward_attempts=48, supplemental_forward_attempts=16,
+                diagnostic_rollout_attempts=4, diagnostic_rollouts=4)
+    errors = []
+    for key, cap in caps.items():
+        if _counter(totals, key) > cap:
+            errors.append(f'{key} exceeded {cap}')
+    if final:
+        required = dict(optimizer_updates=1000, optimizer_step_attempts=1000,
+                        formal_rollout_attempts=160, formal_rollouts=160,
+                        teacher_forward_attempts=48, teacher_forward_returns=48,
+                        supplemental_forward_attempts=16, supplemental_forward_returns=16,
+                        diagnostic_rollout_attempts=4, diagnostic_rollouts=4,
+                        model_backward_attempts=8000, model_backward_returns=8000,
+                        OT_calls=8012, OT_returns=8012,
+                        calibration_velocity_leaf_gradient_attempts=96,
+                        calibration_velocity_leaf_gradients=96)
+        for key, wanted in required.items():
+            if _counter(totals, key) != wanted:
+                errors.append(f'{key} is not completed contract value {wanted}')
+        replays = _counter(totals, 'replays')
+        if _counter(totals, 'replay_rollout_attempts') != replays:
+            errors.append('A replay attempt did not complete')
+        for key in ('model_forward_attempts', 'model_forward_returns'):
+            if _counter(totals, key) != 16264 + 50 * replays:
+                errors.append(key + ' differs from 264 + 8000 training + 8000 formal + 50 per replay')
+    return errors
+
+
