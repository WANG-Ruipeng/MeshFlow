+"""Detached, geometry-only general-graph partners and differentiable Pair loss.
+
+No GT IDs, target shape, parent identity, or bbox enters this module.  L_ref=1.
+C identities use numerical equality of FP32 endpoint coordinates (signed zeros
+compare equal), exactly the cloud coordinate convention at model precision.
+The complete allowed graph is solved by NetworkX minimum-weight matching; a
+non-perfect result is a failure, never a partial success.  This is not a
+certificate of an embedded, orientable, or manifold surface.  In particular,
+two duplicate triangles can have zero Pair loss and complete confidence.
+"""
+from __future__ import annotations
+
+import hashlib
+import time
+from collections import defaultdict
+
+import networkx as nx
+import numpy as np
+import torch
+
+EDGES = ((0, 1), (1, 2), (2, 0))
+L_REF = 1.0
+DENOMINATOR_EPS = 1e-12
+CONFIDENCE_RATIO = 0.5
+SPEC = {
+    "schema": "geometry_partner_pair_v1",
+    "L_ref": L_REF,
+    "matching_precision": "CPU_float64_from_detached_input_coordinates",
+    "known_identity": "FP32_numerical_exact_endpoint_equality_signed_zero_equal",
+    "solver": "NetworkX_complete_allowed_general_graph_min_weight_matching",
+    "cost": "minimum_direct_reverse_mean_endpoint_squared_Euclidean_distance",
+    "same_face_forbidden": True,
+    "unfixed_known_known_forbidden": True,
+    "endpoint_tie": "direct_first_record_ambiguity_no_extra_confidence_filter",
+    "solver_tie": "ascending_original_slot_node_and_edge_insertion_no_cost_perturbation",
+    "global_optimum_uniqueness": "NOT_CERTIFIED",
+    "confidence_ratio": CONFIDENCE_RATIO,
+    "confidence": "chosen_partners_mutual_first_and_both_first_second_ratios_le_0.5",
+    "loss_denominator": "all_solved_pair_detached_mean_lengths_before_confidence_filter",
+    "denominator_eps": DENOMINATOR_EPS,
+    "loss_precision": "input_float32_or_fixture_float64_autocast_disabled",
+}
+
+
+def _inc(ledger, name):
+    if ledger is not None:
+        ledger[name] = ledger.get(name, 0) + 1
+
+
+def _array(value):
+    if torch.is_tensor(value):
+        return value.detach().cpu().numpy().copy()
+    return np.asarray(value).copy()
+
+
+def _mask(value, n, name):
+    a = _array(value)
+    if a.shape != (n,) or a.dtype != np.bool_:
+        raise ValueError(name + " must be a boolean [F] mask")
+    return a
+
+
+def _base_result():
+    return {
+        "schema": SPEC["schema"], "status": "FAILED", "failure_code": None,
+        "pairs": np.empty((0, 2), dtype=np.int64),
+        "endpoint_flip": np.empty(0, dtype=bool),
+        "weights": np.empty(0, dtype=np.float64),
+        "fixed_C_pairs": np.empty((0, 2), dtype=np.int64),
+        "fixed_C_endpoint_flip": np.empty(0, dtype=bool),
+        "all_pairs": np.empty((0, 2), dtype=np.int64),
+        "all_endpoint_flip": np.empty(0, dtype=bool),
+        "confidence_mask": np.empty(0, dtype=bool),
+        "endpoint_ambiguity": np.empty(0, dtype=bool),
+        "full_denominator": 0.0, "confidence": {}, "counts": {},
+        "ambiguity": {"global_optimum_uniqueness": "NOT_CERTIFIED"},
+        "timing": {}, "spec": dict(SPEC), "networkx_version": nx.__version__,
+    }
+
+
+def match_partners(triangles, known_mask, valid_mask=None, *, ledger=None):
+    """Return a structured CPU selection; edge IDs retain original face slots.
+
+    ``pairs`` excludes fixed C/C pairs; ``all_pairs`` includes them and has its
+    own aligned ``all_endpoint_flip``. Arrays are detached CPU NumPy arrays.
+    ``known_coordinates`` has shape [F,3,3], stores C only, and is zero elsewhere.
+    Invalid padding is ignored, including nonfinite padding coordinates.
+    Failure carries a code and timings, and must not be passed off as zero loss.
+    """
+    _inc(ledger, "matching_attempts")
+    result = _base_result()
+    started = time.perf_counter()
+
+    def finish(code=None, detail=None):
+        result["status"] = "PASS" if code is None else "FAILED"
+        result["failure_code"] = code
+        if detail is not None:
+            result["failure_detail"] = str(detail)
+        result["timing"]["total_seconds"] = time.perf_counter() - started
+        _inc(ledger, "matching_returns")
+        if code is not None:
+            _inc(ledger, "matching_failures")
+        return result
+
+    tick = time.perf_counter()
+    try:
+        raw = _array(triangles)
+        if raw.ndim != 3 or raw.shape[1:] != (3, 3) or raw.dtype not in (np.float32, np.float64):
+            raise ValueError("triangles must be float32/float64 [F,3,3]")
+        n = len(raw)
+        known = _mask(known_mask, n, "known_mask")
+        valid = np.ones(n, dtype=bool) if valid_mask is None else _mask(valid_mask, n, "valid_mask")
+        if np.any(known & ~valid):
+            raise ValueError("known_mask must be a subset of valid_mask")
+        x = raw.astype(np.float64)
+    except (ValueError, TypeError, RuntimeError) as exc:
+        result["timing"]["device_transfer_seconds"] = time.perf_counter() - tick
+        return finish("INVALID_INPUT", exc)
+    result["timing"]["device_transfer_seconds"] = time.perf_counter() - tick
+    result.update(known_mask=known, valid_mask=valid, input_dtype=str(raw.dtype),
+                  known_coordinates=np.where(known[:, None, None], raw, np.zeros_like(raw)))
+    if not np.isfinite(x[valid]).all():
+        return finish("NONFINITE_VALID_GEOMETRY")
+    if not np.any(valid):
+        return finish("NO_VALID_FACES")
+
+    tick = time.perf_counter()
+    h_total = 3*n
+    edges = x[:, EDGES, :].reshape(h_total, 2, 3)
+    face = np.repeat(np.arange(n), 3)
+    is_known = np.repeat(known, 3)
+    valid_h = np.flatnonzero(np.repeat(valid, 3))
+    result["edge_endpoints"] = np.where(np.repeat(valid, 3)[:, None, None], edges, 0.0)
+    result["edge_face_ids"] = face.copy()
+    result["edge_corner_ids"] = np.tile(np.asarray(EDGES, dtype=np.int64), (n, 1))
+    lengths = np.zeros(h_total, dtype=np.float64)
+    lengths[valid_h] = np.linalg.norm(edges[valid_h, 1]-edges[valid_h, 0], axis=1)
+    # Duplicate/degenerate predictions remain present; these are diagnostics.
+    duplicate = defaultdict(list)
+    for f in np.flatnonzero(valid):
+        duplicate[tuple(sorted(tuple(float(v) for v in p) for p in x[f]))].append(int(f))
+    dup_groups = [ids for ids in duplicate.values() if len(ids) > 1]
+    crosses = np.cross(x[valid, 1]-x[valid, 0], x[valid, 2]-x[valid, 0])
+    counts = dict(valid_faces=int(valid.sum()), known_faces=int(known.sum()),
+                  free_faces=int((valid & ~known).sum()), valid_halfedges=len(valid_h),
+                  zero_length_edges=int(np.count_nonzero(lengths[valid_h] == 0)),
+                  exact_degenerate_faces=int(np.count_nonzero(np.linalg.norm(crosses, axis=1) == 0)),
+                  duplicate_face_groups=len(dup_groups), duplicate_extra_faces=sum(len(z)-1 for z in dup_groups))
+    result["counts"] = counts
+    result["duplicate_face_groups"] = dup_groups
+    result["input_geometry_sha256"] = hashlib.sha256(
+        np.ascontiguousarray(raw[valid]).tobytes()+known.tobytes()+valid.tobytes()).hexdigest()
+    seen = defaultdict(list)
+    c_edges32 = edges.astype(np.float32)
+    if not np.isfinite(c_edges32[is_known]).all():
+        return finish("NONFINITE_FP32_KNOWN_GEOMETRY")
+    for h in np.flatnonzero(is_known):
+        key = tuple(sorted(tuple(float(v) for v in p) for p in c_edges32[h]))
+        seen[key].append(int(h))
+    nonmanifold = [hs for hs in seen.values() if len(hs) > 2]
+    result["C_internal_nonmanifold_groups"] = nonmanifold
+    counts["C_internal_nonmanifold_edge_groups"] = len(nonmanifold)
+    if nonmanifold:
+        return finish("NONMANIFOLD_KNOWN_EDGE_INCIDENCE")
+    fixed = sorted(tuple(hs) for hs in seen.values() if len(hs) == 2)
+    if any(face[i] == face[j] for i, j in fixed):
+        return finish("SAME_FACE_FIXED_KNOWN_EDGE")
+    used = {h for pair in fixed for h in pair}
+    rem = np.array([h for h in valid_h if h not in used], dtype=np.int64)
+    result["remaining_edge_ids"] = rem
+    result["fixed_C_pairs"] = np.asarray(fixed, dtype=np.int64).reshape(-1, 2)
+    counts.update(fixed_C_pairs=len(fixed), remaining_halfedges=len(rem))
+    result["timing"]["preparation_seconds"] = time.perf_counter() - tick
+    if len(rem) == 0:
+        return finish("NO_DYNAMIC_PAIRS")
+    if len(rem) % 2:
+        return finish("ODD_REMAINING_HALFEDGE_COUNT")
+
+    # Only valid slots participate in any numeric cost; poisoned padding is never used.
+    tick = time.perf_counter()
+    e = edges[valid_h]
+    direct = ((e[:, None]-e[None, :])**2).sum(-1).mean(-1)
+    reverse = ((e[:, None]-e[None, :, ::-1])**2).sum(-1).mean(-1)
+    cost = np.minimum(direct, reverse)
+    local = {int(h): i for i, h in enumerate(valid_h)}
+    result["timing"]["cost_matrix_seconds"] = time.perf_counter() - tick
+    if not np.isfinite(cost).all():
+        return finish("NONFINITE_MATCHING_COST")
+    tick = time.perf_counter()
+    graph = nx.Graph()
+    graph.add_nodes_from(int(h) for h in rem)
+    allowed = np.zeros((len(rem), len(rem)), dtype=bool)
+    candidates = np.full(allowed.shape, np.inf, dtype=np.float64)
+    for a, i in enumerate(rem):
+        for b in range(a+1, len(rem)):
+            j = rem[b]
+            if face[i] == face[j] or (is_known[i] and is_known[j]):
+                continue
+            value = float(cost[local[int(i)], local[int(j)]])
+            graph.add_edge(int(i), int(j), weight=value)
+            allowed[a, b] = allowed[b, a] = True
+            candidates[a, b] = candidates[b, a] = value
+    counts["edges_in_graph"] = graph.number_of_edges()
+    result["timing"]["graph_construction_seconds"] = time.perf_counter() - tick
+    tick = time.perf_counter()
+    _inc(ledger, "matching_solver_attempts")
+    try:
+        chosen = nx.min_weight_matching(graph)
+    except Exception as exc:
+        result["timing"]["cpu_solver_seconds"] = time.perf_counter() - tick
+        return finish("MATCHING_SOLVER_ERROR", exc)
+    _inc(ledger, "matching_solver_returns")
+    result["timing"]["cpu_solver_seconds"] = time.perf_counter() - tick
+    counts["solved_pairs"] = len(chosen)
+    if len(chosen)*2 != len(rem):
+        return finish("NO_FULL_FEASIBLE_MATCHING")
+    pairs = np.array(sorted(tuple(sorted(p)) for p in chosen), dtype=np.int64).reshape(-1, 2)
+    all_pairs = np.array(sorted(fixed+[tuple(p) for p in pairs]), dtype=np.int64).reshape(-1, 2)
+
+    def orientations(ps):
+        a = np.array([local[int(i)] for i in ps[:, 0]], dtype=int)
+        b = np.array([local[int(i)] for i in ps[:, 1]], dtype=int)
+        return reverse[a, b] < direct[a, b], reverse[a, b] == direct[a, b]
+
+    flips, endpoint_ties = orientations(pairs)
+    all_flips, all_ties = orientations(all_pairs)
+    fixed_flips, _ = orientations(result["fixed_C_pairs"])
+    weights = (lengths[pairs[:, 0]]+lengths[pairs[:, 1]])*0.5
+    denominator = float(weights.sum())
+    result.update(pairs=pairs, all_pairs=all_pairs, endpoint_flip=flips,
+                  all_endpoint_flip=all_flips, fixed_C_endpoint_flip=fixed_flips,
+                  endpoint_ambiguity=endpoint_ties, all_endpoint_ambiguity=all_ties,
+                  weights=weights, full_denominator=denominator,
+                  unweighted_matching_cost=float(sum(graph[i][j]["weight"] for i, j in pairs)))
+    counts.update(zero_weight_pairs=int(np.count_nonzero(weights == 0)),
+                  known_free_pairs=int(np.count_nonzero(is_known[pairs[:, 0]] | is_known[pairs[:, 1]])),
+                  free_free_pairs=int(np.count_nonzero(~is_known[pairs[:, 0]] & ~is_known[pairs[:, 1]])))
+    if not np.isfinite(denominator) or denominator <= 0:
+        return finish("ALL_ZERO_OR_NONFINITE_PAIR_WEIGHT")
+
+    tick = time.perf_counter()
+    order = np.argsort(candidates, axis=1, kind="stable")
+    first = candidates[np.arange(len(rem)), order[:, 0]]
+    second = candidates[np.arange(len(rem)), order[:, 1]]
+    candidate_counts = allowed.sum(axis=1)
+    first_tie = np.isfinite(first) & (first == second)
+    valid_ratio = (candidate_counts >= 2) & np.isfinite(first) & np.isfinite(second) & (second > 0)
+    adequate = valid_ratio & ~first_tie
+    ratios = np.full(len(rem), np.inf, dtype=np.float64)
+    ratios[valid_ratio] = first[valid_ratio]/second[valid_ratio]
+    best = np.where(np.isfinite(first), rem[order[:, 0]], -1)
+    second_best = np.where(np.isfinite(second), rem[order[:, 1]], -1)
+    ridx = {int(h): i for i, h in enumerate(rem)}
+    accepted = np.array([best[ridx[i]] == j and best[ridx[j]] == i
+                         and ratios[ridx[i]] <= CONFIDENCE_RATIO and ratios[ridx[j]] <= CONFIDENCE_RATIO
+                         for i, j in pairs], dtype=bool)
+    accepted_ids = set(int(h) for h in pairs[accepted].reshape(-1))
+    rejected_ids = np.array([h for h in rem if int(h) not in accepted_ids], dtype=np.int64)
+    counts.update(accepted_pairs=int(accepted.sum()), rejected_pairs=int((~accepted).sum()),
+                  accepted_halfedges=2*int(accepted.sum()), rejected_halfedges=len(rejected_ids))
+    result["confidence_mask"] = accepted
+    result["confidence"] = dict(edge_ids=rem.copy(), best=best, second_best=second_best,
+                                 first_cost=first, second_cost=second, ratio=ratios,
+                                 candidate_count=candidate_counts, ambiguous=~adequate,
+                                 rejected_edge_ids=rejected_ids,
+                                 accepted_pair_fraction=float(accepted.mean()),
+                                 accepted_edge_count_fraction=float(2*accepted.sum()/len(rem)),
+                                 accepted_weight=float(weights[accepted].sum()),
+                                 accepted_length_fraction=float(weights[accepted].sum()/denominator),
+                                 rejected_edge_length=float(lengths[rejected_ids].sum()),
+                                 all_remaining_edge_length=float(lengths[rem].sum()))
+    result["ambiguity"].update(endpoint_tied_pairs=int(endpoint_ties.sum()),
+                               accepted_endpoint_tied_pairs=int(np.count_nonzero(endpoint_ties & accepted)),
+                               first_candidate_tied_edges=int(first_tie.sum()),
+                               insufficient_candidates=int(np.count_nonzero(candidate_counts < 2)),
+                               zero_second_cost_edges=int(np.count_nonzero(second == 0)),
+                               confidence_ambiguous_edges=int(np.count_nonzero(~adequate)))
+    result["timing"]["confidence_seconds"] = time.perf_counter() - tick
+    return finish()
+
+
+def pair_loss(triangles, matching, *, confidence=False, ledger=None):
+    """Frozen partners/weights, free-coordinate gradient, and immutable C.
+
+    Rejected confidence pairs contribute zero without changing the complete-P
+    denominator. Failure/zero total weight raises, rather than becoming zero.
+    An empty accepted subset returns a graph-connected zero on valid free slots.
+    """
+    _inc(ledger, "pair_loss_attempts")
+    if matching.get("status") != "PASS":
+        raise ValueError("Pair selection failed: "+str(matching.get("failure_code")))
+    if not torch.is_tensor(triangles) or triangles.dtype not in (torch.float32, torch.float64):
+        raise TypeError("triangles must be an FP32/FP64 tensor")
+    if tuple(triangles.shape) != tuple(matching["known_coordinates"].shape):
+        raise ValueError("Pair loss shape differs from selected geometry")
+    if not np.isfinite(matching["full_denominator"]) or matching["full_denominator"] <= 0:
+        raise ValueError("Pair total weight must be finite and positive")
+    device, dtype = triangles.device, triangles.dtype
+    with torch.autocast(device_type=device.type, enabled=False):
+        known = torch.as_tensor(matching["known_mask"], dtype=torch.bool, device=device)
+        valid = torch.as_tensor(matching["valid_mask"], dtype=torch.bool, device=device)
+        anchors = torch.as_tensor(matching["known_coordinates"], dtype=dtype, device=device).detach()
+        x = torch.where(known[:, None, None], anchors, triangles)
+        pairs = torch.as_tensor(matching["pairs"], dtype=torch.long, device=device)
+        flip = torch.as_tensor(matching["endpoint_flip"], dtype=torch.bool, device=device)
+        w = torch.as_tensor(matching["weights"], dtype=dtype, device=device).detach()
+        mask_np = matching["confidence_mask"] if confidence else np.ones(len(w), dtype=bool)
+        keep = torch.as_tensor(mask_np, dtype=torch.bool, device=device)
+        denominator = w.sum().clamp_min(DENOMINATOR_EPS)
+        if not np.any(mask_np):
+            loss = triangles[valid & ~known].sum()*0.0
+        else:
+            edges = x[:, EDGES, :].reshape(-1, 2, 3)
+            a, b = edges[pairs[:, 0]], edges[pairs[:, 1]]
+            b = torch.where(flip[:, None, None], b.flip(1), b)
+            distance = (a-b).square().sum(-1).mean(-1)/(L_REF*L_REF)
+            loss = (distance*w*keep.to(dtype)).sum()/denominator
+    _inc(ledger, "pair_loss_returns")
+    return dict(loss=loss, applicable=bool(np.any(mask_np)),
+                denominator=denominator.detach(),
+                counts=dict(full_pairs=len(matching["pairs"]), active_pairs=int(np.count_nonzero(mask_np)),
+                            fixed_C_pairs_excluded=len(matching["fixed_C_pairs"]),
+                            rejected_pairs=int(len(mask_np)-np.count_nonzero(mask_np))),
+                confidence=bool(confidence), full_denominator=matching["full_denominator"])
