+"""CPU-only independent partner scoring and preregistered time-window gate.
+
+GT source IDs are read only here, after geometry matching. Neither matching nor
+loss, model inference, OT, gradients or geometry repair is called by this file.
+"""
+from __future__ import annotations
+import math
+import numpy as np
+
+TIMES=(.5,.7,.84,.94)
+CANDIDATE_LOWER_BOUNDS=(.5,.7,.84)
+SPEC=dict(schema='gp_partner_diagnostic_metrics_v1',precision_threshold=.98,
+          halfedge_coverage_threshold=.2,aggregation='Sum correct and accepted pairs / sum counts within each parent,time cell; six states (three K, two noises). No state-wise averaging.',
+          gap='Unweighted Euclidean distances of both aligned endpoints of each selected pair; model coordinate units, L_ref=1. No GT bbox normalization.',
+          coverage='Fixed C/C pairs excluded. Category coverage uses that category in the same full dynamic matching as denominator.',
+          GT_scope='Independent source identity and endpoint correspondence scoring only; never supplied to matcher or model.')
+
+
+def _failure(matching,reason):
+    return dict(schema=SPEC['schema'],status='FAILED',finite=False,
+                matching_status=matching.get('status'),failure_code=reason,
+                full=None,confident=None,GT_precision='NOT_AVAILABLE',
+                fixed_C_pairs_excluded=len(matching.get('fixed_C_pairs',[])),spec=SPEC)
+
+
+def score_pairs(matching,source_vertex_ids=None):
+    """Score original-slot dynamic halfedge pairs without recomputing partners.
+
+    Returns full/confident dictionaries, each containing all/FF/CF summaries.
+    ``correct_pair_count`` requires both partner identity AND chosen endpoint
+    correspondence. Empty accepted subsets have precision None, not one.
+    """
+    if matching.get('status')!='PASS':
+        return _failure(matching,matching.get('failure_code','MATCHING_FAILED'))
+    pairs=np.asarray(matching['pairs'],dtype=np.int64)
+    flips=np.asarray(matching['endpoint_flip'],dtype=bool)
+    weights=np.asarray(matching['weights'],dtype=np.float64)
+    accepted=np.asarray(matching['confidence_mask'],dtype=bool)
+    endpoints=np.asarray(matching['edge_endpoints'],dtype=np.float64)
+    face=np.asarray(matching['edge_face_ids'],dtype=np.int64)
+    corners=np.asarray(matching['edge_corner_ids'],dtype=np.int64)
+    known=np.asarray(matching['known_mask'],dtype=bool)
+    valid=np.asarray(matching['valid_mask'],dtype=bool)
+    remaining=np.asarray(matching['remaining_edge_ids'],dtype=np.int64)
+    n=len(known); m=len(pairs)
+    if (pairs.shape!=(m,2) or flips.shape!=(m,) or weights.shape!=(m,) or accepted.shape!=(m,)
+            or endpoints.shape!=(3*n,2,3) or face.shape!=(3*n,) or corners.shape!=(3*n,2)
+            or valid.shape!=(n,) or len(remaining)!=2*m):
+        raise ValueError('Matching score schema or complete-pair count differs')
+    if (np.any(pairs<0) or np.any(pairs>=3*n) or len(np.unique(pairs))!=2*m
+            or set(pairs.reshape(-1).tolist())!=set(remaining.tolist())
+            or np.any(~valid[face[pairs]]) or np.any(face[pairs[:,0]]==face[pairs[:,1]])
+            or np.any(known[face[pairs[:,0]]]&known[face[pairs[:,1]]])):
+        return _failure(matching,'INVALID_COMPLETE_MATCHING_FOR_SCORING')
+    if not np.isfinite(endpoints[remaining]).all() or not np.isfinite(weights).all() or np.any(weights<0) or not weights.sum()>0:
+        return _failure(matching,'NONFINITE_OR_INVALID_SCORED_GEOMETRY')
+    a=endpoints[pairs[:,0]];b=endpoints[pairs[:,1]].copy();b[flips]=b[flips,::-1]
+    squared=np.sum((a-b)**2,axis=2)
+    if not np.isfinite(squared).all():return _failure(matching,'NONFINITE_ENDPOINT_GAPS')
+    gap=np.sqrt(squared)
+    edge_lengths=np.linalg.norm(endpoints[:,1]-endpoints[:,0],axis=1)
+    observed_weights=edge_lengths[pairs].mean(axis=1)
+    if not np.allclose(weights,observed_weights,rtol=1e-12,atol=1e-14):
+        raise ValueError('Declared pair weights differ from frozen mean edge lengths')
+    has_gt=source_vertex_ids is not None
+    partner_correct=correct=None
+    if has_gt:
+        ids=np.asarray(source_vertex_ids)
+        if ids.shape!=(n,3) or ids.dtype.kind not in 'iu' or np.any(ids[valid]<0):
+            raise ValueError('GT scorer requires integer source vertex IDs in actual original slots')
+        edge_ids=ids[face[:,None],corners]
+        ia=edge_ids[pairs[:,0]];ib=edge_ids[pairs[:,1]].copy()
+        partner_correct=(np.sort(ia,axis=1)==np.sort(ib,axis=1)).all(axis=1)
+        ib[flips]=ib[flips,::-1]
+        correct=partner_correct & (ia==ib).all(axis=1)
+    is_CF=known[face[pairs[:,0]]] | known[face[pairs[:,1]]]
+    categories={'all':np.ones(m,dtype=bool),'FF':~is_CF,'CF':is_CF}
+    def group(mask,category):
+        selected=mask & category; count=int(selected.sum());denom=int(category.sum())
+        length=float(2*weights[selected].sum());total_length=float(2*weights[category].sum())
+        distances=gap[selected].reshape(-1)
+        return dict(pair_count=count,halfedge_count=2*count,full_pair_denominator=denom,
+                    full_halfedge_denominator=2*denom,halfedge_coverage=count/denom if denom else None,
+                    covered_edge_length=length,full_edge_length=total_length,
+                    edge_length_coverage=length/total_length if total_length>0 else None,
+                    rejected_pair_count=denom-count,rejected_halfedge_count=2*(denom-count),
+                    rejected_edge_length=total_length-length,
+                    correct_pair_count=int(correct[selected].sum()) if has_gt else None,
+                    partner_identity_correct_pair_count=int(partner_correct[selected].sum()) if has_gt else None,
+                    wrong_endpoint_given_correct_partner_count=int((partner_correct & ~correct & selected).sum()) if has_gt else None,
+                    precision=(float(correct[selected].mean()) if count else None) if has_gt else 'NOT_AVAILABLE',
+                    precision_status=('AVAILABLE' if count else 'NO_SELECTED_PAIRS') if has_gt else 'NOT_AVAILABLE',
+                    gap=dict(endpoint_count=2*count,sum_squared_distances=float(squared[selected].sum()),
+                             RMS=float(np.sqrt(squared[selected].mean())) if count else None,
+                             p95=float(np.percentile(distances,95)) if count else None,
+                             max=float(distances.max()) if count else None))
+    full={key:group(np.ones(m,dtype=bool),mask) for key,mask in categories.items()}
+    confident={key:group(accepted,mask) for key,mask in categories.items()}
+    details=[]
+    for i,(h,k) in enumerate(pairs):
+        item=dict(halfedge_ids=[int(h),int(k)],face_ids=[int(face[h]),int(face[k])],
+                  corner_ids=[corners[h].tolist(),corners[k].tolist()],category='CF' if is_CF[i] else 'FF',
+                  endpoint_flip=bool(flips[i]),confidence_accepted=bool(accepted[i]),weight=float(weights[i]),
+                  endpoint_distances=gap[i].tolist(),partner_correct=bool(partner_correct[i]) if has_gt else None,
+                  partner_and_endpoints_correct=bool(correct[i]) if has_gt else None)
+        if has_gt:item['source_endpoint_ids']=[edge_ids[h].tolist(),edge_ids[k].tolist()]
+        details.append(item)
+    return dict(schema=SPEC['schema'],status='PASS',finite=True,matching_status='PASS',failure_code=None,
+                GT_precision='AVAILABLE' if has_gt else 'NOT_AVAILABLE',remaining_halfedge_count=len(remaining),
+                fixed_C_pairs_excluded=len(matching.get('fixed_C_pairs',[])),full=full,confident=confident,
+                pair_details=details,spec=SPEC)
+
+
+def select_window(rows):
+    """Select earliest registered bound with all later parent/time cells passing.
+
+    Each row uses parent,t,metrics (metric alias supported), optional geometry
+    which must be Yhat, and preferably K/noise_index for exact Cartesian checks.
+    Missing, failed and nonfinite states never disappear from the gate.
+    """
+    rows=list(rows);cells={(p,t):[] for p in (0,1) for t in TIMES}
+    for row in rows:
+        if row.get('geometry','Yhat') not in ('Yhat','yhat'):
+            raise ValueError('Time-window selection only consumes predicted endpoint teacher rows')
+        parent=int(row.get('parent',row.get('parent_index',-1)))
+        t=float(row['t']);hits=[q for q in TIMES if abs(q-t)<1e-6]
+        if parent not in (0,1) or len(hits)!=1:raise ValueError('Unexpected parent or teacher time')
+        cells[parent,hits[0]].append(row)
+    noise_sets=[set(row['noise_index'] for row in group) for group in cells.values() if group and all('noise_index' in row for row in group)]
+    common_noises=noise_sets[0] if noise_sets else None
+    consistent_noises=all(x==common_noises for x in noise_sets) and (common_noises is None or len(common_noises)==2)
+    summaries=[]
+    for (parent,t),group in cells.items():
+        reasons=[]
+        if len(group)!=6:reasons.append('EXPECTED_SIX_STATES')
+        typed=all('K' in row and 'noise_index' in row for row in group)
+        if group and typed:
+            ids=[(int(row['K']),row['noise_index']) for row in group]
+            expected={(K,n) for K in (4,8,12) for n in (common_noises or ())}
+            if len(set(ids))!=6 or set(ids)!=expected or not consistent_noises:reasons.append('K_NOISE_CARTESIAN_IDENTITY_FAILED')
+        elif group and any('K' in row or 'noise_index' in row for row in group):
+            reasons.append('PARTIAL_K_NOISE_METADATA')
+        accepted=correct=remaining=0;full_correct=full_pairs=0;accepted_length=full_length=0.
+        for row in group:
+            metric=row.get('metrics',row.get('metric'))
+            if not isinstance(metric,dict) or metric.get('status')!='PASS' or metric.get('finite') is not True:
+                reasons.append('FAILED_OR_NONFINITE_MATCHING_STATE');continue
+            if metric.get('GT_precision')!='AVAILABLE':
+                reasons.append('GT_PRECISION_NOT_AVAILABLE');continue
+            a=metric['confident']['all'];f=metric['full']['all']
+            values=(a['pair_count'],a['correct_pair_count'],f['halfedge_count'],f['correct_pair_count'],f['pair_count'],a['covered_edge_length'],f['covered_edge_length'])
+            if any(v is None or not math.isfinite(float(v)) for v in values):
+                reasons.append('NONFINITE_OR_MISSING_METRIC_COUNTS');continue
+            accepted+=a['pair_count'];correct+=a['correct_pair_count'];remaining+=f['halfedge_count']
+            full_correct+=f['correct_pair_count'];full_pairs+=f['pair_count']
+            accepted_length+=a['covered_edge_length'];full_length+=f['covered_edge_length']
+        precision=correct/accepted if accepted else None
+        coverage=2*accepted/remaining if remaining else None
+        # Integer comparisons avoid threshold rounding at exactly 98% or 20%.
+        if not accepted or 100*correct < 98*accepted:reasons.append('CONFIDENT_PRECISION_BELOW_98_PERCENT')
+        if not remaining or 10*accepted < remaining:reasons.append('CONFIDENT_HALFEDGE_COVERAGE_BELOW_20_PERCENT')
+        summaries.append(dict(parent=parent,t=t,state_count=len(group),state_identity_checked=typed,
+            status='PASS' if not reasons else 'FAIL',failure_reasons=sorted(set(reasons)),
+            accepted_correct_pairs=correct,accepted_pairs=accepted,remaining_halfedges=remaining,
+            accepted_halfedges=2*accepted,precision=precision,halfedge_coverage=coverage,
+            accepted_edge_length=accepted_length,remaining_edge_length=full_length,
+            edge_length_coverage=accepted_length/full_length if full_length else None,
+            full_correct_pairs=full_correct,full_pairs=full_pairs,full_precision=full_correct/full_pairs if full_pairs else None))
+    grid_ok=len(rows)==48 and all(len(group)==6 for group in cells.values()) and consistent_noises
+    metadata_failures={'K_NOISE_CARTESIAN_IDENTITY_FAILED','PARTIAL_K_NOISE_METADATA'}
+    grid_ok=grid_ok and not any(metadata_failures.intersection(x['failure_reasons']) for x in summaries)
+    candidates=[];selected=None
+    for lower in CANDIDATE_LOWER_BOUNDS:
+        considered=[x for x in summaries if x['t']>=lower]
+        passed=grid_ok and all(x['status']=='PASS' for x in considered)
+        candidates.append(dict(t0=lower,status='PASS' if passed else 'FAIL',protocol_grid_complete=grid_ok,
+            failing_cells=[dict(parent=x['parent'],t=x['t'],reasons=x['failure_reasons']) for x in considered if x['status']!='PASS']))
+        if passed and selected is None:selected=lower
+    return dict(schema='gp_time_window_selection_v1',status='PASS_WINDOW_FOUND' if selected is not None else 'STOP_NO_ADMISSIBLE_WINDOW',
+                selected_t0=selected,formal_training_allowed=selected is not None,teacher_rows=len(rows),protocol_grid_complete=grid_ok,
