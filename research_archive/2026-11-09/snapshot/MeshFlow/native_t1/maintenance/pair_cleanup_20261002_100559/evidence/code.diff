+            completed_updates=500, base_cumulative_updates=2500, cumulative_updates=3000,
+            input_sha256=T.INPUT_SHA, initial_checkpoint_sha256=T.G0_FILE_SHA,
+            initial_state_sha256=T.G0_STATE_SHA, stream_start_sha256=T.STREAM_START_SHA,
+            stream_reference_sha256=T.STREAM_LOG_SHA, optimizer_step_in_progress=False,
+            batch_in_progress=False, fresh_optimizer=True, stream_state=stream,
+            stream_state_sha256=T.seal(stream), pair_indices_sha256=T.seal(indices),
+            config_sha256='a'*64, model_state_sha256='b'*64,
