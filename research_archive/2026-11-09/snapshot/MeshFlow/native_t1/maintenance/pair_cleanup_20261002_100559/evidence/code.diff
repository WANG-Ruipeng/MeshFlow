+"""Read-only complete-GT compatibility audit; no model, OT, loss or repair.
+
+Source identity and exact-coordinate diagnostic indexing remain separate.
+The existing primary/independent floating intersection predicates are reused,
+but no historical experiment entry point or geometry optimizer is executed.
+"""
+from __future__ import annotations
+from collections import Counter, defaultdict
+import hashlib
+import json
+from pathlib import Path
+import time
+import numpy as np
+from ..t1_native_confirmation_topology import audit_mesh
+
+ROOT = Path(__file__).resolve().parents[3]
+INPUT = ROOT / 'output/t1_publish_20260930/chair_n112.npz'
+INPUT_SHA = '7059671d55f2f3be8777d13e02a62255d8a0c0c7c1c1c5b4f3b24357091ba6fc'
+
+
+def sha(path):
+    h = hashlib.sha256()
+    with Path(path).open('rb') as f:
+        for block in iter(lambda: f.read(1024 * 1024), b''):
+            h.update(block)
+    return h.hexdigest()
+
+
+def exact_coordinate_index(triangles):
+    """Numeric FP32 equality, no tolerance; diagnostic only, no input mutation."""
+    triangles = np.asarray(triangles)
+    if triangles.dtype != np.float32 or triangles.shape[1:] != (3, 3) or not np.isfinite(triangles).all():
+        raise ValueError('Need unchanged finite FP32 triangles')
+    mapping, vertices, indices = {}, [], []
+    for point in triangles.reshape(-1, 3):
+        key = tuple(float(x) for x in point)
+        if key not in mapping:
+            mapping[key] = len(vertices); vertices.append(point.copy())
+        indices.append(mapping[key])
+    V = np.asarray(vertices, dtype=np.float32); F = np.asarray(indices, dtype=np.int64).reshape(-1, 3)
+    if not np.array_equal(V[F], triangles):
+        raise AssertionError('Indexing altered numeric coordinates')
+    return V, F
+
+
+def _integer_coordinates(vertices):
+    ratios = [[float(x).as_integer_ratio() for x in row] for row in vertices]
+    denominator = max(q for row in ratios for _, q in row)
+    return [[p * (denominator // q) for p, q in row] for row in ratios]
+
+
+def t_junctions(vertices, faces, length):
+    """Exact dyadic confirmation after a documented broad candidate filter.
+
+    Only vertices strictly inside a nonincident finite source edge qualify.
+    Endpoint coincidences and merely close vertices are not T-junctions.
+    """
+    V = np.asarray(vertices, dtype=np.float64); F = np.asarray(faces, dtype=np.int64)
+    edges = defaultdict(list)
+    for face, ids in enumerate(F):
+        for a, b in ((0, 1), (1, 2), (2, 0)):
+            edges[tuple(sorted((int(ids[a]), int(ids[b]))))].append(face)
+    integer = _integer_coordinates(V); rows = []; near_only = []; comparisons = 0; candidates = 0
+    for (a, b), incident in sorted(edges.items()):
+        start, delta = V[a], V[b] - V[a]; square = float(delta @ delta)
+        if square == 0:
+            continue
+        u = ((V - start) @ delta) / square
+        distance = np.linalg.norm(V - start - u[:, None] * delta, axis=1)
+        comparisons += len(V) - 2
+        for v in np.flatnonzero((u > 0) & (u < 1) & (distance <= 1e-9 * length)):
+            if v in (a, b): continue
+            candidates += 1
+            d = [integer[b][k] - integer[a][k] for k in range(3)]
+            q = [integer[v][k] - integer[a][k] for k in range(3)]
+            cross = [q[1]*d[2]-q[2]*d[1], q[2]*d[0]-q[0]*d[2], q[0]*d[1]-q[1]*d[0]]
+            dot = sum(x*y for x, y in zip(q, d)); d2 = sum(x*x for x in d)
+            exact = all(x == 0 for x in cross) and 0 < dot < d2
+            record = dict(vertex_id=int(v), edge_vertex_ids=[a, b], edge_face_ids=list(incident),
+                          vertex_face_ids=np.flatnonzero((F == v).any(axis=1)).tolist(),
+                          distance=float(distance[v]), segment_parameter=float(u[v]), exact_dyadic_collinearity=exact)
+            (rows if exact else near_only).append(record)
+    return dict(exact_T_junction_count=len(rows), exact_T_junctions=rows,
+                near_candidate_not_exact_count=len(near_only), near_candidates_not_exact=near_only,
+                vertex_nonincident_edge_comparisons=comparisons, exact_candidate_checks=candidates,
+                candidate_tolerance_bbox=1e-9, confirmation='Exact integer arithmetic on represented FP32 dyadic coordinates; 0<projection<edge_length_squared',
+                endpoint_contacts_are_not_T_junctions=True)
+
+
+def indexed_diagnostics(vertices, faces, length):
+    result = audit_mesh(vertices, faces)
+    triangles = np.asarray(vertices, dtype=np.float64)[np.asarray(faces, dtype=np.int64)]
