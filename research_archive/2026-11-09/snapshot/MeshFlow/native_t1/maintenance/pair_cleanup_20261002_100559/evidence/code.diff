+"""Offline Stage A diagnosis. GT labels enter scoring only, never matching."""
+import argparse
+import json
+import time
+from pathlib import Path
+import numpy as np
+from native_t1.artifacts import atomic_json
+from .pairing import match_partners
+from .closure import construct_candidate
+from .diagnostic_metrics import score_pairs, select_window
+
+
+def json_safe(value):
+    if isinstance(value,np.ndarray):return json_safe(value.tolist())
+    if isinstance(value,np.generic):return json_safe(value.item())
+    if isinstance(value,float) and not np.isfinite(value):return None
+    if isinstance(value,dict):return {str(k):json_safe(v) for k,v in value.items()}
+    if isinstance(value,(list,tuple)):return [json_safe(v) for v in value]
+    return value
+
+
+def save_matching(path,matching):
+    arrays={key:value for key,value in matching.items() if isinstance(value,np.ndarray)}
+    metadata={key:value for key,value in matching.items() if key not in arrays}
+    # Nonfinite first/second ratios are undefined diagnostics; ambiguity flags
+    # retain the reason. Differentiable-loss input arrays remain exact NPZ data.
+    arrays['metadata_json']=np.asarray(json.dumps(json_safe(metadata),allow_nan=False))
+    np.savez_compressed(path,**arrays)
+
+
+def load_matching(path):
+    with np.load(path,allow_pickle=False) as a:
+        result=json.loads(a['metadata_json'].item())
+        result.update({key:a[key].copy() for key in a.files if key!='metadata_json'})
+    return result
+
+
+def diagnose(out):
+    out=Path(out);folder=out/'stage_a'
+    capture=json.loads((folder/'capture.json').read_text())
+    if capture['status']!='PASS':raise RuntimeError('Stage A capture incomplete')
+    dest=folder/'matching';dest.mkdir(exist_ok=False)
+    result=dict(status='RUNNING',ledger={},teacher_rows=[],trajectory_rows=[],timings={},
+        fixed_confidence_ratio=.5,GT_in_matching=False,GT_free_generation_precision='NOT_AVAILABLE',
+        serialization='Undefined nonfinite diagnostic scalars become JSON null; candidate_count and ambiguity flags retain reason. All numerical top-level arrays are preserved in NPZ.')
+    def save():atomic_json(folder/'diagnosis.json',json_safe(result))
+    start=time.perf_counter();save()
+    try:
+        for group,rows in [('teacher',capture['teacher_rows']),('trajectory',capture['supplemental_rows'])]:
+            for source in rows:
+                with np.load(out/source['path'],allow_pickle=False) as data:
+                    known=data['known_mask'].copy();valid=data['valid_mask'].copy()
+                    ids=data['source_vertex_ids'].copy() if group=='teacher' else None
+                    for geometry,arraykey in [('Xt','xt'),('Yhat','yhat')]:
+                        triangles=data[arraykey].copy()
+                        if result['ledger'].get('matching_attempts',0)>=128:raise RuntimeError('Stage A matching budget exceeded')
+                        matching=match_partners(triangles,known,valid,ledger=result['ledger'])
+                        metrics=score_pairs(matching,ids)
+                        candidate=construct_candidate(triangles,known,matching,valid)
+                        risk=dict(status=candidate['status'],failure_code=candidate.get('failure_code'),
+                                  risk=candidate.get('risk',{}),seconds=candidate['seconds'],
+                                  scope='endpoint_equivalence_risk_only_no_formal_postprocessing_score')
+                        name=source['key']+'__'+geometry
+                        file=dest/(name+'.npz');save_matching(file,matching)
+                        row={key:value for key,value in source.items() if key not in ('audit','runtime')}
+                        row.update(geometry=geometry,matching_file=str(file.relative_to(out)),
+                            metrics=metrics,structural_risk=risk,matching_counts=matching['counts'],
+                            matching_timing=matching['timing'],ambiguity=matching['ambiguity'])
+                        result[group+'_rows'].append(row)
+                        save()
+                        print(group,name,'match',matching['status'],'accept',matching.get('counts',{}).get('accepted_pairs'),flush=True)
+        target_rows=[row for row in result['teacher_rows'] if row['geometry']=='Yhat']
+        result['window']=select_window(target_rows)
+        temporal=[]
+        for parent in (0,1):
+            for patch in (0,2):
+                rows=sorted([row for row in result['trajectory_rows'] if row['parent']==parent and row['patch']==patch and row['geometry']=='Yhat'],key=lambda x:x['t'])
+                previous=None
+                for row in rows:
+                    m=load_matching(out/row['matching_file'])
+                    pairs={tuple([int(a),int(b),bool(f)]) for (a,b),f in zip(m['pairs'],m['endpoint_flip'])}
+                    accepted={tuple([int(a),int(b),bool(f)]) for (a,b),f,keep in zip(m['pairs'],m['endpoint_flip'],m['confidence_mask']) if keep}
+                    if previous is not None:
+                        old,old_accepted,old_t,old_status=previous
+                        temporal.append(dict(parent=parent,patch=patch,from_t=old_t,to_t=row['t'],
+                            status='PASS' if old_status==m['status']=='PASS' else 'NOT_AVAILABLE',
+                            full_pair_Jaccard=(len(old&pairs)/len(old|pairs) if old|pairs else None) if old_status==m['status']=='PASS' else 'NOT_AVAILABLE',
+                            confident_pair_Jaccard=(len(old_accepted&accepted)/len(old_accepted|accepted) if old_accepted|accepted else None) if old_status==m['status']=='PASS' else 'NOT_AVAILABLE',
+                            GT_identity_available=False))
+                    previous=(pairs,accepted,row['t'],m['status'])
+        result['trajectory_partner_stability']=temporal
+        result['status']='COMPLETE'
+    except BaseException as error:
+        result.update(status='STOPPED',error=repr(error));raise
+    finally:
+        result['timings']['CPU_diagnosis_wall_seconds']=time.perf_counter()-start;save()
+    atomic_json(folder/'window.json',json_safe(result['window']))
+    print(json.dumps(json_safe(result['window']),indent=2),flush=True)
+    return result
+
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser();parser.add_argument('--out',type=Path,required=True)
+    diagnose(parser.parse_args().out)
