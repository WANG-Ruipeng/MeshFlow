+"""Bounded CPU-only fixtures; no model/OT/training or old entrypoint imports."""
+from __future__ import annotations
+import argparse
+import ast
+import hashlib
+import json
+from pathlib import Path
+import time
+from types import SimpleNamespace
+from collections import defaultdict
+import numpy as np
+import torch
+import networkx as nx
+from .. import pairing as P
+
+POLICY = dict(FP64_atol=1e-12, FP64_rtol=1e-12, finite_difference_step=1e-6,
+              finite_difference_atol=1e-8, finite_difference_rtol=1e-5,
+              FP32_atol=3e-7, FP32_rtol=3e-5)
+
+
+def _tetra(noise=False):
+    v = np.array([[0.,0.,0.],[1.,0.,0.],[.2,.8,0.],[.13,.17,.61]],np.float64)
+    f = np.array([[0,2,1],[0,1,3],[1,2,3],[2,0,3]])
+    x = v[f].copy(); known = np.array([True,True,False,False])
+    if noise:
+        x[~known] += np.random.RandomState(1701).normal(0,.006,size=x[~known].shape)
+    return x,known
+
+
+def _constraint_ids(m, face_map, corner_map):
+    out=[]
+    for (h,k),flip in zip(m['all_pairs'],m['all_endpoint_flip']):
+        f,g=int(h)//3,int(k)//3
+        a,b=P.EDGES[int(h)%3],P.EDGES[int(k)%3]
+        if flip:b=b[::-1]
+        links=[]
+        for u,v in zip(a,b):
+            left=int(face_map[f])*3+int(corner_map[f,u])
+            right=int(face_map[g])*3+int(corner_map[g,v])
+            links.append(tuple(sorted((left,right))))
+        out.append(tuple(sorted(links)))
+    return sorted(out)
+
+
+def run_cpu_tests(cloud_research_root, cloud_archive_root):
+    started=time.perf_counter();ledger={};extra=dict(CPU_autograd_attempts=0,CPU_autograd_returns=0,
+        finite_difference_evaluations=0,cloud_reference_matching_calls=0,
+        cloud_confidence_evaluations=0,model_forwards=0,model_backwards=0,OT_calls=0,optimizer_updates=0)
+    rows=[];measure={}
+    assert not torch.cuda.is_initialized()
+    def match(x,k,v=None):return P.match_partners(x,k,v,ledger=ledger)
+    def loss(x,m,conf=False):return P.pair_loss(x,m,confidence=conf,ledger=ledger)['loss']
+    def grad(y,x):
+        extra['CPU_autograd_attempts']+=1
+        g=torch.autograd.grad(y,x)[0]
+        extra['CPU_autograd_returns']+=1
+        return g
+    def run(name,fn):
+        t=time.perf_counter()
+        try:fn();rows.append(dict(name=name,status='PASS',seconds=time.perf_counter()-t))
+        except Exception as e:
+            rows.append(dict(name=name,status='FAIL',error=repr(e),seconds=time.perf_counter()-t))
+            raise
+    def ok(m):assert m['status']=='PASS',m.get('failure_code')
+    try:
+        def oracle():
+            x,k=_tetra();m=match(x,k);ok(m)
+            assert len(m['fixed_C_pairs'])==1 and len(m['pairs'])==5
+            assert m['confidence_mask'].all() and len(m['all_pairs'])==6
+            y=torch.tensor(x,dtype=torch.float64,requires_grad=True);a=loss(y,m)
+            assert float(a)==0. and torch.count_nonzero(grad(a,y))==0
+            assert m['counts']['valid_halfedges']==12
+        run('closed_oracle_and_fixed_C_exclusion',oracle)
+
+        def analytic():
+            x,k=_tetra(True);m=match(x,k);ok(m)
+            y=torch.tensor(x,dtype=torch.float64,requires_grad=True);a=loss(y,m);g=grad(a,y).numpy()
+            expected=np.zeros_like(x);e=x[:,P.EDGES,:].reshape(-1,2,3)
+            for (h,j),flip,w in zip(m['pairs'],m['endpoint_flip'],m['weights']):
+                f,c=int(h)//3,P.EDGES[int(h)%3];q,d=int(j)//3,P.EDGES[int(j)%3]
+                if flip:d=d[::-1]
+                for u,v in zip(c,d):
+                    force=w/m['full_denominator']*(x[f,u]-x[q,v])
+                    if not k[f]:expected[f,u]+=force
+                    if not k[q]:expected[q,v]-=force
+            np.testing.assert_allclose(g,expected,atol=1e-12,rtol=1e-12)
+            assert np.count_nonzero(g[k])==0 and np.linalg.norm(g[~k])>0
+            assert np.isfinite(g).all() and not torch.is_tensor(m['weights'])
+            measure['analytic_gradient_max_abs_error']=float(np.max(np.abs(g-expected)))
+            # Production FP32 includes a detached C anchor with no coordinate gradient.
+            x32=x.astype(np.float32);mm=match(x32,k);ok(mm)
+            yf=torch.tensor(x32,requires_grad=True);lf=loss(yf,mm);gf=grad(lf,yf)
+            yd=torch.tensor(x32.astype(np.float64),requires_grad=True);ld=loss(yd,mm);gd=grad(ld,yd)
+            np.testing.assert_allclose(lf.detach().numpy(),ld.detach().numpy(),atol=3e-7,rtol=3e-5)
+            np.testing.assert_allclose(gf.numpy(),gd.numpy(),atol=3e-7,rtol=3e-5)
+        run('analytic_gradient_C_detached_and_FP32',analytic)
+
+        def finite_difference():
+            x,k=_tetra(True);m=match(x,k);ok(m)
+            d=np.random.RandomState(1702).normal(size=x.shape);d[k]=0;d/=np.linalg.norm(d)
+            y=torch.tensor(x,requires_grad=True);g=grad(loss(y,m),y).numpy()
+            h=POLICY['finite_difference_step']
+            plus=float(loss(torch.tensor(x+h*d),m));minus=float(loss(torch.tensor(x-h*d),m));extra['finite_difference_evaluations']+=2
+            fd=(plus-minus)/(2*h);expected=float((g*d).sum())
+            np.testing.assert_allclose(fd,expected,atol=1e-8,rtol=1e-5)
+            measure['finite_difference_abs_error']=abs(fd-expected)
+        run('frozen_partner_directional_finite_difference',finite_difference)
+
+        def permutations():
+            x,k=_tetra(True);m=match(x,k);ok(m)
+            y=torch.tensor(x,requires_grad=True);base=loss(y,m);g=grad(base,y).numpy()
+            fp=np.array([2,0,3,1]);cp=np.array([[2,0,1],[1,0,2],[0,2,1],[1,2,0]])
+            xp=x[fp][:,np.arange(3),:].copy()
+            xp=np.take_along_axis(x[fp],cp[:,:,None],axis=1)
+            kp=k[fp];mp=match(xp,kp);ok(mp)
+            assert _constraint_ids(m,np.arange(4),np.tile(np.arange(3),(4,1)))==_constraint_ids(mp,fp,cp)
+            yp=torch.tensor(xp,requires_grad=True);lp=loss(yp,mp);gp=grad(lp,yp).numpy();restore=np.zeros_like(g)
+            for f in range(4):
+                for c in range(3):restore[fp[f],cp[f,c]]=gp[f,c]
+            np.testing.assert_allclose(float(lp),float(base),atol=1e-12,rtol=1e-12)
+            np.testing.assert_allclose(restore,g,atol=1e-12,rtol=1e-12)
+            pad=np.concatenate((xp[:2],np.full((1,3,3),np.nan),xp[2:]));kk=np.insert(kp,2,False);valid=np.ones(5,bool);valid[2]=False
+            pm=match(pad,kk,valid);ok(pm)
+            py=torch.tensor(pad,requires_grad=True);pl=loss(py,pm);pg=grad(pl,py).numpy()
+            assert np.isfinite(pg).all() and np.count_nonzero(pg[2])==0
+            np.testing.assert_allclose(float(pl),float(base),atol=1e-12,rtol=1e-12)
+            repeat=match(pad,kk,valid);ok(repeat)
+            for key in ('all_pairs','all_endpoint_flip','weights','confidence_mask'):assert np.array_equal(pm[key],repeat[key])
+        run('unambiguous_S3_face_permutation_scattered_known_padding_repeat',permutations)
+
+        def all_rejected():
+            tri=np.array([[0.,0.,0.],[1.,0.,0.],[0.,1.,0.]])
+            x=np.stack((tri,tri+[0,0,10.]));m=match(x,np.zeros(2,bool));ok(m)
+            assert not m['confidence_mask'].any() and m['full_denominator']>0
+            y=torch.tensor(x,requires_grad=True);a=loss(y,m,True);g=grad(a,y)
+            assert a.requires_grad and float(a)==0 and torch.count_nonzero(g)==0
+            assert float(loss(y,m))>0
+        run('confidence_all_rejected_graph_connected_zero',all_rejected)
+
+        def denominator():
+            x,k=_tetra(True);m=match(x,k);ok(m)
+            selected=dict(m);selected['confidence_mask']=np.zeros(len(m['pairs']),bool);selected['confidence_mask'][0]=True
+            y=torch.tensor(x,requires_grad=True);out=P.pair_loss(y,selected,confidence=True,ledger=ledger)
+            h,j=m['pairs'][0];e=x[:,P.EDGES,:].reshape(-1,2,3);b=e[j][::-1] if m['endpoint_flip'][0] else e[j]
+            expected=((e[h]-b)**2).sum(-1).mean()*m['weights'][0]/m['weights'].sum()
+            np.testing.assert_allclose(float(out['loss']),expected,atol=1e-12,rtol=1e-12)
+            assert out['full_denominator']==m['full_denominator'] and out['counts']['active_pairs']==1
+            assert np.isfinite(grad(out['loss'],y).numpy()).all()
+        run('confidence_keeps_prefilter_full_denominator',denominator)
+
+        def duplicate():
+            tri=np.array([[0.,0.,0.],[1.,0.,0.],[0.,1.,0.]])
+            x=np.stack((tri,tri));m=match(x,np.zeros(2,bool));ok(m)
+            assert m['counts']['duplicate_face_groups']==1 and len(m['pairs'])==3 and m['confidence_mask'].all()
+            assert float(loss(torch.tensor(x),m))==0
+            measure['duplicate_faces_zero_loss_is_not_legal_surface']=True
+        run('duplicate_face_zero_loss_witness_retained',duplicate)
+
+        def impossible():
+            tri=np.array([[0.,0.,0.],[1.,0.,0.],[0.,1.,0.]])
+            odd=match(tri[None],np.zeros(1,bool));assert odd['failure_code']=='ODD_REMAINING_HALFEDGE_COUNT'
+            x=np.stack([tri+[0,0,i*3.] for i in range(6)])
+            m=match(x,np.array([1,1,1,1,0,0],bool));assert m['failure_code']=='NO_FULL_FEASIBLE_MATCHING'
+            try:loss(torch.tensor(x),m)
+            except ValueError:pass
+            else:raise AssertionError('failed match became a loss')
+        run('odd_and_full_graph_infeasible_are_failures',impossible)
+
+        def zero_weight():
+            x=np.stack((np.zeros((3,3)),np.ones((3,3))))
+            m=match(x,np.zeros(2,bool));assert m['failure_code']=='ALL_ZERO_OR_NONFINITE_PAIR_WEIGHT'
+            assert m['counts']['zero_length_edges']==6
+        run('all_zero_pair_weights_fail',zero_weight)
+
+        def C_conflict():
+            tri=np.array([[0.,0.,0.],[1.,0.,0.],[0.,1.,0.]])
+            x=np.stack((tri,tri,tri,tri+[0,0,1.]));m=match(x,np.array([1,1,1,0],bool))
+            assert m['failure_code']=='NONMANIFOLD_KNOWN_EDGE_INCIDENCE'
+            assert m['counts']['C_internal_nonmanifold_edge_groups']==3
