+"""Bounded CPU capture gate: execute only saved endpoint expressions, never capture.
+
+The actual capture source is parsed without importing it. No model, OT, GPU,
+checkpoint, sampling, loss, or autograd operation is performed.
+"""
+import ast
+from pathlib import Path
+import unittest
+from unittest import mock
+import torch
+
+SOURCE = Path(__file__).with_name("capture.py")
+TEST_COUNTS = dict(CPU_endpoint_expression_evaluations=0, mocked_velocity_calls=0,
+                   real_model_calls=0, OT_calls=0, autograd_calls=0,
+                   GPU_calls=0, sampling_rollouts=0, optimizer_updates=0)
+
+
+def source_tree():
+    return ast.parse(SOURCE.read_text(encoding="utf-8"), filename=str(SOURCE))
+
+
+def expressions():
+    found = [n.value for n in ast.walk(source_tree()) if isinstance(n, ast.Assign)
+             and any(isinstance(t, ast.Name) and t.id == "yh" for t in n.targets)]
+    if len(found) != 2:
+        raise AssertionError("Expected exactly teacher and supplementary endpoint expressions")
+    return {"teacher" if any(isinstance(n, ast.Name) and n.id == "batch"
+                            for n in ast.walk(value)) else "supplementary": value
+            for value in found}
+
+
+def run_expression(kind, namespace):
+    code = compile(ast.Expression(expressions()[kind]), str(SOURCE)+":"+kind, "eval")
+    TEST_COUNTS["CPU_endpoint_expression_evaluations"] += 1
+    return eval(code, {"torch": torch, "__builtins__": {}}, namespace)
+
+
+class CaptureTests(unittest.TestCase):
+    def setUp(self):
+        self.assertFalse(torch.cuda.is_initialized())
+        self.cuda_guard = mock.patch.object(torch.cuda, "_lazy_init",
+            side_effect=AssertionError("Capture CPU test attempted CUDA initialization"))
+        self.cuda_guard.start(); self.addCleanup(self.cuda_guard.stop)
+
+    def check_endpoint(self, kind):
+        # Non-prefix known slots exercise mask semantics, including nonzero known velocity.
+        known = torch.zeros((1,112), dtype=torch.bool)
+        known[0,[1,9,55,100]] = True
+        xt = torch.arange(1008, dtype=torch.float32).reshape(1,112,9)/32
+        context = torch.full_like(xt, -13.25)
+        velocity = torch.full_like(xt, 7.5)
+        velocity[known] = 1234.
+        if kind == "supplementary": xt[known] = context[known]
+        original_xt, original_C = xt.clone(), context.clone()
+        fake_model = mock.Mock(return_value=velocity)
+        for time in (.5,.94):
+            with self.subTest(kind=kind,time=time):
+                t = torch.tensor([time],dtype=torch.float32)
+                v = fake_model(); TEST_COUNTS["mocked_velocity_calls"] += 1
+                batch = dict(xt=xt,t=t,known_mask=known,context=context)
+                actual = run_expression(kind,dict(batch=batch,v=v,known=known,xt=xt,tv=t))
+                expected = xt.clone()
+                expected[~known] = (xt+(1-t[:,None,None])*v)[~known]
+                expected[known] = context[known]
+                self.assertTrue(torch.equal(actual,expected))
+                self.assertTrue(torch.equal(actual[known],context[known]))
+                self.assertTrue(torch.equal(xt,original_xt))
+                self.assertTrue(torch.equal(context,original_C))
+                self.assertEqual(actual.dtype,torch.float32)
+                self.assertFalse(actual.requires_grad)
+                self.assertTrue(bool(torch.isfinite(actual).all()))
+        self.assertEqual(fake_model.call_count,2)
+
+    def test_teacher_preserves_C_despite_nonzero_known_velocity(self):
+        self.check_endpoint("teacher")
+
+    def test_supplementary_preserves_C_despite_nonzero_known_velocity(self):
+        self.check_endpoint("supplementary")
+
+    def test_fixed_loop_budget_and_independent_noise(self):
+        tree=source_tree()
+        constants={}
+        for n in tree.body:
+            if isinstance(n,ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0],ast.Name):
+                try:constants[n.targets[0].id]=ast.literal_eval(n.value)
+                except (ValueError,TypeError):pass
+        self.assertEqual(constants["TIMES"],(.5,.7,.84,.94))
+        self.assertEqual(constants["TEACHER_SEED"],41001)
+        self.assertEqual(constants["DIAGNOSTIC_SEED"],10300)
+        visits={"teacher":0,"supplementary":0,"rollouts":0,"OT_samples":0,"Gaussian":0}
+        def length(node):
+            if isinstance(node,ast.Name):return len(constants[node.id])
+            if isinstance(node,(ast.Tuple,ast.List)):return len(node.elts)
+            if isinstance(node,ast.Call) and isinstance(node.func,ast.Name) and node.func.id=="range":
+                return len(range(*(ast.literal_eval(v) for v in node.args)))
+            raise AssertionError("Unregistered loop iterator")
+        def walk(node,multiple=1):
+            if isinstance(node,ast.For):
+                for child in node.body:walk(child,multiple*length(node.iter))
+                for child in node.orelse:walk(child,multiple)
+                return
+            if isinstance(node,ast.Call):
+                fn=node.func
+                if isinstance(fn,ast.Name) and fn.id=="model":
+                    visits["teacher" if node.args and isinstance(node.args[0],ast.Starred) else "supplementary"]+=multiple
+                if isinstance(fn,ast.Name) and fn.id=="clamped_sample":visits["rollouts"]+=multiple
+                if isinstance(fn,ast.Name) and fn.id=="make_noise":visits["Gaussian"]+=multiple
+                if isinstance(fn,ast.Attribute) and fn.attr=="_sample":visits["OT_samples"]+=multiple
+            for child in ast.iter_child_nodes(node):walk(child,multiple)
+        capture=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=="capture")
+        walk(capture)
+        self.assertEqual(visits,dict(teacher=48,supplementary=16,rollouts=4,OT_samples=12,Gaussian=1))
+        # Read the real unchanged sampler loop instead of assuming its Euler budget.
+        sampler=ast.parse((SOURCE.resolve().parents[3]/"native_t1/sampling.py").read_text(encoding="utf-8"))
+        fn=next(n for n in sampler.body if isinstance(n,ast.FunctionDef) and n.name=="_sample")
+        loops=[n for n in ast.walk(fn) if isinstance(n,ast.For) and isinstance(n.target,ast.Name) and n.target.id=="k"]
+        self.assertEqual(len(loops),1); self.assertEqual(length(loops[0].iter),50)
+        self.assertEqual(visits["teacher"]+50*visits["rollouts"]+visits["supplementary"],264)
+        self.assertFalse(any(isinstance(n,ast.Attribute) and n.attr=="load_state_dict" for n in ast.walk(capture)))
+        wrappers=[n for n in ast.walk(capture) if isinstance(n,ast.With) and any(
+            isinstance(i.context_expr,ast.Call) and isinstance(i.context_expr.func,ast.Name)
+            and i.context_expr.func.id=="count_ot_calls" for i in n.items)]
+        self.assertEqual(len(wrappers),1)
+        self.assertTrue(any(isinstance(n,ast.Call) and isinstance(n.func,ast.Attribute) and n.func.attr=="_sample" for n in ast.walk(wrappers[0])))
+
+    def test_model_allowlist_and_endpoint_have_no_GT_inputs(self):
+        tree=source_tree()
+        calls=[n for n in ast.walk(tree) if isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id=="model"]
+        self.assertEqual(len(calls),2)
+        teacher=next(n for n in calls if isinstance(n.args[0],ast.Starred))
+        self.assertEqual(ast.unparse(teacher.args[0]),"*model_inputs(batch)")
+        other=next(n for n in calls if not isinstance(n.args[0],ast.Starred))
+        self.assertEqual([ast.unparse(x) for x in other.args],["xt","tv","N","valid","known"])
+        for value in expressions().values():
+            names={n.id for n in ast.walk(value) if isinstance(n,ast.Name)}
+            self.assertFalse(names & {"Y","u","ids","source_vertex_ids","source_vertices","source_faces"})
+        loads=[n for n in ast.walk(tree) if isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id=="load_geometry_checkpoint"]
+        self.assertEqual(len(loads),1)
+        self.assertEqual({k.arg:ast.literal_eval(k.value) for k in loads[0].keywords},{"device":"cuda","expected_recipe":"fm"})
+        identity_keys={n.slice.value for n in ast.walk(tree) if isinstance(n,ast.Subscript) and isinstance(n.value,ast.Name) and n.value.id=="identity" and isinstance(n.slice,ast.Constant)}
+        self.assertEqual(identity_keys,{"state_sha256","cumulative_updates","checkpoint_sha256"})
+
+
+if __name__ == "__main__":
+    unittest.main()
