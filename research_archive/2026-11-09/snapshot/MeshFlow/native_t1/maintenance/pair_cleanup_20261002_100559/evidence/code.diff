+"""CPU mathematical fixtures for saved-value calibration, without matching.
+
+Two dtypes, two tests, six tiny autograd.grad calls total. No model,
+checkpoint, real teacher state, solver, calibration entry or optimizer call.
+"""
+import unittest
+import torch
+
+
+class SavedEndpointCalibration(unittest.TestCase):
+ def test_saved_values_and_unchanged_endpoint_jacobian(self):
+  for dtype in (torch.float32,torch.float64):
+   t=torch.tensor(.7,dtype=dtype)
+   known=torch.tensor([True,False,False])
+   v=torch.linspace(-.9,.8,27,dtype=dtype).reshape(3,3,3).requires_grad_()
+   xt=torch.linspace(.2,1.3,27,dtype=dtype).reshape(3,3,3)
+   C=torch.linspace(-.2,.4,27,dtype=dtype).reshape(3,3,3).requires_grad_()
+   original=torch.where(known[:,None,None],C.detach(),xt+(1-t)*v.detach()).detach().requires_grad_()
+   yh=torch.where(known[:,None,None],original.detach(),original.detach()+(1-t)*(v-v.detach()))
+   self.assertTrue(torch.equal(yh.detach().view(torch.uint8),original.detach().view(torch.uint8)))
+   probe=torch.linspace(-.8,.6,27,dtype=dtype).reshape(3,3,3)
+   gv,goriginal,gC=torch.autograd.grad((yh*probe).sum(),(v,original,C),allow_unused=True)
+   expected=torch.where(known[:,None,None],torch.zeros_like(probe),(1-t)*probe)
+   self.assertTrue(torch.equal(gv,expected))
+   self.assertIsNone(goriginal);self.assertIsNone(gC)
+ def test_fixed_pair_chain_gradient_matches_original_endpoint(self):
+  for dtype in (torch.float32,torch.float64):
+   t=torch.tensor(.84,dtype=dtype);known=torch.tensor([True,False,False])
+   values=torch.linspace(-.9,.8,27,dtype=dtype).reshape(3,3,3)
+   v=values.clone().requires_grad_();reference_v=values.clone().requires_grad_()
+   xt=torch.linspace(.2,1.3,27,dtype=dtype).reshape(3,3,3)
+   C=torch.linspace(-.2,.4,27,dtype=dtype).reshape(3,3,3)
+   original=torch.where(known[:,None,None],C,xt+(1-t)*values).detach()
+   surrogate=torch.where(known[:,None,None],original,original+(1-t)*(v-v.detach()))
+   endpoint=torch.where(known[:,None,None],C.detach(),xt+(1-t)*reference_v)
+   # A fixed CF edge and fixed FF edge, no partner search or confidence choice.
+   def objective(y):
+    a=(y[0,[0,1]]-y[1,[1,0]]).square().sum(-1).mean()
+    b=(y[1,[1,2]]-y[2,[2,1]]).square().sum(-1).mean()
+    return (.4*a+1.7*b)/2.1
+   first=torch.autograd.grad(objective(surrogate),v)[0]
+   second=torch.autograd.grad(objective(endpoint),reference_v)[0]
+   self.assertTrue(torch.equal(first,second))
+   self.assertEqual(torch.count_nonzero(first[known]).item(),0)
+   self.assertTrue(torch.isfinite(first).all())
+   self.assertGreater(torch.count_nonzero(first[~known]).item(),0)
+
+if __name__=='__main__':unittest.main()
