+
+
+def load_model(name,out):
+    if name=='B_Edge':
+        if file_sha256(EDGE_PATH)!='61d09ce272d2b677ed0ae045e81e8a0c6229cbf77b08de0a612e4a76ff10015f':raise ValueError('Wrong compact Edge-only checkpoint')
+        payload=torch.load(EDGE_PATH,map_location='cpu',weights_only=True,mmap=True)
+        if payload['schema']!='native_t1_geo_edge_only_factorial_v1' or payload['model_state_sha256']!=EDGE_STATE:raise ValueError('Wrong Edge-only identity')
+        # Build the identical architecture from the strictly validated common
+        # checkpoint, then strictly replace every learned tensor. No forward
+        # occurs using the common initialization in this comparator loader.
+        model,base=load_geometry_checkpoint(CHECKPOINT,device='cpu',expected_recipe='fm')
+        keys=model.load_state_dict(payload['model'],strict=True)
+        actual=state_sha256(model)
+        if actual!=EDGE_STATE or keys.missing_keys or keys.unexpected_keys:raise ValueError('Edge-only full state changed')
+        model.set_trainable(False).eval().to('cuda')
+        return model,dict(path=str(EDGE_PATH),file_sha256=file_sha256(EDGE_PATH),state_sha256=actual,
+            schema=payload['schema'],strict=True,architecture_constructed_from=base['checkpoint_sha256'],
+            official_or_common_state_used_for_forward=False,cumulative_updates=3000)
+    if name=='B_JEdge5':
