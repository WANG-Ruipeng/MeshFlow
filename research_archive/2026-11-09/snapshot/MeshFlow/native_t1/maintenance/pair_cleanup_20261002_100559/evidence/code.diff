+        for key in ('matching_attempts', 'matching_returns', 'matching_solver_attempts', 'matching_solver_returns'):
+            if _counter(diagnosis.get('ledger', {}), key) != 128:
+                errors.append('Stage A.' + key + ' differs from 128')
+        seeds = records.get('protocol', {}).get('registered_formal_seeds', [])
+        expected = {(model, p, patch, seed) for model in MODELS for p in (0, 1) for patch in range(5) for seed in seeds}
+        if len(seeds) != 4 or len(expected) != 160:
+            errors.append('Invalid registered formal matrix')
+        for phase, rows in (('sampling', sampling.get('rows', [])), ('post', post.get('rows', []))):
