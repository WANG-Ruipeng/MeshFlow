+"""One velocity-leaf calibration on frozen Stage A states; no model or rematching."""
+import argparse
+import json
+import time
+from pathlib import Path
+import numpy as np
+import torch
+from native_t1.artifacts import atomic_json, file_sha256
+from .diagnose import load_matching
+from .pairing import pair_loss
+
+
+def calibrate(out):
+    out=Path(out);stage=out/'stage_a';destination=stage/'calibration.json'
+    if destination.exists():raise FileExistsError(destination)
+    window=json.loads((stage/'window.json').read_text())
+    if (window.get('status')!='PASS_WINDOW_FOUND' or window.get('formal_training_allowed') is not True
+            or window.get('selected_t0') not in (.5,.7,.84)):
+        raise RuntimeError('No valid preregistered Pair time window; calibration forbidden')
+    diagnosis=json.loads((stage/'diagnosis.json').read_text())
+    if diagnosis.get('status')!='COMPLETE' or diagnosis.get('window')!=window or window.get('protocol_grid_complete') is not True:
+        raise RuntimeError('Complete identical Stage A window evidence is required')
+    selected=[r for r in diagnosis['teacher_rows'] if r['geometry']=='Yhat' and r['t']>=window['selected_t0']]
+    expected=12*sum(t>=window['selected_t0'] for t in (.5,.7,.84,.94))
+    if len(selected)!=expected or len({r['key'] for r in selected})!=expected:
+        raise RuntimeError('Calibration requires all distinct registered states in the selected window')
+    t0=float(window['selected_t0']);rows=[];ledger={};tick=time.perf_counter()
+    result=dict(status='RUNNING',t0=t0,lambda_pair=None,rows=rows,ledger=ledger,
+        formula='0.1*median(norm(grad_v sample_free_coordinate_FM_MSE))/median_nonzero(norm(grad_v full_Pair))',
+        gradients='CPU FP32 velocity leaves, not network parameters; original saved Yhat values and endpoint Jacobian',
+        counts=dict(model_forwards=0,model_backwards=0,optimizer_updates=0,matching_calls=0,velocity_autograd_attempts=0,velocity_autograd_calls=0),
+        window_sha256=file_sha256(stage/'window.json'))
+    try:
+        for row in diagnosis['teacher_rows']:
+            if row['geometry']!='Yhat' or row['t']<t0:continue
+            with np.load(out/row['path'],allow_pickle=False) as raw:
+                v=torch.from_numpy(raw['velocity'].copy()).requires_grad_()
+                u=torch.from_numpy(raw['u'].copy())
+                known=torch.from_numpy(raw['known_mask'].copy());valid=torch.from_numpy(raw['valid_mask'].copy())
+                free=valid & ~known
+                original=torch.from_numpy(raw['yhat'].copy())
+                t=torch.tensor(float(raw['t']),dtype=torch.float32)
+                # Exact frozen endpoint value, exact dYhat/dv=(1-t) on free only.
+                # This avoids introducing CPU-vs-CUDA rounding into selection.
+                yh=torch.where(known[:,None,None],original.detach(),original.detach()+(1-t)*(v-v.detach()))
+                fm=(v[free]-u[free]).square().mean()
+                m=load_matching(out/row['matching_file'])
+                pair=pair_loss(yh,m,confidence=False,ledger=ledger)['loss']
+                result['counts']['velocity_autograd_attempts']+=1
+                gf=torch.autograd.grad(fm,v)[0];result['counts']['velocity_autograd_calls']+=1
+                result['counts']['velocity_autograd_attempts']+=1
+                gp=torch.autograd.grad(pair,v)[0];result['counts']['velocity_autograd_calls']+=1
+                if not bool(torch.isfinite(gf).all() & torch.isfinite(gp).all()):raise FloatingPointError('Nonfinite calibration gradient')
+                if torch.count_nonzero(gf[known])+torch.count_nonzero(gp[known]):raise AssertionError('Known gradient in calibration')
+                rows.append(dict(key=row['key'],parent=row['parent'],K=row['K'],noise_index=row['noise_index'],t=row['t'],
+                    FM=float(fm.detach()),Pair=float(pair.detach()),FM_gradient_norm=float(gf.norm()),Pair_gradient_norm=float(gp.norm()),
+                    raw_sha256=file_sha256(out/row['path']),matching_sha256=file_sha256(out/row['matching_file'])))
+        fm=np.array([r['FM_gradient_norm'] for r in rows]);pair=np.array([r['Pair_gradient_norm'] for r in rows])
+        nonzero=pair[pair>0]
+        if not len(nonzero) or not len(fm) or not np.isfinite(fm).all() or not np.isfinite(nonzero).all():raise RuntimeError('Calibration has no finite nonzero denominator')
+        coefficient=float(.1*np.median(fm)/np.median(nonzero))
+        if not np.isfinite(coefficient) or coefficient<=0:raise RuntimeError('Invalid calibrated lambda')
+        result.update(status='PASS',lambda_pair=coefficient,median_FM_norm=float(np.median(fm)),median_nonzero_Pair_norm=float(np.median(nonzero)),
+                      nonzero_Pair_samples=len(nonzero),total_samples=len(rows),shared_by_arms=['P_Time','P_Conf'])
+    except BaseException as error:
+        result.update(status='STOPPED',error=repr(error));raise
+    finally:
+        result['seconds']=time.perf_counter()-tick;atomic_json(destination,result)
+    print(json.dumps({key:result[key] for key in ['status','t0','lambda_pair','total_samples']}),flush=True)
+    return result
+
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser();parser.add_argument('--out',type=Path,required=True)
+    calibrate(parser.parse_args().out)
