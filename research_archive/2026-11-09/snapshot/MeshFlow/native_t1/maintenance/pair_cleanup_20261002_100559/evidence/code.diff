+        expected_completed_sha256=STREAM_SHA, complete_and_matches=len(stream) == 500 and _seal(stream) == STREAM_SHA)
+    pairs = value.get('pair_audit', [])
+    result['sparse_pair_application'] = dict(recorded_steps=len(pairs),
+        active_steps=sum(r.get('Pair_active') is True for r in pairs),
+        applicable_steps=sum(r.get('Pair_applicable') is True for r in pairs),
+        independent_indices_sha256=_get(value, 'pair_indices', 'indices_sha256'),
