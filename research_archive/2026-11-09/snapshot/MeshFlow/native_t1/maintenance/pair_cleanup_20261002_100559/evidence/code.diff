+"""Private, fail-closed Pair trainer. Importing does not construct a model.
+
+No training is permitted without the saved Stage A window and calibration.
+Pair sees only the current predicted geometry and masks. Source IDs supervise
+the unchanged Edge term and never enter the matcher or generator.
+"""
+from native_t1 import runtime as _runtime
+from pathlib import Path
+import hashlib
+import json
+import math
+import time
+
+import numpy as np
+import torch
+
+from native_t1.artifacts import atomic_json, file_sha256, state_sha256
+from native_t1.training import masked_fm_loss
+from native_t1.losses.edge import edge_loss, prepare_edge_target, FORMULA_SPEC
+from .pairing import match_partners, pair_loss, SPEC
+
+ROOT = Path(__file__).resolve().parents[3]
+SCHEMA = 'geometric_pair_closure_training_v1'
+ARMS = ('P_Time', 'P_Conf')
+UPDATES = 500
+PAIR_SEED = 51001
+EDGE_LAMBDA = 4.071385484299878
+INPUT_SHA = '7059671d55f2f3be8777d13e02a62255d8a0c0c7c1c1c5b4f3b24357091ba6fc'
+G0_FILE_SHA = '3a66659e86586f54d2ec30ed3d4a18275ab69ba0f8cba2866ef67b340c481c0e'
+G0_STATE_SHA = '6fa39d1c8c1deade17467075160281dcf01948c45e90ca4a9ad111a7dd97c392'
+STREAM_START_SHA = 'ca35c12af30f1b3ec9d6d5e9d191edf0a1dc6c7b61584b6976c0ac6c004c93a7'
+STREAM_LOG_SHA = '609071dc47dd8805a43f79e4259ed649a39bee5808cb37978c2d939e5981e11c'
+LOG_STEPS = (1, 10, 50, 100, 250, 500)
+
+
+def seal(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(',', ':'),
+                                     allow_nan=False).encode()).hexdigest()
+
+
+def _read(path):
+    return json.loads(Path(path).read_text(encoding='utf-8'))
+
+
+def _positive(value, name):
+    if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value) or value <= 0:
+        raise ValueError(name + ' must be finite and strictly positive')
+    return float(value)
+
+
+def read_training_gate(out):
+    """Must be called before any model load, Pair registration or optimizer."""
+    folder = Path(out) / 'stage_a'
+    window = _read(folder / 'window.json')
+    if (window.get('status') != 'PASS_WINDOW_FOUND'
+            or window.get('formal_training_allowed') is not True
+            or window.get('protocol_grid_complete') is not True
+            or window.get('selected_t0') not in (.5, .7, .84)):
+        raise RuntimeError('Stage A has not authorized formal training')
+    diagnosis = _read(folder / 'diagnosis.json')
+    if diagnosis.get('status') != 'COMPLETE' or diagnosis.get('window') != window:
+        raise RuntimeError('Window is not bound to the completed Stage A diagnosis')
+    window_sha256 = file_sha256(folder / 'window.json')
+    calibration = _read(folder / 'calibration.json')
+    if (calibration.get('status') != 'PASS' or calibration.get('t0') != window['selected_t0']
+            or calibration.get('window_sha256') != window_sha256):
+        raise RuntimeError('Pair calibration has not passed for the selected window')
+    coefficient = _positive(calibration.get('lambda_pair'), 'lambda_pair')
+    return dict(t0=float(window['selected_t0']), lambda_pair=coefficient,
+                window_sha256=window_sha256,
+                calibration_sha256=file_sha256(folder / 'calibration.json'))
+
+
+def register_pair_indices(out):
+    """Independent private RNG; neither global NumPy nor training RNG changes."""
+    gate = read_training_gate(out)
+    indices = np.random.RandomState(PAIR_SEED).randint(0, 8, size=UPDATES).tolist()
+    value = dict(schema='sparse_pair_sample_indices_v1', seed=PAIR_SEED,
+                 effective_batch=8, updates=UPDATES, sampling='uniform_with_replacement',
+                 indices=indices, indices_sha256=seal(indices), gate=gate)
+    path = Path(out) / 'pair_sample_indices.json'
+    if path.exists():
+        if _read(path) != value:
+            raise ValueError('Pre-registered Pair indices or gate changed')
+    else:
+        atomic_json(path, value)
+    return dict(value, path=str(path.resolve()), sha256=file_sha256(path))
+
+
+def training_recipe(arm, t0, lambda_pair):
+    if arm not in ARMS or t0 not in (.5, .7, .84):
+        raise ValueError('Unknown arm or unregistered time window')
+    return dict(name=arm, FM='original_all_free_coordinates_effective_batch_denominator',
+                Edge=dict(formula=dict(FORMULA_SPEC), coefficient=EDGE_LAMBDA,
+                          gate=.5, sample_denominator=8),
+                Pair=dict(formula=dict(SPEC), coefficient=_positive(lambda_pair, 'lambda_pair'),
+                          gate=float(t0), confidence=(arm == 'P_Conf'),
+                          sample_denominator=1, one_uniform_sample_per_effective_batch=True,
+                          sampling_seed=PAIR_SEED, normalize_before_confidence_filter=True,
+                          weights_and_selection_detached=True),
+                ramp='min(additional_step/50,1)', effective_batch=8, microbatch=1,
+                L5='NOT_APPLIED', model_inputs_unchanged=True,
+                source_ids_enter_Pair=False, source_ids_enter_model=False,
+                precision='BF16_backbone_FP32_parameters_and_endpoint_geometry',
+                optimizer=dict(name='AdamW', lr=1e-5, betas=[.9, .95], weight_decay=0., clip=1., fresh=True))
+
+
+def _inc(counts, key):
+    counts[key] = counts.get(key, 0) + 1
+
+
+def _plain(value):
+    if torch.is_tensor(value):
+        value = value.detach().cpu().numpy()
+    if isinstance(value, np.ndarray):
+        return _plain(value.tolist())
+    if isinstance(value, np.generic):
+        return _plain(value.item())
+    if isinstance(value, dict):
+        return {str(k): _plain(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_plain(v) for v in value]
+    if isinstance(value, float) and not math.isfinite(value):
+        return 'NONFINITE:' + str(value)
+    return value
+
+
+class MatchingFailure(RuntimeError):
+    def __init__(self, matching, endpoint):
+        super().__init__('Pair matching failed: ' + str(matching.get('failure_code')))
+        self.matching = matching
+        self.endpoint = endpoint.detach().cpu().numpy().copy()
+
+
+def microbatch_loss(velocity, batch, edge_target, *, arm, t0, lambda_pair,
+                    step, selected, denominator, counts):
+    """One existing forward, unchanged FM/Edge, at most one detached match.
+
+    C, Xt, target velocity and time are constants. Only velocity/free endpoint
+    coordinates can receive gradients from the new term; known slots need not
+    occur first. This function never calls the generator or any OT operation.
+    """
+    if arm not in ARMS or t0 not in (.5, .7, .84) or type(step) is not int or not 1 <= step <= UPDATES:
+        raise ValueError('Unregistered training recipe')
+    _positive(lambda_pair, 'lambda_pair')
+    if type(selected) is not bool or velocity.shape[0] != 1 or velocity.dtype != torch.float32:
+        raise ValueError('One FP32 microbatch and explicit selection boolean required')
+    if not bool(torch.isfinite(velocity).all()):
+        raise FloatingPointError('Nonfinite model velocity')
+    known, valid = batch['known_mask'], batch['valid_mask']
+    t = batch['t'].detach()
+    if t.shape != (1,) or t.dtype != torch.float32 or not bool(torch.isfinite(t).all()):
+        raise ValueError('Original one-sample FP32 time required')
+    stored_t = float(t[0])
+    if not 0 <= stored_t <= 1:
+        raise ValueError('Time outside [0,1]')
+    with torch.autocast(device_type=velocity.device.type, enabled=False):
+        endpoint = torch.where(known[..., None], batch['context'].detach(),
+                               batch['xt'].detach() + (1 - t[:, None, None]) * velocity)
+        if not torch.equal(endpoint[known], batch['context'].detach()[known]):
+            raise AssertionError('Known coordinates changed in predicted endpoint')
+        if not bool(torch.isfinite(endpoint[valid]).all()):
+            raise FloatingPointError('Nonfinite predicted endpoint')
+        fm = masked_fm_loss(velocity, batch['u'].detach(), valid, known, denominator=denominator)
+        ramp = min(step / 50., 1.)
+        total = fm
+        diagnostic = dict(t=stored_t, selected=selected, ramp=ramp,
+                          FM=float(fm.detach()), Edge=None, Pair=None,
+                          weighted_Edge=0., weighted_Pair=0.,
+                          Edge_active=stored_t >= .5, Pair_active=selected and stored_t >= t0)
+        if stored_t >= .5:
+            _inc(counts, 'edge_loss_attempts')
+            result = edge_loss(endpoint[valid & ~known].reshape(-1, 3, 3), edge_target)
+            _inc(counts, 'edge_loss_returns')
+            weighted = ramp * EDGE_LAMBDA * result['loss'] / 8
+            total = total + weighted
+            diagnostic.update(Edge=float(result['loss'].detach()), weighted_Edge=float(weighted.detach()),
+                              Edge_applicable=result['applicable'], Edge_counts=_plain(result['counts']))
+        if selected:
+            _inc(counts, 'pair_selected_samples')
+        if diagnostic['Pair_active']:
+            _inc(counts, 'pair_active_samples')
+            # No target coordinates, source IDs, parent, GT bbox or velocities enter selection.
+            matching = match_partners(endpoint[0].reshape(-1, 3, 3).detach(),
+                                      known[0].detach(), valid[0].detach(), ledger=counts)
+            if matching.get('status') != 'PASS':
+                raise MatchingFailure(matching, endpoint[0].reshape(-1, 3, 3))
+            result = pair_loss(endpoint[0].reshape(-1, 3, 3), matching,
+                               confidence=(arm == 'P_Conf'), ledger=counts)
+            # P(j)=1/8 already estimates the all-eight mean. There is NO /8 here.
+            weighted = ramp * lambda_pair * result['loss']
+            total = total + weighted
+            diagnostic.update(Pair=float(result['loss'].detach()), weighted_Pair=float(weighted.detach()),
+                              Pair_applicable=result['applicable'], Pair_counts=_plain(result['counts']),
+                              matching_counts=_plain(matching['counts']),
+                              matching_timing=_plain(matching['timing']),
+                              matching_input_sha256=matching['input_geometry_sha256'],
+                              confidence=_plain({k: v for k, v in matching['confidence'].items()
+                                                 if np.isscalar(v)}),
+                              full_denominator=float(matching['full_denominator']))
+        if not bool(torch.isfinite(total)):
+            raise FloatingPointError('Nonfinite training objective; update stopped')
+    return total, diagnostic
+
+
+def audit_batch(stream, samples, step, labels):
+    return dict(step=step, batch_index=stream.batch_index, sample_index=stream.sample_index,
+                shared=[s['shared_input_sha256'] for s in samples],
+                C=[s['context_sha256'] for s in samples],
+                target_labels=[v['mapping_sha256'] for v in labels],
+                parents=[s['parent_index'] for s in samples], K=[s['K'] for s in samples],
+                t=[float(s['t']) for s in samples], stream_sha256=seal(stream.state_dict()))
+
+
+def _reference_stream(out):
+    audit = _read(Path(out) / 'asset_audit.json')
+    if audit.get('status') != 'PASS':
+        raise ValueError('Asset audit has not passed')
+    for item in audit['paired500_batch_logs']:
+        path = Path(item['path'])
+        if not path.is_file():
+            continue
+        saved = _read(path)
+        for key in item['json_pointer'].strip('/').split('/'):
+            saved = saved[key]
+        if len(saved) != UPDATES or seal(saved) != STREAM_LOG_SHA:
+            raise ValueError('Historical 500-batch sequence changed')
+        return saved
+    raise FileNotFoundError('No verified historical 500-batch audit available')
+
+
+def validate_checkpoint(payload, expected_config_sha256=None):
+    """Private identity validation, followed by real strict model loading below."""
+    from native_t1.portable_checkpoint import NATIVE_META
+    from native_t1.context_geometry import ENCODER_METADATA
+    if payload.get('schema') != SCHEMA or payload.get('native_meta') != NATIVE_META:
+        raise ValueError('Not a registered private Pair checkpoint')
+    arm = payload.get('arm')
+    gate = payload.get('training_gate', {})
+    expected_recipe = training_recipe(arm, gate.get('t0'), gate.get('lambda_pair'))
+    if payload.get('recipe') != expected_recipe:
+        raise ValueError('Checkpoint Pair recipe differs')
+    context = payload.get('context', {})
+    expected_context = dict(ENCODER_METADATA, context_mode='geo', additional_parameters=149888)
+    if context != expected_context:
+        raise ValueError('Checkpoint Geo context differs from common initialization')
+    step = payload.get('completed_updates')
+    if type(step) is not int or step not in (250, 500):
+        raise ValueError('Only predetermined 250/500 completed checkpoints are valid')
+    if (payload.get('base_cumulative_updates') != 2500 or payload.get('cumulative_updates') != 2500 + step
+            or payload.get('input_sha256') != INPUT_SHA or payload.get('initial_checkpoint_sha256') != G0_FILE_SHA
+            or payload.get('initial_state_sha256') != G0_STATE_SHA
+            or payload.get('stream_start_sha256') != STREAM_START_SHA
+            or payload.get('stream_reference_sha256') != STREAM_LOG_SHA):
+        raise ValueError('Checkpoint initial identity or progress differs')
+    if (payload.get('optimizer_step_in_progress') is not False or payload.get('batch_in_progress') is not False
+            or payload.get('fresh_optimizer') is not True):
+        raise ValueError('Checkpoint is not a completed fresh-optimizer update boundary')
+    stream = payload.get('stream_state', {})
+    if (stream.get('seed') != 1010 or stream.get('arm') != 'Native_correct'
+            or stream.get('batch_index') != 1000 + step or stream.get('sample_index') != 8000 + 8 * step
+            or seal(stream) != payload.get('stream_state_sha256')):
+        raise ValueError('Checkpoint stream identity differs')
+    expected_indices = np.random.RandomState(PAIR_SEED).randint(0, 8, UPDATES).tolist()
+    if payload.get('pair_indices_sha256') != seal(expected_indices):
+        raise ValueError('Checkpoint sparse application registration differs')
+    for key in ('config_sha256', 'model_state_sha256'):
+        value = payload.get(key)
+        if not isinstance(value, str) or len(value) != 64 or any(c not in '0123456789abcdef' for c in value):
+            raise ValueError('Missing valid checkpoint hash: ' + key)
+    if expected_config_sha256 is not None and payload['config_sha256'] != expected_config_sha256:
+        raise ValueError('Checkpoint config differs')
+    state = payload.get('model')
+    if (not isinstance(state, dict) or not state
+            or any(not isinstance(v, torch.Tensor) or v.dtype != torch.float32 or v.device.type == 'meta'
+                   for v in state.values())):
+        raise ValueError('Checkpoint requires real FP32 tensors')
+    if not isinstance(payload.get('optimizer'), dict):
+        raise ValueError('Checkpoint optimizer state missing')
+    return context
+
+
+def save_checkpoint(path, model, optimizer, stream, *, arm, gate, indices, step, config_path):
+    from native_t1.portable_checkpoint import NATIVE_META, config_sha256
+    path = Path(path)
+    temporary = path.with_suffix('.pt.partial')
+    if path.exists() or temporary.exists():
+        raise FileExistsError(path)
+    before = seal(stream.state_dict())
+    payload = dict(schema=SCHEMA, native_meta=dict(NATIVE_META), arm=arm, training_gate=dict(gate),
+                   recipe=training_recipe(arm, gate['t0'], gate['lambda_pair']),
+                   context=model.context_encoder.metadata(), model=model.state_dict(),
+                   optimizer=optimizer.state_dict(), fresh_optimizer=True,
+                   optimizer_step_in_progress=False, batch_in_progress=False,
+                   completed_updates=step, base_cumulative_updates=2500, cumulative_updates=2500 + step,
+                   initial_checkpoint_sha256=G0_FILE_SHA, initial_state_sha256=G0_STATE_SHA,
+                   input_sha256=INPUT_SHA, stream_start_sha256=STREAM_START_SHA,
+                   stream_reference_sha256=STREAM_LOG_SHA, stream_state=stream.state_dict(),
+                   stream_state_sha256=before, pair_indices_sha256=indices['indices_sha256'],
+                   config_sha256=config_sha256(config_path), model_state_sha256=state_sha256(model))
+    validate_checkpoint(payload, config_sha256(config_path))
+    if any(not bool(torch.isfinite(value).all()) for value in payload['model'].values()):
+        raise FloatingPointError('Cannot save nonfinite model')
+    torch.save(payload, temporary)
+    temporary.replace(path)
+    if seal(stream.state_dict()) != before:
+        raise AssertionError('Checkpoint save changed the formal stream')
+    digest = file_sha256(path)
+    return dict(path=str(path.resolve()), sha256=digest, checkpoint_sha256=digest,
+                state_sha256=payload['model_state_sha256'], bytes=path.stat().st_size,
+                schema=SCHEMA, arm=arm, completed_updates=step, cumulative_updates=2500 + step,
+                stream_state_sha256=before, save_rng_unchanged=True, optimizer_saved=True)
+
+
+def load_endpoint(path, *, device='cuda', config_path=None):
+    """Strictly load only this private Pair schema; no public recipe impersonation."""
+    from native_t1.checkpoint import DEFAULT_CONFIG
+    from native_t1.portable_checkpoint import _read_config, config_sha256
+    from native_t1.context_geometry import ContextGeometryEncoder
+    from native_t1.model import NativeInpaintingModel
+    from models.equidit import DiT
+    from models.utils import get_embedder
+    path = Path(path)
+    config_path = DEFAULT_CONFIG if config_path is None else Path(config_path)
+    config = _read_config(config_path)
+    payload = torch.load(path, map_location='cpu', weights_only=True, mmap=True)
+    context = validate_checkpoint(payload, config_sha256(config_path))
+    if any(v.device.type != 'cpu' for v in payload['model'].values()):
+        raise ValueError('CPU mapped parameters required for strict loading')
+    _runtime.configure_stable_runtime()
+    with torch.device('meta'):
+        model = NativeInpaintingModel(DiT(**config), trainable=False)
+    model.context_encoder = ContextGeometryEncoder('geo', seed=context['initialization_seed'])
+    model.backbone.x_embedder.embed_fn, _ = get_embedder(config['pe_freq'], input_dims=3)
+    loaded = model.load_state_dict(payload['model'], strict=True, assign=True)
+    actual = state_sha256(model)
+    if actual != payload['model_state_sha256']:
+        raise ValueError('Checkpoint state hash differs')
+    if any(not bool(torch.isfinite(v).all()) for v in model.state_dict().values()):
+        raise FloatingPointError('Nonfinite checkpoint parameters')
+    if sum(p.numel() for p in model.parameters()) != 130401155:
+        raise ValueError('Unexpected Native Geo parameter count')
+    model.set_trainable(False).eval().to(device)
+    digest = file_sha256(path)
+    return model, dict(status='PASS', path=str(path.resolve()), checkpoint_sha256=digest, sha256=digest,
+                       state_sha256=actual, schema=SCHEMA, arm=payload['arm'], recipe=payload['recipe'],
+                       cumulative_updates=payload['cumulative_updates'], completed_updates=payload['completed_updates'],
+                       context=context, strict=True, missing_keys=list(loaded.missing_keys),
+                       unexpected_keys=list(loaded.unexpected_keys), input_sha256=payload['input_sha256'],
+                       stream_state_sha256=payload['stream_state_sha256'], parameters=130401155,
+                       optimizer_restored=False)
+
+
+def _parameter_stat(value):
+    if value is None:
+        return dict(present=False)
+    x = value.detach().float()
+    return dict(present=True, finite=bool(torch.isfinite(x).all()),
+                RMS=float(x.square().mean().sqrt()), L2=float(x.norm()), nonzero=int(torch.count_nonzero(x)))
+
+
+def train_arm(out, arm):
+    """Explicitly run one gated 500-update arm; never auto-run the other arm."""
+    out = Path(out)
+    gate = read_training_gate(out)  # Must precede all model/optimizer/stream loading.
+    if arm not in ARMS:
+        raise ValueError('Only the two pre-registered arms may run')
+    if _read(out / 'gt_audit.json').get('formal_training_allowed') is not True:
+        raise RuntimeError('GT compatibility gate no longer authorizes training')
+    if _read(out / 'cpu_test_record.json').get('status') != 'PASS':
+        raise RuntimeError('CPU gate did not pass')
+    if _read(out / 'stage_a/capture.json').get('status') != 'PASS':
+        raise RuntimeError('Stage A capture incomplete')
+    reference = _reference_stream(out)
+    indices = register_pair_indices(out)
+    folder = out / arm
+    folder.mkdir(exist_ok=False)
+    counts = {}
+    record = dict(status='PREPARING', arm=arm, recipe=training_recipe(arm, gate['t0'], gate['lambda_pair']),
+                  gate=gate, pair_indices=indices, completed_updates=0, counts=counts,
+                  stream_audit=[], pair_audit=[], diagnostics=[], checkpoints={},
+                  timing=dict(CPU_OT_seconds=0., label_preparation_seconds=0.,
+                              training_update_seconds=0., checkpoint_save_and_hash_seconds=0.))
+    def persist():
+        atomic_json(folder / 'training.json', record)
+    persist()
+    started = time.perf_counter()
+    try:
+        from native_t1.accounting import count_ot_calls
+        from native_t1.data import load_archive, NativeTrainingStream, native_collate, model_inputs
+        from native_t1.geometry_checkpoint import load_geometry_checkpoint
+        from native_t1.checkpoint import DEFAULT_CONFIG
+        from native_t1.losses.targets import TrainingGeometryTargets
+        from native_t1.model import native_execution
+        from native_t1.training import make_optimizer
+        checkpoint = ROOT / 'native_t1/checkpoints/tgeo_g0_cumulative2500.pt'
+        if file_sha256(checkpoint) != G0_FILE_SHA:
+            raise ValueError('Common G0 file changed')
+        payload = torch.load(checkpoint, map_location='cpu', weights_only=True, mmap=True)
+        saved_stream = payload['stream_state']
+        if seal(saved_stream) != STREAM_START_SHA:
+            raise ValueError('Initial formal stream differs')
+        archive = load_archive(ROOT / 'output/t1_publish_20260930/chair_n112.npz', INPUT_SHA)
+        stream = NativeTrainingStream(archive, seed=1010)
+        stream.load_state_dict(saved_stream)
+        del payload
+        if seal(stream.state_dict()) != STREAM_START_SHA:
+            raise ValueError('Restored formal stream differs')
+        targets = TrainingGeometryTargets(archive)
+        model, identity = load_geometry_checkpoint(checkpoint, device='cuda', expected_recipe='fm')
+        if (identity['state_sha256'] != G0_STATE_SHA or identity['checkpoint_sha256'] != G0_FILE_SHA
+                or identity['cumulative_updates'] != 2500):
+            raise ValueError('Wrong common generator initialization')
+        model.set_trainable(True).eval()
+        optimizer = make_optimizer(model)
+        parameters = list(model.parameters())
+        if any(p.dtype != torch.float32 or not p.requires_grad for p in parameters):
+            raise ValueError('Every generator parameter must be FP32 and trainable')
+        named = dict(model.named_parameters())
+        selected_names = ['role_embedding', 'context_encoder.W_out.weight', 'context_encoder.mlp.0.weight',
+                          'backbone.final_layer.linear.weight']
+        observed = {key: named[key] for key in selected_names}
+        record.update(status='RUNNING', initial_identity=identity, parameters=sum(p.numel() for p in parameters),
+                      initial_stream_sha256=seal(stream.state_dict()))
+        persist()
+        with torch.enable_grad():
+            for step in range(1, UPDATES + 1):
+                record.update(step_in_progress=step, batch_in_progress=True, optimizer_step_in_progress=False)
+                persist()
+                tick = time.perf_counter()
+                with count_ot_calls(counts):
+                    samples = stream.next_effective_batch()
+                record['timing']['CPU_OT_seconds'] += time.perf_counter() - tick
+                tick = time.perf_counter()
+                labels = [targets.sample(sample) for sample in samples]
+                actual = audit_batch(stream, samples, step, labels)
+                if actual != reference[step - 1]:
+                    record['stream_mismatch'] = dict(actual=actual, expected=reference[step - 1])
+                    raise AssertionError('Formal target/noise/OT/t/mask/permutation stream changed')
+                record['stream_audit'].append(actual)
+                edge_targets = [prepare_edge_target(label) for label in labels]
+                record['timing']['label_preparation_seconds'] += time.perf_counter() - tick
+                denominator = 9 * sum(int((s['valid_mask'] & ~s['known_mask']).sum()) for s in samples)
+                if denominator not in (7524, 7452, 7488):
+                    raise ValueError('Original mixed-K effective FM denominator changed')
+                j = indices['indices'][step - 1]
+                snapshot = {key: p.detach().clone() for key, p in observed.items()} if step in LOG_STEPS else None
+                optimizer.zero_grad(set_to_none=True)
+                diagnostic = []
+                torch.cuda.synchronize()
+                tick = time.perf_counter()
+                for micro, (sample, target) in enumerate(zip(samples, edge_targets)):
+                    batch = native_collate([sample], 'cuda')
+                    with native_execution(model, coordinates=batch['xt']) as runtime:
+                        _inc(counts, 'forward_attempts')
+                        velocity = model(*model_inputs(batch)).float()
+                        _inc(counts, 'forward_returns')
+                        loss, detail = microbatch_loss(velocity, batch, target, arm=arm,
+                            t0=gate['t0'], lambda_pair=gate['lambda_pair'], step=step,
+                            selected=(micro == j), denominator=denominator, counts=counts)
+                        _inc(counts, 'backward_attempts')
+                        loss.backward()
+                        _inc(counts, 'backward_returns')
+                    diagnostic.append(detail)
+                gradients = {key: _parameter_stat(p.grad) for key, p in observed.items()} if snapshot else None
+                grad_norm = float(torch.nn.utils.clip_grad_norm_(parameters, 1., error_if_nonfinite=True))
+                record['optimizer_step_in_progress'] = True
+                _inc(counts, 'optimizer_step_attempts')
+                optimizer.step()
+                _inc(counts, 'optimizer_updates')
+                record['completed_updates'] = step
+                record['optimizer_step_in_progress'] = False
+                record['batch_in_progress'] = False
+                torch.cuda.synchronize()
+                if not bool(torch.stack([torch.isfinite(p).all() for p in parameters]).all()):
+                    raise FloatingPointError('Nonfinite parameter after actual update')
+                record['timing']['training_update_seconds'] += time.perf_counter() - tick
+                record['pair_audit'].append(dict(step=step, selected_micro=j, **diagnostic[j]))
+                if snapshot is not None:
+                    record['diagnostics'].append(dict(step=step, cumulative_before_forward=2500 + step - 1,
+                        losses={key: sum(d[key] or 0. for d in diagnostic)
+                                for key in ('FM', 'weighted_Edge', 'weighted_Pair')},
+                        microbatches=diagnostic, gradients=gradients,
+                        parameter_updates={key: _parameter_stat(p.detach() - snapshot[key]) for key, p in observed.items()},
+                        grad_norm_before_clip=grad_norm, free_coordinate_denominator=denominator, runtime=runtime))
+                if step in (250, 500):
+                    tick = time.perf_counter()
+                    record['checkpoints'][str(step)] = save_checkpoint(
+                        folder / f'additional_step{step}_cumulative_step{2500 + step}.pt',
+                        model, optimizer, stream, arm=arm, gate=gate, indices=indices, step=step,
+                        config_path=DEFAULT_CONFIG)
+                    record['timing']['checkpoint_save_and_hash_seconds'] += time.perf_counter() - tick
+                persist()
+                if step in LOG_STEPS or step % 25 == 0:
+                    print(arm, step, '/', UPDATES, 'pair_active', counts.get('pair_active_samples', 0), flush=True)
+        if seal(record['stream_audit']) != STREAM_LOG_SHA:
+            raise AssertionError('Final 500-batch stream audit differs')
+        record.update(status='PASS', final_state_sha256=state_sha256(model),
+                      final_stream_sha256=seal(stream.state_dict()), cumulative_updates=3000)
+        if record['final_state_sha256'] != record['checkpoints']['500']['state_sha256']:
+            raise AssertionError('Final model differs from fixed 500 checkpoint')
+    except BaseException as exc:
+        record.update(status='STOPPED', error=repr(exc))
+        if isinstance(exc, MatchingFailure):
+            np.savez_compressed(folder / 'failed_matching_input.npz', endpoint=exc.endpoint,
+                                known_mask=exc.matching.get('known_mask'), valid_mask=exc.matching.get('valid_mask'))
+            atomic_json(folder / 'failed_matching.json', _plain(exc.matching))
+        raise
+    finally:
+        record['timing']['total_wall_seconds'] = time.perf_counter() - started
+        persist()
+    return record
+
