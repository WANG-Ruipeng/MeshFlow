+"""One common deterministic connection candidate per frozen raw output."""
+import argparse
+import csv
+import json
+import time
+from pathlib import Path
+import numpy as np
+from native_t1.artifacts import atomic_json, file_sha256
+from .pairing import match_partners
+from .closure import construct_candidate
+from .diagnose import json_safe,save_matching
+from .diagnostic_metrics import score_pairs
+from .evaluation import load_cases,score_output,audit_candidate
+from .capture import EVAL
+
+
+def postprocess(out):
+    out=Path(out);formal=out/'formal'
+    sampling=json.loads((formal/'sampling.json').read_text())
+    if sampling['status']!='PASS' or len(sampling['rows'])!=160:
+        raise RuntimeError('All 160 raw outputs must exist before any formal Stage 2 work')
+    folder=formal/'post';folder.mkdir(exist_ok=False)
+    cases=load_cases(EVAL)
+    report=dict(status='RUNNING',rows=[],ledger={},expected_requests=160,GT_used_for_matching_or_construction=False,
+                policy='Complete matching and one C-protected equivalence candidate per original endpoint; no retry, deletion or hole filling',
+                timing_note='candidate_audit includes post_metrics seconds; post_metrics is a nested component, not an additional audit call')
+    def save():atomic_json(formal/'postprocessing.json',json_safe(report))
+    save();start=time.perf_counter()
+    try:
+        for record in sampling['rows']:
+            if len(report['rows'])>=160:raise RuntimeError('Postprocessing request budget exceeded')
+            report['active_request']=dict(key=record['key'], model=record['model'], parent=record['parent'], patch=record['patch'], seed=record['seed'])
+            save()
+            path=out/record['path']
+            if file_sha256(path)!=record['sha256']:raise ValueError('Raw output changed')
+            case=cases[record['parent'],record['patch']]
+            with np.load(path,allow_pickle=False) as a:
+                raw=a['raw'].copy();C=a['C'].copy()
+            if C.tobytes()!=case['constraints'].tobytes():raise ValueError('Context identity mismatch')
+            known=np.arange(112)<12;valid=np.ones(112,dtype=bool)
+            tick=time.perf_counter();raw_metrics=score_output(raw,case,ledger=report['ledger']);raw_seconds=time.perf_counter()-tick
+            matching=match_partners(raw,known,valid,ledger=report['ledger'])
+            pair_metrics=score_pairs(matching,None)
+            match_path=folder/(record['key']+'_matching.npz');save_matching(match_path,matching)
+            candidate=construct_candidate(raw,known,matching,valid)
+            candidate['raw_triangles']=raw
+            tick=time.perf_counter();candidate_audit=audit_candidate(candidate,case,ledger=report['ledger']);audit_seconds=time.perf_counter()-tick
+            post_metrics=candidate_audit.pop('metrics',None);post_path=None;post_seconds=0.
+            if candidate['status']=='CANDIDATE':
+                post_path=folder/(record['key']+'_candidate.npz')
+                np.savez_compressed(post_path,triangles=candidate['triangles'],vertices=candidate['vertices'],faces=candidate['faces'],
+                    valid_mask=candidate['valid_mask'],known_mask=candidate['known_mask'])
+                # Score every constructed candidate, even if illegal. No
+                # successful-subset filtering can erase a quality cost.
+                # audit_candidate has already scored this candidate exactly once.
+                post_seconds=post_metrics.get('seconds',0.) if post_metrics else 0.
+            report['rows'].append(dict(key=record['key'],model=record['model'],parent=record['parent'],patch=record['patch'],seed=record['seed'],
+                raw_path=record['path'],raw_sha256=record['sha256'],matching_path=str(match_path.relative_to(out)),
+                matching_status=matching['status'],matching_failure=matching.get('failure_code'),matching_counts=matching['counts'],
+                matching_timing=matching['timing'],matching_ambiguity=matching['ambiguity'],pair_metrics=pair_metrics,
+                raw_metrics=raw_metrics,post_metrics=post_metrics,candidate_status=candidate['status'],candidate_failure=candidate.get('failure_code'),
+                candidate_risk=candidate.get('risk'),candidate_audit=candidate_audit,
+                post_path=str(post_path.relative_to(out)) if post_path else None,
+                seconds=dict(raw_audit=raw_seconds,matching=matching['timing'].get('total_seconds',0),
+                    construction=candidate['seconds'],candidate_audit=audit_seconds,post_metrics=post_seconds)))
+            save();print('post',len(report['rows']),record['key'],candidate['status'],candidate_audit.get('joint_legal'),flush=True)
+        report['active_request']=None
+        report['status']='PASS'
+    except BaseException as error:
+        report.update(status='STOPPED',error=repr(error));raise
+    finally:
+        report['wall_seconds']=time.perf_counter()-start;save()
+    return report
+
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser();parser.add_argument('--out',type=Path,required=True)
+    postprocess(parser.parse_args().out)
