+    a=p.info;a['memory_info']=a['memory_info']._asdict();r['processes'].append(a)
+  except (psutil.NoSuchProcess,psutil.AccessDenied):pass
+ write(OUT/'resources'/f'{phase}_{time.time_ns()}.json',r);return r
