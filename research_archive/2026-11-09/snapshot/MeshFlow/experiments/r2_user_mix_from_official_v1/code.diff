+TOTAL=6000
+LIMITS=dict(train_forward=48000,train_backward=48000,optimizer_update=6000)
+OFFICIAL=Path('/mnt/e/MeshFlow/native_t1/runs/control_mvp48_v1/checkpoints/official_chair_last.pt')
