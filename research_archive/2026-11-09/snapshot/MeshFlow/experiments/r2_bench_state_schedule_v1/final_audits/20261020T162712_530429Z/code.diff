+SALT = "R2_BENCH_STATE_SCHEDULE_V1/PERTURBED_ENDPOINT_CORRECTIVE/v1"
+PROBABILITY = 0.25
+TIME_MIN = 0.3
+TIME_MAX = 0.9
+ALPHA_MIN = 0.3
+ALPHA_MAX = 0.8
