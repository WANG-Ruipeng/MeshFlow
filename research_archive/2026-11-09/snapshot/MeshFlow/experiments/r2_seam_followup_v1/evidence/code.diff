+"""Verify and seal saved evidence. No model import, inference, or rescoring."""
+import collections
+import csv
+import datetime
+import difflib
+import hashlib
+import json
+from pathlib import Path
+import shutil
+
+ROOT = Path(__file__).resolve().parents[3]
+OUT = ROOT / 'experiments/r2_seam_followup_v1'
