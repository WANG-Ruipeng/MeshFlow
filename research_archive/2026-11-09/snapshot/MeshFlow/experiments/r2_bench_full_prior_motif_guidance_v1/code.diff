+    if len(owned) != 92:
+        raise ValueError('Expected exactly92 owned requests')
+    done, pending = [], []
+    proxy = E._post_proxy()
+    for task in owned:
+        result = H.completed(task)
+        if result:
+            done.append(result)
+        else:
