+        return p
+    p.parent.mkdir(parents=True, exist_ok=True)
+    with p.open('x', encoding='utf-8') as f:
+        json.dump(value, f, indent=2, ensure_ascii=False, allow_nan=False)
+        f.write('\n'); f.flush(); os.fsync(f.fileno())
+    return p
+
+
+def save_npz(path, data):
