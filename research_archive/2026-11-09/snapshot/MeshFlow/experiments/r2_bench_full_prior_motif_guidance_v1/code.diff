+    for part, expected in registration['old_processes'].items():
+        proc = H.process_identity(expected)
+        if proc is not None:
+            active.append(dict(kind='old', partition=int(part), pid=proc.pid,
+                               rss_bytes=proc.memory_info().rss))
+    for part in range(4):
