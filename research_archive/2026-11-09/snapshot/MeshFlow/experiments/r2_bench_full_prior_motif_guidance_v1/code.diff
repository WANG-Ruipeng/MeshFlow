+        s = '/mnt/' + s[0].lower() + s[2:]
+    if os.name == 'nt' and re.match(r'^/mnt/[a-z]/', s):
+        s = s[5].upper() + ':/' + s[7:]
+    p = Path(s)
+    return p if p.is_absolute() else ROOT / p
