+                 'NO':'NOT_CLEAR','NOT_CLEAR':'NOT_CLEAR','UNCERTAIN':'UNCERTAIN','UNKNOWN':'UNKNOWN'}
+        if value not in aliases:raise ValueError('Unknown visibility token for R drift: '+str(value))
+        return aliases[value]
+    return value
