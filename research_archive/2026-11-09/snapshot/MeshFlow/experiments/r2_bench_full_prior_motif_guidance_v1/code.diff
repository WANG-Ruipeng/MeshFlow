+    return {str(P.resolve(p)): P.sha(p) for p in paths}
+
+
+def _cached(path):
+    path = P.resolve(path)
+    if not path.exists():
+        return None
+    saved = P.read(path)
+    if saved.get('source_sha256') != P.sha(__file__):
+        raise ValueError('Completed evaluation implementation changed')
+    _verify(saved.get('protected', {}))
+    _verify(saved.get('files', {}))
+    return saved
