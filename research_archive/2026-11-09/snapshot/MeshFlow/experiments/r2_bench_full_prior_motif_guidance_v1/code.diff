+def recover_cpu_export(output_dir,registration=OUT/'registration.json'):
+    """Explicit all-50-committed export recovery; never constructs a model."""
+    sys.path.insert(0,str(ROOT/'r2/src'))
+    dest=resolve(output_dir);reg=read(registration);old=read(dest/'attempt.json')
+    tasks=_records(read(reg.get('tasks_path',OUT/'tasks.json')))
+    task=next(t for t in tasks if t.get('job_id',t.get('cell_id'))==old['job_id'])
+    if resolve(task['output_dir'])!=dest or task['arm']!=old['arm'] or task['request_id']!=old['request_id']:
+        raise ValueError('CPU recovery task identity differs')
+    q=next(q for q in _records(read(reg['requests_path'])) if q['request_id']==old['request_id'])
+    before=journal_rows(dest/'calls.jsonl');_audit_calls(before,old['arm'],50)
+    r=run_request(None,q,old['arm'],old['lambda_value'],dest,sha(registration),job_id=old['job_id'],allow_resume=True)
+    after=journal_rows(dest/'calls.jsonl');_audit_calls(after,old['arm'],50)
+    if [x for x in before if x['event'] in ('CALL_BEGIN','CALL_END','STEP_COMMIT')] != [x for x in after if x['event'] in ('CALL_BEGIN','CALL_END','STEP_COMMIT')]:
+        raise RuntimeError('CPU export recovery changed scientific call/commit ledger')
+    import torch
+    if torch.cuda.is_initialized():raise RuntimeError('CPU export recovery initialized CUDA')
+    verify_receipt(dest,registration_sha256=sha(registration),job_id=old['job_id'])
+    return dict(status=r['status'],job_id=old['job_id'],new_model_loads=0,new_generator_forwards=0,new_input_VJPs=0,
+                CUDA_initialized=False,scientific_calls_and_commits_unchanged=True,receipt_sha256=sha(dest/'receipt.json'))
+
