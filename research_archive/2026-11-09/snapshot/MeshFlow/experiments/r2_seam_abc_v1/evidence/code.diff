+        if p.read_text(encoding='utf-8-sig')!=text.replace('\r\n','\n'):raise ValueError('Frozen CSV differs '+str(p))
+        return p
+    p.write_text(text,encoding='utf-8-sig',newline='');return p
+def resources(path=None):
