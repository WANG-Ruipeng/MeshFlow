+                             denominator='3 * batch eligible tips; within each tip average all same-source bulk corners') if arm=='A_COUPLE' else None)
+    if arm=='A_COUPLE':
+        raw=S.read(OLD/'data_manifest.json');parents={r['parent_id']:r for r in original['records']}
+        steps=[]
