+    initial = np.zeros((n, 3, 3), np.float32); initial[k:] = z
+    fixed = layout['anchor_ids'] >= 0
+    initial[fixed] = layout['C_vertices'][layout['anchor_ids'][fixed]]
+    alias = layout.get('alias_corner_ids')
