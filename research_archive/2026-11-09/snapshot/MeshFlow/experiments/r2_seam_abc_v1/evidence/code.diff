+    C.write(dest/'receipt.json', value)
+
+def prepare():
+    root=C.OUT
+    old=C.read(OLD/'eval_manifest.json')
+    extra=C.read(root/'B_EVAL_DEV_ASSETS.json')
+    conditions=old['conditions']+extra['conditions']
