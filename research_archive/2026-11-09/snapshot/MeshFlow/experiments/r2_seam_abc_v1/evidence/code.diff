+def dispatch_guard(snapshot, estimate_mib):
+    if snapshot['gpu']['returncode'] != 0: raise RuntimeError('nvidia-smi unavailable; no dispatch')
+    row = snapshot['gpu']['stdout'].splitlines()[0].split(',')
