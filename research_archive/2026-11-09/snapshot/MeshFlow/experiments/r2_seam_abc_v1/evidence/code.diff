+def read(path):return json.loads(path.read_text(encoding='utf-8-sig'))
+def rows(path):return [json.loads(x) for x in path.read_text(encoding='utf-8-sig').splitlines() if x] if path.exists() else []
+def sha(path):
+    h=hashlib.sha256()
