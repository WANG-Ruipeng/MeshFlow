+    stage = armroot / ('postprocess_attempt_' + str(time.time_ns())); stage.mkdir()
+    G.write(stage / 'all_RAW_barrier.json', dict(status='PASS', RAW=len(barrier), files={str(p):G.sha(p) for p in barrier}))
+    checkpoint = reg['d0_checkpoint']
