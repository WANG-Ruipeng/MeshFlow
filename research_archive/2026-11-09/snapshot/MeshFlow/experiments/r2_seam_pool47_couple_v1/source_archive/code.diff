+    ('FF_illegal_affected_free_fraction','FF affected free faces (%)','Lower'),
+    ('ConflictCov_C','I: conflict coverage of C (%)','Lower'),
+)
+COLORS={'PLAIN3000':'#0072B2','COUPLE3000':'#D55E00'}
