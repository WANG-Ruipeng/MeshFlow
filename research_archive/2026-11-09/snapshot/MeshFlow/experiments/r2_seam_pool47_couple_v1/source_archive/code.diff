+            p = str(resolve(path))
+            require(re.fullmatch(r"[0-9a-f]{64}", sha) is not None, "Invalid hash " + p)
+            require(p not in self.expected or self.expected[p] == sha, "Conflicting evidence hashes " + p)
+            self.expected[p] = sha
+            self.scopes.setdefault(p, set()).add(scope)
