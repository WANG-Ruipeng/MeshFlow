+    tick=time.perf_counter();first=score_one(jobs[0]);snap=C.resources()
+    mem={x.split(':')[0]:int(x.split()[1])*1024 for x in (snap.get('memory') or '').splitlines() if len(x.split())>1 and x.split()[1].isdigit()}
