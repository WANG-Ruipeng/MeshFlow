+        raise Stop('DATA_SCALE_BLOCKED', 'Training manifest is not a frozen scaling manifest')
+    pools = train.get('pools', {}); large = [x for x in pools if x.startswith('USER_LARGE_')]
+    if len(large) != 1 or set(pools) != {'USER_SMALL', large[0]}:
