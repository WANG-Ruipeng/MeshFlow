+ROOT = Path(__file__).resolve().parents[3]
+OUT = ROOT / 'experiments/r2_bench_backend_relative_deformation_v1'
+BASELINE = ROOT / 'experiments/r2_bench_backend_shape_preservation_v1'
+VERSION = 'bench_backend_relative_deformation_runtime_v1'
+SCALE = 0.95 * 0.3762
+UPDATES = 500
+BATCH = 4
+SEED = 2026102301
+OFFICIAL_SHA = '67765c728c503b61c21624c05997ea026c9de486d1529052fafa134be3336b14'
+from . import relative_loss as RL
