+def permute(a,p):
+    a=np.asarray(a);p=np.asarray(p,dtype=np.int64)
+    assert a.shape[:2]==p.shape and p.shape[1]==3
+    idx=p.reshape(p.shape+(1,)*(a.ndim-2))
