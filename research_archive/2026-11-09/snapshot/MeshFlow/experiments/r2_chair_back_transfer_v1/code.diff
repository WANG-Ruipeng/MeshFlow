+def run(stage,shard=0,shards=1):
+    rows=selected(shard,shards)
+    reg=G.read(OUT/'registration.json')
+    if reg['status']!='FROZEN' or G.sha(OUT/'eval_manifest.json')!=reg['eval_manifest_sha256']:
