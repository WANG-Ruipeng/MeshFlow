+    book = collections.defaultdict(list)
+    for i, face in enumerate(faces):
+        for j in range(3):
+            book[tuple(sorted((int(face[j]), int(face[(j + 1) % 3]))))].append(i)
+    graph = [set() for _ in faces]
+    for owners in book.values():
+        for i in owners:
