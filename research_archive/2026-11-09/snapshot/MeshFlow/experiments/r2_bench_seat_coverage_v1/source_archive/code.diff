+                              bounds=q["gallery_bounds"],
+                              depth_bounds=q["gallery_depth_bounds"] ))
+    protected = [OUT / "eval_manifest.json", OUT / "registration.json",
+                 Path(__file__), Path(G.__file__), Path(D.__file__), Path(H.__file__)]
+    value = dict(status="FROZEN", pages=pages, requests=len(requests()), sheets=len(pages),
