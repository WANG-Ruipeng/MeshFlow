+        g = dict(C=tri[:K], F=tri[K:], C_original=original, tri=tri)
+        facts = dict(label=cell_info["label"], role_counts={r: int((role == r).sum()) for r in ("C", "SEAM", "BULK", "BRIDGE")}, views=[])
+        for row, az in enumerate((-60, 120)):
