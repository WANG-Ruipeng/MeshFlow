+            and side['global_step'] == 21000 and side['curriculum_step'] == 3000,
+            'Final artifact cursor/schema differs')
+    require(path.stat().st_size == side['bytes'] and sha(path) == side['sha256'],
+            'Final artifact bytes/hash changed')
+    return side
+
