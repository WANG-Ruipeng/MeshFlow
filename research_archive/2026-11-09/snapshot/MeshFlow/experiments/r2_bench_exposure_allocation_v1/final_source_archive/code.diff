+    r=read(folder/'receipt.json')
+    if (r['status']!='COMPLETE' or r['label']!=storage_label(label) or r['request_id']!=q['request_id']
+        or r['D0_forwards']!=1 or r['GEO_calls']!=1 or r['post_sha256']!=sha(folder/'post.npz')):
