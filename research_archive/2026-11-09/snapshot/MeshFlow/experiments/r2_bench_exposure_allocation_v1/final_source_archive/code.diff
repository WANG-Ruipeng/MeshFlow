+        D0_checkpoint_sha256=legacy.OLD.D0_SHA,RAW_barrier={str(p):sha(p) for p in barrier},
+        contract='single official Bench D0 + original GEO_C/source winding; no SHAPE or GEO_ONLY'))
+    def checked(root,labels,subset):
