+def topology(tri,faces,K,edges,role):
+    """The same 11 graph fields on actual faces, with true BULK role only."""
+    tri=np.asarray(tri,float);n=len(tri);area=.5*np.linalg.norm(np.cross(tri[:,1]-tri[:,0],tri[:,2]-tri[:,0]),axis=1)
