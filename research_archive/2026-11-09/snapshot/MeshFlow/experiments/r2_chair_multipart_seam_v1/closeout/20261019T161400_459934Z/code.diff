+    if tuple(value['arms']) != C.ARMS or len(value['conditions']) != 7 or len(value['requests']) != 28:
+        raise ValueError('Expected exactly seven C, twenty-eight requests and four registered arms')
+    if len({q['request_id'] for q in value['requests']}) != 28:
+        raise ValueError('Duplicate request')
+    for condition in value['conditions']:
+        rows = [q for q in value['requests'] if q['condition_id'] == condition['condition_id']]
+        if len(rows) != 4 or {q['noise_index'] for q in rows} != set(range(4)):
+            raise ValueError('Unpaired noise panel')
