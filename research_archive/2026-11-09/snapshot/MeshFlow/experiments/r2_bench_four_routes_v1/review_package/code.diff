+    if set(a) != {"C_vertices", "C_faces_original", "C_faces_model", "N", "K"}:
+        raise ValueError("Inference bundle contains non-C information")
+    core = {k: a[k] for k in ("C_vertices", "C_faces_original", "C_faces_model")}
