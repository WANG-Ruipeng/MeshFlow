+    identity = dict(version=VERSION, label=label, request_id=q["request_id"],
+                    registration_sha256=registration_sha, seam_model=seam_model,
+                    sources={str(p): C.sha(p) for p in paths.values()})
+    done = dest/"complete.json"
+    if done.exists():
+        receipt = C.read(done)
