+        value = value.replace("/mnt/e/MeshFlow", "E:/MeshFlow")
+    else:
+        value = value.replace("E:\\MeshFlow", "/mnt/e/MeshFlow").replace("E:/MeshFlow", "/mnt/e/MeshFlow")
+    result = Path(value)
+    return result if result.is_absolute() else ROOT / result
