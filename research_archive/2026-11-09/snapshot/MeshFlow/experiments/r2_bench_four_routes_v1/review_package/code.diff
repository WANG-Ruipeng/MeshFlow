+                  coplanar_overlap_area=0.0, contact_dimension=None,
+                  detector='independent_edge_triangle_barycentric', normalized_by_bbox=True,
+                  epsilon=eps * length, reason='No bounded triangle intersection')
+
+    def unresolved(reason):
