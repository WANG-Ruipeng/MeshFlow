+    old_seeds={tuple(r[k] for k in ('noise_seed','epsilon_seed','time_seed','permutation_seed')) for r in old_rows}
+    require(not old_seeds.intersection(seedtuples),'Old stochastic instance reused')
+    artifacts={}
