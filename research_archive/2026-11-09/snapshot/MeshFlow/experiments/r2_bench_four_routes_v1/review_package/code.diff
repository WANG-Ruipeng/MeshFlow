+                arm=np.asarray('SEAM_SLOT_C200'),production_OT_calls=np.asarray(1))
+    assert np.array_equal(np.sort(ids),np.arange(n))
+    assert np.array_equal(full[vals['source_face_ids'][:,None],vals['source_corner_permutations']],vals['x1'])
