+def stage_spec(reg):
+    if (reg['updates'],reg['source_global_step'],reg['final_global_step']) != (1500,BASE_STEP,24000):
+        raise ValueError('Exactly1500 new SEAM updates from narrow B22500 to24000 required')
+    if reg['full_steps'] != [1500] or reg['checkpoint_every'] != 250:
+        raise ValueError('Retain endpoint and rolling250; source is referenced, not recreated')
+    return dict(updates=1500,full_steps=[1500],global_start=BASE_STEP)
+
+
+def cursor(reg,step):
+    stage_spec(reg)
+    if type(step) is not int or not 0 <= step <= 1500:
+        raise ValueError('New branch local cursor outside budget')
+    return dict(stage=STAGE,stage_step=step,local_step=step,curriculum_step=4500+step,
+                global_step=BASE_STEP+step,native_total_step=10500,seam_total_step=step)
+
+
+def limits(reg):
+    stage_spec(reg)
