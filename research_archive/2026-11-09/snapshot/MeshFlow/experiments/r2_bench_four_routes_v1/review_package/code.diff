+    target=folder/'root.json'
+    C.immutable(target,dict(reviewer='root',reviewer_kind='AI_PROXY',blind=False,
+        assigned_page_ids=pages,pages=observations,explicit_notes={str(p):C.sha(p) for p in sources}))
