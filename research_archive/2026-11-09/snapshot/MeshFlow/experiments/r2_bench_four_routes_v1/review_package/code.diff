+            reconstructed[name] = dict(status='BYTE_IDENTICAL', rows=len(rows),
+                                       fields=len(metadata['original_columns']), bytes=len(value),
+                                       original_relative_path=metadata['original_relative_path'],
+                                       reconstructed_sha256=digest)
