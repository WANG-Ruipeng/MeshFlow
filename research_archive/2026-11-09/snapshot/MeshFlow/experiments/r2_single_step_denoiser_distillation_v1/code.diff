+    internal_sources = []
+    for uid in sorted(by_parent):
+        rows = sorted(by_parent[uid], key=lambda r: r['condition_id'])
+        internal_sources.append(rows[C.seed('internal_condition', uid) % len(rows)])
+    train, generations = [], []
+    for r in sources:
+        a = source_arrays[r['condition_id']]
+        for variant in range(2):
