+                residual_d=residual_saved,proposal_model=proposal_model,proposal=proposal_model,
+                proposal_S_d=proposal_saved,r_S_d=residual_saved,proposal_S_model=proposal_model,
+                output=output,C=c.copy(),known=known.copy(),
