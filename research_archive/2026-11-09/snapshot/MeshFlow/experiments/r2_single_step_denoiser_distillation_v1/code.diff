+        **{k:ec[k] for k in ('RETAINED','D0_VALID_EDGE_LOST','NEW_VALID_EDGE')},
+        corner_target_or_status_changes=len(corners),radius_membership_crossings=len(crossings),
+        radius_C_F_crossings=sum(x['domain']=='C_F' for x in crossings))
