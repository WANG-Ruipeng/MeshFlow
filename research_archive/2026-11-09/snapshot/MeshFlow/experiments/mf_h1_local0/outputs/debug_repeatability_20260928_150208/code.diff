+ evidence=json.loads((out/'stage_a_continue.json').read_text())
+ arrays=np.load(out/'stage_a_continue_arrays.npz');case=load_case()
+ group=case['prompts']['point_primitive'];index=group.unsqueeze(-1).expand(-1,-1,128)
