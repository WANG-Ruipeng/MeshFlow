+        CF_proper_affected_free_fraction=cf.get("proper_affected_face_fraction"),
+        CF_proper_pair_count=cf.get("proper_pair_count"),
+        CF_coplanar_pair_count=cf.get("coplanar_positive_area_pairs"),
