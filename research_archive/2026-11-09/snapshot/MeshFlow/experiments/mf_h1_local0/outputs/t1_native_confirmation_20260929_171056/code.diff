+    return (f"净和{_fmt(value.get('net_sum'))}、均值{_fmt(value.get('mean'))}；{ratio}；"
+            f"移除最大正贡献后净和{_fmt(removed)}，是否失去净正信号={_fmt(value.get('net_becomes_nonpositive_without_largest_positive'))}")
+
+
