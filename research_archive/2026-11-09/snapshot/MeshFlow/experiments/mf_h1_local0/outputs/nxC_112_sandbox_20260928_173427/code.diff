+def verify_raw_and_checkpoints(report):
+    from .prompt_dataset import file_sha256
+    from .train_adapter import state_sha256_from_state
+    import torch
+    checks=[]
+    for record in report.get('stage_a',{}).get('raw_outputs',[]):
