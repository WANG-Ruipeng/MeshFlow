+REPO = Path(__file__).resolve().parents[2]
+MODELS = ("Geo_initial", "Geo_continue", "Geo_M10")
+PAIRINGS = (("Geo_M10", "Geo_continue"), ("Geo_continue", "Geo_initial"))
+SEEDS = tuple(range(9801, 9809))
