+def _seed_map(seeds):
+    seeds=tuple(map(int,seeds))
+    if len(seeds)!=8 or len(set(seeds))!=8: raise ValueError("Require eight distinct original-patch seeds")
+    return {0:seeds,1:seeds[:2],2:seeds[:2]}
