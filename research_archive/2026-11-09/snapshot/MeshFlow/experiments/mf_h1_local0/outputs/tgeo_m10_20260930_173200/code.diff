+    from .guided_native_geometry_audit import extract_boundary_segments, _sample_boundary
+    path=_path(path)
+    if expected_sha != EXPECTED_BANK_SHA or _sha(path)!=expected_sha:
+        raise ValueError("Frozen evaluation archive SHA differs")
+    with np.load(path,allow_pickle=False) as saved:
+        registration=json.loads(str(saved["registration_json"].item()))
+        arrays={key:saved[key].copy() for key in saved.files if key!="registration_json"}
+    if registration.get("status")!="PASS" or set(arrays)!=set(registration["arrays"]):
+        raise ValueError("Incomplete frozen registration")
+    for key,value in arrays.items():
+        record=registration["arrays"][key]
+        if _array_hash(value)!=record["sha256"] or list(value.shape)!=record["shape"] or str(value.dtype)!=record["dtype"]:
+            raise ValueError("Frozen array mismatch: "+key)
+        value.setflags(write=False)
+    banks={}
+    for patch in (0,1,2):
+        cases={}; refs=[]
+        for parent in (0,1):
+            prefix=f"parent{parent}_patch{patch}_"; pp=f"parent{parent}_"
+            row=next(r for r in registration["cases"] if r["parent_index"]==parent and r["patch_index"]==patch)
+            target=arrays[pp+"target"]; C=arrays[prefix+"constraints"]
+            ids=arrays[prefix+"source_face_ids"]; free_ids=arrays[prefix+"free_source_ids"]
+            faces=arrays[pp+"source_face_vertex_ids"]; vertices=arrays[pp+"source_vertices"]
+            if target.dtype!=np.float32 or target.shape!=(112,9) or C.dtype!=np.float32 or C.shape!=(12,3,3):
+                raise ValueError("Frozen N112/K12 FP32 shape differs")
+            if len(set(ids.tolist()))!=12 or free_ids.tolist()!=[i for i in range(112) if i not in ids]:
+                raise ValueError("Frozen known/free source decomposition differs")
+            if vertices[faces].tobytes()!=target.tobytes() or target[ids].tobytes()!=C.tobytes() or target[free_ids].tobytes()!=arrays[prefix+"free_target"].tobytes():
+                raise ValueError("Trusted source geometry / frozen case differs")
+            cases[parent,12]=dict(parent_index=parent,parent_uid=PARENT_UIDS[parent],patch_index=patch,K=12,N=112,
+                constraints=C,full_target=target,free_target=arrays[prefix+"free_target"],source_face_ids=ids,
+                free_source_ids=free_ids,pre_ot_free=arrays[prefix+"pre_ot_free"],bbox_diagonal=float(row["bbox_diagonal"]))
+            free=arrays[prefix+"free_target"].reshape(100,3,3).astype(np.float64)
+            rng=np.random.RandomState(9911)
+            sample_mesh_surface(free,512,rng)
+            target_points=sample_mesh_surface(free,512,rng)
+            if target_points.tobytes()!=arrays[prefix+"pairwise_target_points"].tobytes():
+                raise ValueError("Original pairwise 512 reference differs")
+            segments,_=extract_boundary_segments(C)
+            points,segment_ids,weights,_=_sample_boundary(segments,9919,512)
+            for suffix,value in (("boundary_segments",segments),("boundary_points",points),("boundary_point_segment_ids",segment_ids),("boundary_weights",weights)):
+                if value.dtype!=arrays[prefix+suffix].dtype or value.shape!=arrays[prefix+suffix].shape or value.tobytes()!=arrays[prefix+suffix].tobytes():
+                    raise ValueError("Original boundary reference differs: "+prefix+suffix)
+            refs.append(dict(parent=parent,patch=patch,status="PASS",pairwise_target_point_sha256=array_sha(target_points),
+                boundary_point_count=len(points),coverage_points=512,case_registration=row))
+        common=prepare_common_reference([cases[p,12]["free_target"] for p in (0,1)],
