+        json.dumps(value, allow_nan=False)
+    with tempfile.TemporaryDirectory(prefix="softmatch_metrics_") as directory:
+        path = Path(directory) / "fixture.png"
+        figure = plot_fixed(
+            {k: {name: generated for name in ("Base", "lambda5", "lambda20")} for k in (1, 2)},
