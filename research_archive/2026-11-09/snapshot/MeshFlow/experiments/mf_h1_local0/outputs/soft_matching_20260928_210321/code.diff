+    rows.sort(key=lambda row: (row["parent"], row["K"], row["lambda_max"], row["seed"]))
+    base_lookup = {(row["parent"], row["K"], row["seed"]): row for row in rows if row["lambda_max"] == 0}
+    scalar_fields = (
