+    return dict(status='PASS_FULL500_UPDATE_TIME_LOG',source_arm='A',updates=500,samples=4000,
+        all_samples=summarize(rows),by_parent={str(p):summarize([x for x in rows if x['parent']==p]) for p in (0,1)},
