+    phi,_=context_phi(ids[known]);p2,_=context_phi(ids2[known[order]])
+    complete_phi=np.zeros((4,3,2),dtype=np.float32);complete_phi[known]=phi
+    assert _same(permute(complete_phi)[known[order]],p2)
