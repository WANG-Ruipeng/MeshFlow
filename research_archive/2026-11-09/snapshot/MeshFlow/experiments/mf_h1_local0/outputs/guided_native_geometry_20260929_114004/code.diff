+        return result
+
+    # 1: Whole-triangle penetration with every vertex outside the activation band.
+    detector1 = expect_pair(c[0], f1[0], 'proper_transverse_penetration')
+    potential1 = original_vertex_repel(f1, c, epsilon, ledger)
