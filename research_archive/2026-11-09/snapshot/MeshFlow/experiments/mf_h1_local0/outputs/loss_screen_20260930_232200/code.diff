+            reference_cos2.append(torch.dot(normals[i], normals[j]).square())
+            if (i < nfree) == (j < nfree):
+                continue
+            fi, ki = (i, j) if i < nfree else (j, i)
+            corners = [int(np.flatnonzero(all_ids[fi] == vid)[0]) for vid in edge]
+            off = next(k for k in range(3) if k not in corners)
