+
+
+def add(acc, row):
+    acc['records'] += 1
+    for key in FIELDS:
+        value = row[key]
+        require(math.isfinite(float(value)) and value >= 0, 'Invalid saved SSE/count: ' + key)
+        acc[key] += value
+
+
+def metrics(acc):
+    out = {k: acc.get(k, 0) for k in FIELDS}
+    out['records'] = acc.get('records', 0)
+    for role in ROLES:
+        count = out[role + '_scalar_count']
