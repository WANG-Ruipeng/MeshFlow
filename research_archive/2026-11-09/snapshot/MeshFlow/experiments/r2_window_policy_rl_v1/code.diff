+                registration_sha256=D.sha(OUT/'registration.json'),manifest_path=str(OUT/'inputs/manifest.json'),
+                ledger_dir=str(ledger),cpu_threads=1,adapter_init_seed=2026101501)
+            if stage['label']=='RL_STOCH':
