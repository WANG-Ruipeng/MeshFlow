+            raise ValueError('AdamW clock/schema mismatch')
+        for name in ('exp_avg', 'exp_avg_sq'):
+            value = state[name]
+            if value.dtype != torch.float32 or value.shape != p.shape or not bool(torch.isfinite(value).all()):
+                raise ValueError('Invalid AdamW moment')
+
