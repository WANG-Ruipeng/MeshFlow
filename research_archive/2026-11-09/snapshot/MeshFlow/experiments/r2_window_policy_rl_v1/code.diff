+    line=s['gpu']['stdout'].splitlines()[0]
+    fields=[v.strip() for v in line.split(',')]
+    s['_memory_total_mib'],s['_memory_used_mib'],s['_memory_free_mib'],s['_util']=map(float,fields[-4:])
