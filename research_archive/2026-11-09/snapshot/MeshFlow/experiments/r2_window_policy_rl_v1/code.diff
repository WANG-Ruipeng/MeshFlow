+def current_hash(model):
+    return state_hash({n: v for n, v in model.adapter_state_dict().items()
+                       if n.endswith(('.current_a', '.current_b'))})
+
+
+def old_hash(model):
+    return state_hash({n: v for n, v in model.adapter_state_dict().items()
+                       if n.endswith(('.old_a', '.old_b'))})
