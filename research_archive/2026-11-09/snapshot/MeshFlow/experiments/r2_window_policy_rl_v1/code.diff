+def rloo(rewards):
+    r = np.asarray(rewards, dtype=np.float64)
+    if r.shape != (GROUP,) or not np.isfinite(r).all() or not np.isin(r, [0., 1.]).all():
+        raise ValueError('Exactly eight complete binary rewards required')
+    return r - (r.sum() - r) / (GROUP - 1)
+
