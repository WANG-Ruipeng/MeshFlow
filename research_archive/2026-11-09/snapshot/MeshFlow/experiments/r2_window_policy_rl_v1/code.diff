+        if gate['status']!='PASS':raise ValueError('Formal evaluation requires a passed calibration')
+        labels={'FULL_DET':0.,'FULL_STOCH':gate['selected_sigma'],'RL_STOCH':gate['selected_sigma']}
+        requests=m['evaluation_requests']
