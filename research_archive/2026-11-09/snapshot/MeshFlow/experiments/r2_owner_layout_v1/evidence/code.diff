+    train=[];protected={str(OLD/'B_DATA_REGISTRATION.json'):sha(OLD/'B_DATA_REGISTRATION.json')}
+    for r in records:
+        d=arrays(r['inference_npz']);y=arrays(r['labels_npz']);edges,x=features(d)
+        assert np.array_equal(x[:,:24],y['edge_features'])
