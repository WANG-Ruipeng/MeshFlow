+    if delta==0:return 'EQUAL'
+    better=delta>0 if order.startswith('HIGHER') else delta<0
+    return 'FAVORABLE_NUMERIC' if better else 'UNFAVORABLE_NUMERIC'
+
+
+def slices(row):
+    region=str(row['region_type']).upper();tier=str(row['tier']).upper()
