+ROOT = Path('/mnt/e/MeshFlow')
+OLD = ROOT / 'experiments/r2_user_data_scaling_12h_v1'
+OUT = ROOT / 'experiments/r2_user_data_scaling_32_67_v1'
+TASK = 'R2_USER_DATA_SCALING_32_67_V1'
+BIG = 'USER_EXPANDED_67'
