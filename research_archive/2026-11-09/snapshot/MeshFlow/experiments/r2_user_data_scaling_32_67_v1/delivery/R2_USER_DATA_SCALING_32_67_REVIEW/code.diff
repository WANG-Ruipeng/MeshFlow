+"""Compose the final report from closed tables; no models or geometry scoring."""
+from pathlib import Path
+import csv
+import json
+from datetime import datetime, timezone
+
+CODE = Path(__file__).resolve().parent
+ROOT = CODE.parents[2]
+OUT = ROOT / 'experiments/r2_user_data_scaling_32_67_v1'
+
+def rows(path):
+    with (OUT / path).open(encoding='utf-8-sig', newline='') as f:
+        return list(csv.DictReader(f))
+
+def table(header, rr):
+    return '\n'.join(['| ' + ' | '.join(header) + ' |', '| ' + ' | '.join(['---'] * len(header)) + ' |'] +
+                     ['| ' + ' | '.join(map(str, r)) + ' |' for r in rr])
+
+def main():
+    review = json.loads((OUT / 'evaluation/gallery/output_review_receipt.json').read_text('utf-8-sig'))
+    agg = json.loads((OUT / 'evaluation/aggregate_completion.json').read_text('utf-8-sig'))
+    assert review['status'] == 'COMPLETE' and agg['status'] == 'COMPLETE' and agg['stage_records'] == 840
+    absolute = rows('report_tables/absolute_parent_equal.csv')
+    paired = rows('report_tables/expanded_minus_small_summary.csv')
+    visual = rows('review_tables/classification_counts.csv')
+    labels = ['USER_SMALL', 'USER_EXPANDED_67', 'HIST_USER_MIX_FROZEN']
+
+    def val(metric, label, panel='NEW32', stage='POST'):
+        rr = [r for r in absolute if r['panel'] == panel and r['stage'] == stage and r['stratum'] == 'ALL' and r['label'] == label and r['metric'] == metric]
+        assert len(rr) == 1
+        return float(rr[0]['parent_equal_mean'])
+
+    def abs_table(metrics, panel='NEW32', stage='POST'):
+        data = []
+        for title, metric, scale in metrics:
+            vv = [val(metric, lab, panel, stage)*scale for lab in labels]
+            data.append([title, *[f'{v:.3f}' for v in vv], f'{vv[1]-vv[0]:+.3f}'])
+        return table(['指标', 'SMALL32', 'EXPANDED67', '历史 USER_MIX', 'E−S'], data)
+
+    quality = [
+        ('CF受影响free面 % ↓', 'CF_illegal_affected_free_fraction', 100),
+        ('FF受影响free面 % ↓', 'FF_illegal_affected_free_fraction', 100),
+        ('I：C冲突覆盖 % ↓', 'ConflictCov_C', 100),
+        ('I_cross % ↓', 'ConflictCov_C_cross', 100),
+        ('I_dup候选 % ↓', 'ConflictCov_C_dup', 100),
+        ('free小角<5° % ↓', 'free_minimum_angle_lt5_fraction', 100),
+        ('free q>10 % ↓', 'free_q_gt10_fraction', 100),
+        ('free精确零面积 % ↓', 'free_exact_zero_area_fraction', 100),
+        ('free近退化 % ↓', 'free_near_degenerate_fraction', 100),
+        ('每输出删free面（描述性）', 'deleted_free_faces', 1),
+        ('每输出非流形边 ↓', 'nonmanifold_edges', 1),
+        ('精确索引面连通分量（描述性）', 'EXACT_COORD_face_components', 1),
+        ('C边界到F顶点P95距离（模型单位）↓', 'boundary_distance_p95_model', 1),
+    ]
+    pair_metrics = [quality[0],quality[1],quality[2],quality[5],
+                    ('严格A-VMR % ↑','A_VMR__raw_tau_1e-6',100),
+                    ('A-VMR@1%L % ↑','A_VMR__L_tau_0.01',100),
+                    ('A-VMR@2%L % ↑','A_VMR__L_tau_0.02',100),
+                    ('方向可达free面积 % ↑','opposite_winding_reached_free_area_fraction',100)]
+    pair_rows=[]
+    for title,metric,scale in pair_metrics:
+        rr=[r for r in paired if r['panel']=='NEW32' and r['stage']=='POST' and r['stratum']=='ALL' and r['metric']==metric]
+        assert len(rr)==1
+        r=rr[0]
+        pair_rows.append([title, f"{float(r['mean_delta'])*scale:+.3f}", f"{float(r['median_parent_delta'])*scale:+.3f}",
+                          '/'.join(r[k] for k in ('favorable_numeric_parents','equal_delta_parents','unfavorable_numeric_parents'))])
+
+    avmr_rows=[]
+    for key in ['raw_tau_1e-6','L_tau_1e-06','L_tau_0.0001','L_tau_0.001','L_tau_0.002','L_tau_0.005','L_tau_0.01','L_tau_0.02']:
+        avmr_rows.append([key, *[f"{100*val('A_VMR__'+key,l):.3f} / {100*val('PMR__'+key,l):.3f}" for l in labels]])
+
+    visual_rows=[]
+    for field,title in [('C_adoption','C采用'),('C_floating','C悬空'),('C_replaced_by_other_surface','C被其他面替代'),
+                        ('C_wrong_layer','C错层'),('whole_body_complete','整体完整'),('support_missing','支撑缺失'),
+                        ('fragments_or_folded_layers','碎片或折叠层'),('visible_join','可见接合')]:
+        counts=[]
