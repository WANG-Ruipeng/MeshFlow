+    writer.writeheader()
+    for row in rows:
+        writer.writerow({k: json.dumps(v, ensure_ascii=False, sort_keys=True) if isinstance(v, (dict, list)) else v for k, v in row.items()})
+    return _write_bytes(path, stream.getvalue().encode('utf-8-sig'), replace=replace)
+
