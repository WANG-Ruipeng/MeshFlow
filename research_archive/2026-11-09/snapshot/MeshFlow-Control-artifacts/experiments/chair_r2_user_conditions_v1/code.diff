+def triangle_areas(triangles):
+    points = np.asarray(triangles, dtype=np.float64).reshape(-1, 3, 3)
+    return np.linalg.norm(np.cross(points[:, 1] - points[:, 0], points[:, 2] - points[:, 0]), axis=1) * .5
