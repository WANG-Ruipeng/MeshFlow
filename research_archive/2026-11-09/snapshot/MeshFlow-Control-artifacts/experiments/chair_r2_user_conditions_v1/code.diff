+ write(out/'regions.json',value)
+ event(out,'REGIONS_FROZEN_FOR_REVIEW',train_regions=sum(r['split']=='train' for r in accepted),dev_regions=sum(r['split']=='dev' for r in accepted),review_kind='AI_PROXY')
