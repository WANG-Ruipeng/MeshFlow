+    assert rows[0]["requested_tiers"]==["small","medium"]
+    assert rows[0]["region_area_fraction"]==.5 and rows[1]["region_area_fraction"]==1.
+    assert set(rows[0]["source_face_ids"])<set(rows[1]["source_face_ids"])
+
