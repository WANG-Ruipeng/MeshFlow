+        d.update(S_scope="REFERENCE_INTERFACE" if r["panel"]=="P1" else "NA_NO_REQUIRED_INTERFACE",E_scope="REFERENCE_EXPOSURE" if r["panel"]=="P1" else "NA_NO_REFERENCE_EXPOSURE")
