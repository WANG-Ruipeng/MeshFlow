+def freeze_dispatch_r1(out):
+    """Independent revision identity; never extend the original frozen manifest."""
+    out=Path(out)
+    folder=out/'audit/dispatch_r1'
+    registration=read(folder/'registration.json')
+    current=file_sha256(Path(__file__))
+    original=file_sha256(REPO/'tools/run_schedule40.py')
+    if registration['r1_sha256']!=current or registration['original_sha256']!=original:
+        raise ValueError('Independent dispatcher R1 identity changed')
+    baseline=read(out/'audit/source_hashes_before.json')
+    if baseline['tools/run_schedule40.py']!=original:
+        raise ValueError('Original dispatcher no longer matches training freeze')
+    snapshot_path=folder/'source/run_schedule40_dispatch_r1.py'
+    if file_sha256(snapshot_path)!=current:
+        raise ValueError('Independent dispatcher R1 source snapshot changed')
+    freeze(folder/'activated_source_identity.json',dict(revision='dispatch_r1',
+        registration_sha256=file_sha256(folder/'registration.json'),
+        r1_sha256=current,original_sha256=original,
+        original_manifest_sha256=file_sha256(out/'audit/source_hashes_before.json'),
+        scientific_protocol_changed=False,maximum_retries_unchanged=True))
+    event(out,'DISPATCH_REVISION_SELECTED',revision='dispatch_r1',r1_sha256=current,
+          registration_sha256=file_sha256(folder/'registration.json'))
